@using Interon.Roadlab.Web.Net.Core.Models.ViewModels
@using Interon.Roadlab.Web.Net.Core.Models.ContentModels
@inherits UmbracoViewPage<Interon.Roadlab.Web.Net.Core.Models.ContentModels.HomePage>
  
 
@{
	Layout = "MasterPage.cshtml";
	var homePage = new HomePage(Model,null);

	IEnumerable<IPublishedContent>? recentArticlesPicker = homePage.Value<IEnumerable<IPublishedContent>>("recentArticlesPicker");
	var blog =  Umbraco.ContentAtRoot().OfType<BlogHome>().FirstOrDefault();
	var method = homePage.Value<string>("method") ?? "";
	var recentArticles = (recentArticlesPicker ?? Array.Empty<IPublishedContent>()).OfType<BlogArticle>().ToList();
	if (method == "date")
	{	
		recentArticles = blog.Descendants<BlogArticle>().Where(x=>x.HomePageToggle).OrderByDescending(x => x.ArticleDate).Take(3).ToList();
	}
	else if (method == "random")
	{
		recentArticles = blog.Descendants<BlogArticle>().Where(x => x.HomePageToggle).OrderBy(x => Guid.NewGuid()).Take(3).ToList();
	}
}  

<main>
	<section>
		<img class="hidden-mobile" src="@Umbraco.Media(Model.Value<IPublishedContent>("desktopImage").Id).Url()" style="width:100%;" alt="Header Image">
		<img class="visible-mobile" src="@Umbraco.Media(Model.Value<IPublishedContent>("mobileImage").Id).Url()" style="width:100%;" alt="Header Image">
	</section>

	<section class="features">
		<div class="container features__cont">
			<div class="row">
				<div class="col-lg-3 col-md-6 col-sm-6 col-xs-12 features__box">
					<div class=" text-center features__img"><img src="./images/icon1.jpg" alt="Materials Testing"></div>
					<h3 class="features__heading"> 
						MATERIALS<br>
						TESTING
					</h3>
					<hr class="features__hr"> 
					<p>FOR CONSTRUCTION & CIVILS</p>
					<ul class="fa-ul features__text">
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Concrete</li>
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Aggregate</li>
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Soil & Gravel</li>
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Asphalt & Bitumen</li>
					</ul>
				</div>
				<div class="col-lg-3 col-md-6 col-sm-6 col-sm-6 features__box">
					<div class="text-center features__img"><img src="./images/icon2.jpg" alt="Laboratory Services"></div>
					<h3 class="features__heading">
						Specialised<br>
						services
					</h3>
					<hr class="features__hr">
					<p>YOUR ONE STOP PROVIDER</p>
					<ul class="fa-ul features__text">
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Forensic Scanning</li>
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Site Investigations</li>
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Container Site Labs</li>
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Geotechnical Analysis</li>
					</ul>
				</div>

				<div class="col-lg-3 col-md-6 col-sm-6 features__box">
					<div class="text-center features__img"><img src="./images/icon4.jpg" alt="Specialised Insights"></div>
					<h3 class="features__heading">Unparalleled<br>&nbsp;&nbsp;Insights</h3>
					<hr class="features__hr">
					<p>ANY MATERIAL ANY TIME</p>
					<ul class="fa-ul features__text">
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Latest Technology</li>
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>65 years experience</li>
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Specialist Technicians</li>
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>All Construction Materials</li>
					</ul>
				</div>
				<div class="col-lg-3 col-md-6 col-sm-6 features__box">
					<div class="text-center features__img"><img src="./images/icon3.jpg" alt="Turnkey Partners"></div>
					<h3 class="features__heading">
						Turnkey<br>
						Partners
					</h3>
					<hr class="features__hr">
					<p>EVERY STEP OF THE WAY</p>
					<ul class="fa-ul features__text">
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Industry Experts</li>
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Maintenence Consulting</li>
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Practical Recommendations</li>
						<li><span class="fa-li li-icon"><i class="fas fa-angle-right"></i></span>Major and Minor Construction</li>
					</ul>
				</div>
			</div>
		</div>
	</section>

	<hr />
	<!-- BENEFITS BLOCKS -->
	<section class="benefits-blocks container">

		<!-- Start Feature 1 -->
		<div class="container">
			<div class="row benefits-blocks__container">
				<div class="col-md-6 col-sm-12 benefits-blocks__divider"><img class="benefits-blocks__img" src="./images/soil-1.jpg" alt="At your Site"></div>
				<div class="col-md-6 col-sm-12 benefits-blocks__right-box">
					<div class="col">

						<div class="row" style="display: inline-block;">
							<h3 class="benefits-blocks__heading">SOIL, GRAVEL & AGGREGATE</h3>
							<p class="benefits-blocks__sub-heading">LABORATORY & IN-FIELD TESTING</p>
						</div>
					</div>
					<div class="benefits-blocks__text">
						<p>
							Density, moisture, strength, durability, particle distribution - these characteristics impact every aspect of your project’s success. </p><p>We’ve spent 65 years perfecting the basics so you can evaluate, excavate, drill, pour, pave and build your legacy with confidence.
						</p>
					</div><a class="btn btn-orange mr-3" href="/services/materials-testing/soil-gravel/" role="button"><i class="fas fa-angle-right u-btn-fa"></i>SOIL & GRAVEL</a><a class="btn btn-orange" href="/services/materials-testing/aggregate/" role="button"><i class="fas fa-angle-right u-btn-fa"></i>AGGREGATES</a>
				</div>
			</div>
			<hr>
		</div><!-- End Feature 1 -->
		<!-- Start Feature 2 -->
		<div>
			<div class="row benefits-blocks__container">
				<div class="col-md-6 col-sm-12 benefits-blocks__divider"><img class="benefits-blocks__img" src="./images/concrete-1.jpg" alt="At your Site"></div>
				<div class="col-md-6 col-sm-12 benefits-blocks__right-box">
					<div class="col">

						<div class="row" style="display: inline-block;">
							<h3 class="benefits-blocks__heading">CONCRETE</h3>
							<p class="benefits-blocks__sub-heading">STRENGTH, DURABILITY & UNIFORMITY</p>
						</div>
					</div>
					<div class="benefits-blocks__text">
						<p>
							Get unparalled insight into your material or established concrete structures. </p>
						<p>
							With our dedicated concrete technologist we can offer the broadest range of concrete services in South Africa, from on-site sampling and laboratory strength testing to specialist GPR scanning, ultrasonic pulse velocity testing and other non-destructive methods.
						</p>
					</div><a class="btn btn-orange mr-3" href="/services/materials-testing/concrete/" role="button"><i class="fas fa-angle-right u-btn-fa"></i>SAMPLING & TESTING</a><a class="btn btn-orange" href="/services/specialised-concrete-forensic-investigations/non-destructive-concrete-testing/" role="button"><i class="fas fa-angle-right u-btn-fa"></i>NON DESTRUCTIVE TESTING</a>
				</div>
			</div>
			<hr>
		</div>
		<!-- End Feature 2
	<!-- Start Feature 3 -->
		<div>

				<div class="row benefits-blocks__container">
					<div class="col-md-6 col-sm-12 benefits-blocks__divider"><img class="benefits-blocks__img" src="./images/geotech-1.jpg" alt="At your Site"></div>
					<div class="col-md-6 col-sm-12 benefits-blocks__right-box">
						<div class="col">

							<div class="row" style="display: inline-block;">
								<h3 class="benefits-blocks__heading">GEOTECHNICAL AND ROAD INVESTIGATIONS</h3>
								<p class="benefits-blocks__sub-heading">ENERGY, CONSTRUCTION & ROADWORKS</p>
							</div>
						</div>
						<div class="benefits-blocks__text">
							<p>
								Incredible facilities, innovative energy projects and awe-inspiring roads start with our world-class geotechnical investigations. </p><p>Over decades of unique foundation, site and material investigations we have profiled and established the foundations of award-winning wind farms, solar parks, construction projects and national roads across the country.
							</p>
						</div><a class="btn btn-orange mr-3" href="/services/geotechnical-road-investigations/geotechnical-road-investigations/" role="button"><i class="fas fa-angle-right u-btn-fa"></i>GEOTECHNICAL AND ROAD INVESTIGATIONS</a>
					</div>
				</div>
				<hr>
			</div>

		<!-- End Feature 3 -->
		<!-- Start Feature 4 -->
			<div>
				<div class="row benefits-blocks__container">
					<div class="col-md-6 col-sm-12 benefits-blocks__divider"><img class="benefits-blocks__img" src="./images/asphalt-1.jpg" alt="At your Site"></div>
					<div class="col-md-6 col-sm-12 benefits-blocks__right-box">
						<div class="col">

							<div class="row" style="display: inline-block;">
								<h3 class="benefits-blocks__heading">ASPHALT & BITUMEN</h3>
								<p class="benefits-blocks__sub-heading">MIX CONTENT, QUALITY & RIDEABILITY</p>
							</div>
						</div>
						<div class="benefits-blocks__text">
							<p>
								You need a laboratory partner that can maintain excellent turnaround times, no matter the circumstances. </p>
							<p>
								Get meaningful insights at every level and stage of your work, from the particle size, stability, flow, density and void content of your samples to the roughness, rideability, deflection response and environmental resilience of your pavements layers.
							</p>
						</div><a class="btn btn-orange mr-3" href="/services/materials-testing/asphalt-bitumen/" role="button"><i class="fas fa-angle-right u-btn-fa"></i>ASPHALT & BITUMEN</a>
					</div>
				</div>
			</div>
	</section>
	<!-- REACH -->
	<section class="reach">
		<div class="reach__background">
			<div class="container">
				<div class="row">
					<div class="col-lg-4 col-md-6 col-sm-12">
						<h4 class="reach__heading">
							DON'T HASSLE. <span class="u-bold">REACH OUT TO</span><br>
							<span class="reach__heading-2">THE EXPERTS.</span>
						</h4>
						<div id="ContactFormPlaceHolder">
							@Html.Partial("~/Views/Partials/_RenderContactForm.cshtml", new ContactModel() { BranchName = "Home Page - Head Office" })
						</div>
					</div>
					<div class="col-lg-4 col-md-6 col-sm-12 cp-text reach__aligner">
						<div>
							<h4 class="reach__option">---- OR ----</h4>
							<h5 class="u-bold reach__cta">Visit your local branch</h5>
							<p class="cp-just">We love doing business in person and our friendly staff are always eager to hear about your project. Let's have a chat!</p><a class="btn btn-blue__small" href="/head-office/" role="button"></i>CONTACT US</a>
						</div>
					</div>
					<div class="col-lg-4 col-md-6 col-sm-12 reach__img-hide"><img class="reach__bottom " src="/media/zmffny3g/manb.png" alt="Roadlab Man"></div>
				</div>
			</div>
		</div>
	</section>
	<!--DISCOVER -->
	@if(recentArticles.Any())
	{
	<section class="discover">
		<div class="paral">
			<div class="container">
				<div class="row discover__container--headline ">
					<div class="col-12" >
					<h3 class="features__heading pb-5"> Recent Articles</h3>
					</div>
						<div class="row discover__container">

						 
							@foreach (var item in recentArticles )
							{
								<div class="px-5 col-lg-4 col-md-6 col-sm-12 about-text">
									<img class="about-team__sub-container--img mb-3" src="@item.ArticleIntersectImage.Url()" alt="@(item.ArticleIntersectImage.Value("fileDescription")??item.ArticleIntersectImage.Name)">
									<h6 class="about-team__sub-container--title">@item.PageTitle</h6>
									<h5 class="blog__sub-container--name">@item.BlogHeading</h5>
									<div class="blog__sub-container--content ft-cont">
										<p>
											 @item.ArticleIntersectDescription
											<a href="@item.Url()"> Read more</a>
										</p>
									</div>
								</div>
							}
						 

					</div>
				</div>
			</div>
		</div>
	</section>
	}
	<section class="cta">
		<div class="cta__background cta__container">
			<div class="container">
				<div class="row d-flex justify-content-center">
					<h4 class="cta__text"><span class="u-bold">TEAM UP WITH THE FRIENDLY EXPERTS. </span> REACH OUT TO US TODAY.</h4><a class="btn btn-white-l" href="/head-office/" role="button">GO</a>
				</div>
			</div>
		</div>
	</section>
</main>