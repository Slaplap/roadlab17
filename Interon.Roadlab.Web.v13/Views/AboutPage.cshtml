@inherits UmbracoViewPage<Interon.Roadlab.Web.Net.Core.Models.ContentModels.AboutPage>

@{
	Layout = "MasterPage.cshtml";
}

<section class="hero">
	<div class=" hero__shadow hero__pad">
		<div class="container">
			<div class="row">
				<div class="col-md-6 col-sm-12 hero__space">
					<div class="hero__container">
						<h4 class="hero__container--sub-heading">@Model.Value("heroSmallHeading")</h4>
						<h1 class="hero__container--main-heading ">@Model.Value("heroLargeHeading")</h1>
						<hr class="hero__hr2">
						<p class="hero__container--content-sub">@Model.Value("heroShortDescription")</p>
						<div class="hero__container--content">
							<p>@Model.Value("heroContent")</p>
						</div>

					</div>

				</div>
				<div class="col-md-5 col-sm-12">
					<iframe class=" video__about" src="https://www.youtube.com/embed/aNpBVWcpn50" title="Yabout video" frameborder="0" controls=0 allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
				</div>
			</div>
		</div>
	</div>
</section>
<!-- BENEFITS BLOCKS -->
<section class="benefits-blocks container">

	<!-- Start Feature 1 -->
	<div>
		<div class="row benefits-blocks__container">
			<div class="col-md-6 col-sm-12 benefits-blocks__divider">
				<iframe class="benefits-blocks__img" width="389" height="219" alt="The forefront of renewable energy"
						src="https://www.youtube.com/embed/_JG75oKcZ8A" title="YouTube video player" frameborder="0" controls=0 allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
			</div>
			<div class="col-md-6 col-sm-12 benefits-blocks__right-box">
				<div class="col">

					<div class="row" style="display: inline-block;">
						<h3 class="benefits-blocks__heading">TRACK RECORD</h3>
						<p class="benefits-blocks__sub-heading">OVER 50 YEARS EXPERIENCE</p>
					</div>
				</div>
				<div class="benefits-blocks__text">
					<p>
						Our experience is in everything that could impact the success of your project. We see the whole picture, and with us you will too.
					</p>
				</div><a class="btn btn-orange" href="/projects/" role="button"><i class="fas fa-angle-right u-btn-fa"></i>OUR PROJECTS</a>
			</div>
		</div>
		<hr>
	</div><!-- End Feature 1 -->
	<!-- Start Feature 2 -->
	<div>
		<div class="row benefits-blocks__container">
			<div class="col-md-6 col-sm-12 benefits-blocks__divider"><img class="benefits-blocks__img" width="389" height="219" src="/images/feature2.png" alt="Nationwide coverage"></div>
			<div class="col-md-6 col-sm-12 benefits-blocks__right-box">
				<div class="col benefits-blocks__left-box">
					<div class="row">
						<h3 class="benefits-blocks__heading">NATIONWIDE COVERAGE</h3>
						<p class="benefits-blocks__sub-heading">
							AT YOUR SITE, NO MATTER	WHERE
						</p>
					</div>
				</div>
				<div class="benefits-blocks__text">
					<p>With a fleet of over 100 vehicles and widespread coverage across Africa, Roadlab is your go-to partner for materials testing, regardless of the location.</p>
				</div>
				<a class="btn btn-orange" href="/head-office/#network" role="button"><i class="fas fa-angle-right u-btn-fa"></i>OUR NETWORK</a>
			</div>
		</div>
		<hr>
	</div>
	<!-- End Feature 2
	<!-- Start Feature 3 -->
	<div>
		<div class="row benefits-blocks__container">
			<div class="col-md-6 col-sm-12 benefits-blocks__divider">
				<iframe class="benefits-blocks__img" width="389" height="219" alt="Equipment Showcase"
						src="https://www.youtube.com/embed/F_uRx0uP6JI" title="YouTube video player" frameborder="0" controls=0 allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
			</div>
			<div class="col-md-6 col-sm-12 benefits-blocks__right-box">
				<div class="col benefits-blocks__left-box">
					<div class="row">
						<h3 class="benefits-blocks__heading">STATE OF THE ART</h3>
						<p class="benefits-blocks__sub-heading">
							TESTING EQUIPMENT, PERSONNEL & PROCEDURES
						</p>
					</div>
				</div>
				<div class="benefits-blocks__text">
					<p>
						Our machines, technicians and methods are highly accredited, allowing us to	deliver results you can trust on the widest range of materials.
					</p>
				</div>
				<a class="btn btn-orange" href="https://www.youtube.com/watch?v=F_uRx0uP6JI" role="button"><i class="fas fa-angle-right u-btn-fa"></i>TAKE A LOOK</a>
			</div>
		</div>
		<hr>
	</div>
	<!-- End Feature 3 -->
	<!-- Start Feature 4 -->
	<div>

		<div class="row benefits-blocks__container">
			<div class="col-md-6 col-sm-12 benefits-blocks__divider">
				<div class="benefits-block__left-text left-benefits-block">
					<div class="col">
						<div class="row" style="display:block;">
							<h3 class="benefits-blocks__heading">LEVEL 1 BBBEE</h3>
							<p class="benefits-blocks__sub-heading">Construction Scorecard</p>
						</div>
					</div>
					<div class="benefits-blocks__text">
						<p>
							We have been proud Level 1 BBBEE contributors since 2019.
						</p>
					</div><a class="btn btn-orange" href="/media/imhf3o0f/beecert.pdf" target="_blank" role="button"><i class="fas fa-angle-right u-btn-fa"></i>OUR CERTIFICATE</a>
				</div>

			</div>
			<div class="col-md-6 col-sm-12 benefits-blocks__right-box">
				<div class="col benefits-blocks__left-box">
					<div class="row">
						<h3 class="benefits-blocks__heading">FULLY ACCREDITED</h3>
						<p class="benefits-blocks__sub-heading">BY THE HIGHEST ENGINEERING STANDARDS</p>
					</div>
				</div>
				<div class="benefits-blocks__text">
					<p>
						We maintain international accreditations and standards of quality to provide our clients with the utmost security and peace of mind.
					</p>
				</div><a class="btn btn-orange" href="/our-world/roadlab-s-accredited-facilities/" target="_blank" role="button"><i class="fas fa-angle-right u-btn-fa"></i>OUR CERTIFICATES</a>
			</div>

		</div>
	</div>
</section>
<section class="about-team">
	<div class="about-team__background">
		<div class="products__heading paral paralsec">
			<div class="container">
				<div class="row products__heading-container">
					<div class="col-md-11 col-sm-12 products__heading--line products__heading--space">
						<p class="about-team__container--sub-heading">@Model.PageHeadingTop</p>
						<h2 class="about-team__container--main-heading">@Model.PageHeadingBottom</h2>
					</div>
				</div>
			</div>
		</div>
		<div class="container about-team__sub-container">

			<div class="row">

				@foreach (var item in Model.TeamMember)
				{
					<div class="col-lg-4 col-md-6 col-sm-12 about-text about-team__sub-container--box">
						<img class="about-team__sub-container--img" src="@(item.TeamMemberPhoto?.Url()??"/images/nh.jpg")" alt="@item.TeamImageAlt">
						<h5 class="about-team__sub-container--name">@item.TeamMemberName</h5>
						<h6 class="about-team__sub-container--title">@item.TeamMemberPosition</h6>
						<div class="about-team__sub-container--content ft-cont">
							<p>@item.TeamMemberDescription</p>
						</div>
					</div>
				}
			</div>

			<hr>
		</div>

	</div>
</section>
<section>

	<div class="photo-gallery">
		<div class="container">
			<!--<h5 class="about-team__sub-container--name">Our National Operations Team</h5>-->
			<div class="row photos">
				<div class="col-sm-6 col-md-4  item"><a href="/images/g1.jpg" data-lightbox="photos"><img class="img-fluid" src="/images/g1.jpg"></a></div>
				<div class="col-sm-6 col-md-4  item"><a href="/images/g2.jpg" data-lightbox="photos"><img class="img-fluid" src="/images/g2.jpg"></a></div>
				<div class="col-sm-6 col-md-4  item"><a href="/images/g3.jpg" data-lightbox="photos"><img class="img-fluid" src="/images/g3.jpg"></a></div>
				<div class="col-sm-6 col-md-4  item"><a href="/images/g4.jpg" data-lightbox="photos"><img class="img-fluid" src="/images/g4.jpg"></a></div>
				<div class="col-sm-6 col-md-4  item"><a href="/images/g5.jpg" data-lightbox="photos"><img class="img-fluid" src="/images/g5.jpg"></a></div>
				<div class="col-sm-6 col-md-4  item"><a href="/images/g6.jpg" data-lightbox="photos"><img class="img-fluid" src="/images/g6.jpg"></a></div>
				<div class="col-sm-6 col-md-4  item"><a href="/images/g7.jpg" data-lightbox="photos"><img class="img-fluid" src="/images/g7.jpg"></a></div>
				<div class="col-sm-6 col-md-4  item"><a href="/images/g8.jpg" data-lightbox="photos"><img class="img-fluid" src="/images/g8.jpg"></a></div>
				<div class="col-sm-6 col-md-4  item"><a href="/images/g9.jpg" data-lightbox="photos"><img class="img-fluid" src="/images/g9.jpg"></a></div>
			</div>
		</div>
	</div>

	<div class="brag paral paralsec">
		<div class="container about-brag__container">
			<div class="row">
				<div class="col-md-2 col-sm-12">
					<img src="/images/logo2.png" alt="Roadlab Logo">
				</div>
				<div class="col">
					<h3 class="about-brag__heading">WANT TO HEAR MORE?</h3>
					<h4 class="about-brag__sub-heading">Don’t hesitate. Give us a call!</h4>
				</div>
			</div>

		</div>
	</div>
</section>

<!-- Call to action -->
<section class="cta">
	<div class="cta__background cta__container">
		<div class="container">
			<div class="row d-flex justify-content-center">
				<h4 class="cta__text"><span class="u-bold">TEAM UP WITH THE FRIENDLY EXPERTS. </span> REACH OUT TO US TODAY.</h4><a class="btn btn-white-l" href="/head-office/" role="button">GO</a>
			</div>
		</div>
	</div>
</section>