@using Interon.Roadlab.Web.Net.Core.Models.ContentModels
@inherits UmbracoViewPage<Interon.Roadlab.Web.Net.Core.Models.ContentModels.BlogCategories>
 
@{
	Layout = "MasterPage.cshtml";
}
<section class="hero">
	<div class=" hero__shadow hero__pad">
		<div class="container">
			<div class="row">
				<div class="col-md-6 col-sm-12 hero__space">
					<div class="hero__container">
						<h4 class="hero__container--sub-heading">@Model.Value("heroSmallHeading")</h4>
						<h1 class="hero__container--main-heading ">@Model.Value("heroLargeHeading")</h1>
						<hr class="hero__hr2">
						<p class="hero__container--content-sub">@Model.Value("heroShortDescription")</p>
						<div class="hero__container--content">
							<p>@Model.Value("heroContent")</p>
						</div>

					</div>

				</div><div class="col-md-5 col-sm-12"><img class="about-team__img" src="/media/zmffny3g/manb.png" alt="team"></div>
			</div>
		</div>
	</div>
</section>
<section class="about-team">
	<div class="about-team__background">
		<div class="products__heading paral" style="background-image:url(@Umbraco.Media(Model.Value<IPublishedContent>("backImage").Id).Url());">
			<div class="blog-head__back">
				<div class="container">
					<div class="row products__heading-container">
						<div class="col-md-11 col-sm-12 products__heading--line products__heading--space">
							<p class="about-team__container--sub-heading">@Model.PageHeadingTop</p>
							<h2 class="about-team__container--main-heading">@Model.PageHeadingBottom</h2>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="container ">
			<div class="row"></div>
			<div class="row blog-container">
				<div class="col-lg-8 col-md-6 col-sm-12">
					<h5 class="blog__sub-container--name"></h5>
					<div class="row">
                        @Html.Partial("_RenderArticleGrid", Model.Children.OfType<BlogArticle>().Where(x => x.CategoryPageToggle == true).ToList())
					</div>
				</div>
				<!-- Side Bar Right-->
				<div class="col blog-sidebar">
					@Html.Partial("_RenderSearch")
					<div>
							
                        @Html.Partial("_RenderCategoryList")
							
                        @Html.Partial("_RenderRecentArticleList")
					</div>
				</div>
			</div>
		</div>
</div>
</section>
