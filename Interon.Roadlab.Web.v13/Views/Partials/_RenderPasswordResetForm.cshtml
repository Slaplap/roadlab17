@inherits UmbracoViewPage<Interon.Roadlab.Web.Net.Core.Models.ViewModels.PasswordResetViewModel>


<div class="container branch__container login__container">
    <div class="row">
        <div class="col">

            @using (Html.BeginUmbracoForm("Reset", "Membership", FormMethod.Post, new {@class = "form branch__form"}))
            {
                @Html.AntiForgeryToken()

                @Html.TextBoxFor(x => x.Email, new {@class = "", placeholder = "Enter Email Address", type = "email"})
                @Html.ValidationMessageFor(x=>x.Email)
                @Html.TextBoxFor(x => x.Password, new {@class = "", placeholder = "Enter New Password", type = "text"})
                @Html.ValidationMessageFor(x=>x.Password)
                @Html.TextBoxFor(x => x.OTP, new {@class = "", placeholder = "Enter OTP", type = "text"})
                @Html.ValidationMessageFor(x=>x.OTP)

                <div class="float-right">
                    <a id="otp" name="otp" class="input btn btn-blue valid" onclick="account.getOtp()"  >SEND OTP</a>
                    <input name="submit" class="input btn btn-blue" type="submit" value="SUBMIT">
                </div>
            }



        </div>

    </div>
</div>