@inherits UmbracoViewPage<Interon.Roadlab.Web.Net.Core.Models.ViewModels.ConfirmationViewModel>

<form action="/umbraco/surface/TransactionsSurface/Confirmation" method="post" class="form branch__form">


    @Html.AntiForgeryToken()
    @Html.HiddenFor(x => x.Key)
    @Html.TextAreaFor(x => x.Message, new { placeholder = "Reject Reason",@id="rejectText" })
    @Html.ValidationMessageFor(x => x.Message)

    <input name="accept" type="submit" class="btn-dark " value="Accept" />
    <input id="rejectButton" name="reject" type="submit" class="btn-dark " value="Reject" />
</form>

 
