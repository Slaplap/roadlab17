@using Interon.Roadlab.Web.v13.Extensions
@inherits UmbracoViewPage<Umbraco.Core.Models.Blocks.BlockListItem>
<section>
	<div class="container products__container">
		<div class="row">
			<div class="col-md-8">
				<div>
					<h1 class="hero__container--main-heading-2">@Model.Content.Value("title")</h1>
				</div>

					<div class="products__space">
						@Model.Content.Value("content")
					</div>

			</div>
			<div class="col-md-4 col-sm-12 products__overflow">
				@foreach (var item in Model.Content.Value<IEnumerable<IPublishedContent>>("images" ) ?? Enumerable.Empty<IPublishedContent>())
				{
        <div class="mb-5"><img alt="@item.AltText()" class="animated products__img" src="@item.Url()"></div>
				}

				
     
			</div>
		</div>
		<hr class="products__divider-2">
	</div>
</section>