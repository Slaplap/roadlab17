@using Interon.Roadlab.Web.Net.Core.Models.ContentModels
@using Interon.Roadlab.Web.Net.Core.Models.ViewModels
@inherits UmbracoViewPage<Interon.Roadlab.Web.Net.Core.Models.ContentModels.BlogArticle>

@{
	Layout = "MasterPage.cshtml";
}
@section topscripts
{
	
<link href="/css/blog.css" rel="stylesheet" />
}
<section class="hero">
	<div class=" hero__shadow hero__pad">
		<div class="container">
			<div class="row">
				<div class="col-md-6 col-sm-12 hero__space">
					<div class="hero__container">
						<h4 class="hero__container--sub-heading">@Model.Value("heroSmallHeading")</h4>
						<h1 class="hero__container--main-heading ">@Model.Value("heroLargeHeading")</h1>
						<hr class="hero__hr2">
						<p class="hero__container--content-sub">@Model.Value("heroShortDescription")</p>
						<div class="hero__container--content">
							<p>@Model.Value("heroContent")</p>
						</div>

					</div>

				</div><div class="col-md-5 col-sm-12"><img class="about-team__img" src="/media/zmffny3g/manb.png" alt="team"></div>
			</div>
		</div>
	</div>
</section>
<section class="about-team">
	<div class="about-team__background">
		<div class="products__heading paral" style="background-image:url(@(Model.BackImage?.Url()??"")">
			<div class="blog-head__back">
				<div class="container">
					<div class="row products__heading-container">
						<div class="col-md-11 col-sm-12 products__heading--line products__heading--space">
							<p class="about-team__container--sub-heading">@Model.PageHeadingTop</p>
							<h2 class="about-team__container--main-heading">@Model.PageHeadingBottom</h2>
						</div>
					</div>
				</div>
			</div>
		</div>
		<div class="container">
			<div class="row"></div>
			<div class="row blog-container">
				<div class="col-lg-8 col-md-6 col-sm-12">
					<h1 class="heading-h3">@Model.Value("blogHeading")</h1>
					<div class="row">
						<!--<div class="col">-->
						<div class="blog-image-left">
							@Html.GetGridHtml(Model, "grid")
						</div>
						<!--</div>-->
					</div>
					<div class="blog-back">
                        <div id="ContactFormPlaceHolder">
							@if (Model.BranchSelector != null)
							{
							    var branch = (Branch) Model.BranchSelector;
                                @Html.Partial("_RenderContactForm", new ContactModel() {BranchEmail = branch.BranchEmail,BranchName = $"Blog Article | {Model.BlogHeading} | "  + branch.BranchName})

							     
							}
                        </div>
					</div>
				</div>
				<!-- Side Bar Right-->
				<div class="col  blog-sidebar ">
					<div class="mb-5">
						<h5 class="blog__sub-container--name my-3 mb-3">ABOUT THIS CASE</h5>
                        <hr />
                         @if (Model.LocationList.Any())
                         {
                             <p class="case-title">Location</p>
                             foreach (var block in Model.LocationList)
                             {
                                 var stringItem = (StringItem)block.Content;
                             <p><span class="ft-icon" style="margin-right:10px;"><i class="fas fa-angle-right"></i></span>@stringItem.StringItemText</p>
                             }
                         }
                        @if (Model.LocationList.Any())
                        {
                           <p class="case-title">Industry</p>
                            foreach (var block in Model.IndustryList)
                            {
                                var stringItem = (StringItem)block.Content;
                                <p><span class="ft-icon" style="margin-right:10px;"><i class="fas fa-angle-right"></i></span>@stringItem.StringItemText</p>
                            }
                        }
                        @if (Model.LocationList.Any())
                        {
                        <p class="case-title">Our Expertise</p>
                            foreach (var block in Model.ExpertiseList)
                            {
                                var stringItem = (StringItem)block.Content;
                                <p><span class="ft-icon" style="margin-right:10px;"><i class="fas fa-angle-right"></i></span>@stringItem.StringItemText</p>
                            }
                        }
                         
                       


					</div>
					<div>
						@Html.Partial("_RenderSearch")
						 				
                        @Html.Partial("_RenderCategoryList")
							
                        @Html.Partial("_RenderRecentArticleList")
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
