    <pageTitle>
      <Value><![CDATA[Material Sampling Load Simulators Concrete Field Testing]]></Value>
    </pageTitle>
    <serviceCategories>
      <Value><![CDATA[[
  {
    "key": "0cddf577-7add-4192-848c-8e76f86b88d4",
    "name": "Item 1",
    "ncContentTypeAlias": "products",
    "categoryNumber": "01",
    "categoryHeading1": "Nuclear Density",
    "category": "<p style=\"text-align: right;\">Used to determine the in-situ density of soil, gravel and sand material as well as the moisture content of a surface layer.</p>",
    "categoryImage": "umb://media/aae7fa010b5e49bdaf79000e85b3cbe6"
  },
  {
    "key": "52cd20c8-fdee-4fec-810b-3d50fef47505",
    "name": "Item 2",
    "ncContentTypeAlias": "products",
    "categoryNumber": "02",
    "categoryHeading1": "Cored Specimens ",
    "category": "<p style=\"text-align: right;\">This method is used to extract field specimens for use in determining UCS or ITS of stablilised materials.</p>",
    "categoryImage": "umb://media/3271fb9b5d594743bf891ae4fe00de4e"
  },
  {
    "key": "930cfd2e-bf39-4720-9e80-bca9f04ddb23",
    "name": "Item 3",
    "ncContentTypeAlias": "products",
    "categoryNumber": "03",
    "categoryHeading1": "Sand Replacement",
    "category": "<p style=\"text-align: right;\">Determines the in-situ density of a layerwhere the nuclear density method is unsuitable.</p>",
    "categoryImage": "umb://media/5541eeabf70d4996bbac8f1a2bcd90dc"
  },
  {
    "key": "6a648241-8e95-4d33-828e-60e5b3736f1d",
    "name": "Item 4",
    "ncContentTypeAlias": "products",
    "categoryNumber": "04",
    "categoryHeading1": " Dynamic Cone Penetrometer (DCP) ",
    "category": "<p style=\"text-align: right;\">Used to determine the resistance of the material as well as to interpolate the expected California Bearing Ratio.</p>",
    "categoryImage": "umb://media/ed87753af75940fe80be9e97bc55c71e"
  },
  {
    "key": "b02764b8-197c-4340-921b-87fec52432b4",
    "name": "Item 5",
    "ncContentTypeAlias": "products",
    "categoryNumber": "05",
    "categoryHeading1": "Plate Load Test",
    "category": "<p style=\"text-align: right;\">Determine the ultimate bearing capacity of soil and the probable settlement under a given load.</p>",
    "categoryImage": "umb://media/2c52f14177ca469ca98f2ff5099b4b6e"
  },
  {
    "key": "da4d6bff-14e1-46a8-9f08-9b9e30c95e45",
    "name": "Item 6",
    "ncContentTypeAlias": "products",
    "categoryNumber": "06",
    "categoryHeading1": "Asphalt and Concrete Coring",
    "category": "<p style=\"text-align: right;\">Used to extract field specimens to determine layer thickness, BRD on asphalt specimens and more.</p>",
    "categoryImage": "umb://media/b0d3efcb42144642a9b810b29a55112a"
  },
  {
    "key": "e501bd6c-a13a-4e42-9492-c57053afb99f",
    "name": "Item 7",
    "ncContentTypeAlias": "products",
    "categoryNumber": "07",
    "categoryHeading1": "Ball Penetration Test",
    "category": "<p style=\"text-align: right;\">The ball penetration test is used to simulate the embedment of stone chips that occurs during construction and under traffic loading.</p>",
    "categoryImage": "umb://media/ac7aba25a7654da78dfab83c46670760"
  },
  {
    "key": "8cc8c781-f0e0-4fe9-90f3-38c24c259ecc",
    "name": "Item 8",
    "ncContentTypeAlias": "products",
    "categoryNumber": "08",
    "categoryHeading1": "Clegg Impact Hammer Testing",
    "category": "<p style=\"text-align: right;\">Measures soil strength and consolidation levels during trench re-instatement and confirm uniform compaction over areas of ground.</p>",
    "categoryImage": "umb://media/25c08ce5bfcb4c29a49acebe064668ef"
  },
  {
    "key": "98caa91d-2147-4e2a-bd88-2ffad1908b84",
    "name": "Item 9",
    "ncContentTypeAlias": "products",
    "categoryNumber": "9",
    "categoryHeading1": "Rolling Straight Edge",
    "category": "<p style=\"text-align: right;\">Used to determine the rideability of a specific road surface area and measure the transition between where processed sections join.</p>",
    "categoryImage": "umb://media/e055c4319abc4285bc6c4bd12d57e81e"
  },
  {
    "key": "8ded6a41-c31a-4ac0-86a2-2bea03f7f957",
    "name": "Item 10",
    "ncContentTypeAlias": "products",
    "categoryNumber": "10",
    "categoryHeading1": "Sampling of Materials",
    "category": "<p style=\"text-align: right;\">Obtaining of asphalt, soils, gravels, concrete or bitumen samples that are representative of the material used during construction phases</p>",
    "categoryImage": "umb://media/5cdd14bc58454e5c8912bf3615854ce0"
  },
  {
    "key": "3840d374-1aaf-445e-a4e9-06940582d909",
    "name": "Item 11",
    "ncContentTypeAlias": "products",
    "categoryNumber": "11",
    "categoryHeading1": "Dynamic Probe Super Heavy (DPSH)",
    "category": "<p style=\"text-align: right;\">Used in favourable conditions to determine the expected bearing capacity of soils .</p>",
    "categoryImage": "umb://media/87a04ba999934633adbb8aabc6798ce1"
  },
  {
    "key": "12eded25-7ece-4b53-ae23-e859f4e7cc9f",
    "name": "Item 12",
    "ncContentTypeAlias": "products",
    "categoryNumber": "12",
    "categoryHeading1": "Falling Weight Deflectometer (FWD)",
    "category": "<p style=\"text-align: right;\">The most practical system to accurately measuring pavement’s deflection response when subject to a dynamic load.</p>",
    "categoryImage": "umb://media/79ea8ad6292b45c8b751826e9387034f"
  },
  {
    "key": "1c367ad4-5b4c-4f6e-ba05-62da35be8e1f",
    "name": "Item 13",
    "ncContentTypeAlias": "products",
    "categoryNumber": "13",
    "categoryHeading1": "International Roughness Index (IRI)",
    "category": "<p style=\"text-align: right;\">Measure surface roughness, texture and rutting to calculate ride comfort, surface friction and noise generation.</p>",
    "categoryImage": "umb://media/01c266abe4b546e587c268f649d69b4d"
  },
  {
    "key": "980a60c1-cc3b-4a9b-97db-bd31b57c96b2",
    "name": "Item 14",
    "ncContentTypeAlias": "products",
    "categoryNumber": "14",
    "categoryHeading1": "Walking profilometer  ",
    "category": "<p style=\"text-align: right;\">Evaluate the surface condition of pavement. Measures surface roughness, texture and transition irregularities and surface rutting.</p>",
    "categoryImage": "umb://media/5dcb987e1ba54a9b9f397c467ae55f9d"
  },
  {
    "key": "7d6e0991-c517-4637-8a4e-81cae156c297",
    "name": "Item 15",
    "ncContentTypeAlias": "products",
    "categoryNumber": "15",
    "categoryHeading1": "Model Mobile Load Simulator (MMLS 3)",
    "category": "<p style=\"text-align: right;\">One of 13 world wide, this allows us to simulate traffic, moisture and temperature effects on a pavement layer, recreating real-life stresses.</p>",
    "categoryImage": "umb://media/3fe34daddbd140189bd4ed5814c6480d"
  },
  {
    "key": "4aa60779-e228-4af0-9b89-adcd8dd0ea9c",
    "name": "Item 16",
    "ncContentTypeAlias": "products",
    "categoryNumber": "16",
    "categoryHeading1": "Concrete crack width meter/camera",
    "category": "<p style=\"text-align: right;\">Investigate cracks width on concrete structures such as walls, tunnels, bridges etc. with photographic recording - accuracy of 0.01mm.</p>",
    "categoryImage": "umb://media/d1d308c1df1041809d052cf3f917d0b3"
  },
  {
    "key": "512e0c24-cf4d-4154-9b4b-35b612d63862",
    "name": "Item 17",
    "ncContentTypeAlias": "products",
    "categoryNumber": "18",
    "categoryHeading1": "Proceq Concrete scanning",
    "category": "<p style=\"text-align: right;\">Non-destructive testing of concrete structures using ground penetrating radar to an effective depth exceeding 700mm.</p>",
    "categoryImage": "umb://media/1d19ea6aa8c64ae68b01095183eaca02"
  },
  {
    "key": "6943d597-e69e-4e8d-b6f3-0abb39886a69",
    "name": "Item 18",
    "ncContentTypeAlias": "products",
    "categoryNumber": "19",
    "categoryHeading1": "Certification of a binder distributor ",
    "category": "<p style=\"text-align: right;\">Certification of a binder distributor, validation of binder distributor dipstick, power and speed indicator test, pump system performance, and transverse distribution.</p>",
    "categoryImage": "umb://media/f729aeba0fdd44f4b9ca299ca5552b11"
  },
  {
    "key": "1c0675f9-5cf9-4cae-b107-fe9248d2302d",
    "name": "Item 19",
    "ncContentTypeAlias": "products",
    "categoryNumber": "20",
    "categoryHeading1": "Marvil test",
    "category": "<p style=\"text-align: right;\">The permeability of a bituminous layer indirectly indicates the material’s susceptibility to the ingress of water.</p>",
    "categoryImage": "umb://media/0d99d5c7def3405f92d6b32658447a56"
  },
  {
    "key": "dcd81f90-dd8b-46b9-bb70-1e05a6987f68",
    "name": "Item 20",
    "ncContentTypeAlias": "products",
    "categoryNumber": "21",
    "categoryHeading1": "Texture depth measurement ",
    "category": "<p style=\"text-align: center;\">This test is used to determine the texture of a road surface, also known as roughness.</p>",
    "categoryImage": "umb://media/a478384949484bc7a94b555c7222ac3d"
  },
  {
    "key": "5b04b451-77a5-4eb3-becf-19e75034e7f8",
    "name": "Item 21",
    "ncContentTypeAlias": "products",
    "categoryNumber": "22",
    "categoryHeading1": "Ball penetration ",
    "category": "<p style=\"text-align: right;\">The ball penetration test is used to simulate the embedment of stone chips that occurs during construction and under traffic loading.</p>",
    "categoryImage": "umb://media/8376eb066e3e409aa20972582c6ec243"
  },
  {
    "key": "71d62bc2-bc70-4504-9bf5-024a3d4f5718",
    "name": "Item 22",
    "ncContentTypeAlias": "products",
    "categoryNumber": "23",
    "categoryHeading1": "Cover meter testing ",
    "category": "<p style=\"text-align: right;\">Determining the reinforcing depth in an existing concrete structure with the use of a rebar detector.</p>",
    "categoryImage": "umb://media/470c61ae6c554ff89c4ae9df1cc96899"
  },
  {
    "key": "62545ae1-1702-440c-9fb1-26704051142e",
    "name": "Item 23",
    "ncContentTypeAlias": "products",
    "categoryNumber": "24",
    "categoryHeading1": "Rebound hammer ",
    "category": "<p style=\"text-align: right;\">This device measures the elastic properties or strength of concrete or rock, mainly surface hardness and penetration resistance.</p>",
    "categoryImage": "umb://media/0121d57ab47b4f088186178238d08b00"
  },
  {
    "key": "3c014c76-5239-46ce-a3b5-446133af111c",
    "name": "Item 24",
    "ncContentTypeAlias": "products",
    "categoryNumber": "25",
    "categoryHeading1": "Ultrasonic pulse velocity and echo",
    "category": "<p style=\"text-align: right;\">Scanning of sub-surface targets in concrete to determine strength and quality, evaluating slab thickness and the severity of honey combing.</p>",
    "categoryImage": "umb://media/bc50ba2dcda14e2f8fc67a3ca6e34ede"
  }
]]]></Value>
