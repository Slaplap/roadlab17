              }
            ]
          },
          {
            "contentTypeKey": "66725937-203a-4159-a7d9-d57911ea075e",
            "udi": "umb://element/d1a41a87df2844749b2fcc1a13139679",
            "title": "Liquid Limit",
            "description": "Water content where the soil starts to behave as a liquid.",
            "image": [
              {
                "key": "ad80c39e-b97a-4c09-9628-e5b032d451bc",
                "mediaKey": "7c886011-c1a0-46fb-a610-2710695afa30",
                "crops": [],
                "focalPoint": {
