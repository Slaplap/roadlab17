          },
          {
            "contentTypeKey": "66725937-203a-4159-a7d9-d57911ea075e",
            "udi": "umb://element/2ea8fbaf759c438aae9f8569944322f4",
            "title": "Tensile",
            "description": "Evaluate subgrade strength, primarily of roads, pavements and foundations.\n\n",
