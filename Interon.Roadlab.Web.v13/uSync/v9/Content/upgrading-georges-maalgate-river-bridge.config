                    "image": "/media/syipu5fc/5.jpeg"
                  },
                  "editor": {
                    "alias": "media",
                    "view": "media"
                  },
                  "styles": null,
                  "config": null
                },
                {
                  "value": "<p> </p>\n<hr />\n<p><strong>Soil testing</strong><br />Compaction and densities<br />Material classification<br />Geotechnical investigation<br />Test pit investigation and analysis<br />Dynamic cone penetration<br />Stabilization mix designs<br />Material analysis<br /><br /></p>\n<hr />\n<p> </p>",
                  "editor": {
                    "alias": "rte",
                    "view": "rte"
                  },
                  "styles": null,
                  "config": null
                }
              ],
