    <serviceCategories>
      <Value><![CDATA[[
  {
    "key": "a19e9ff6-726a-4bea-afae-710098adf739",
    "name": "Item 1",
    "ncContentTypeAlias": "products",
    "categoryNumber": "01",
    "categoryHeading1": "Organic Impurities ",
    "category": "<p style=\"text-align: right;\">This test is done to determine the short-term retardation and long-term deleterious effects of organic impurities.</p>",
    "categoryImage": "umb://media/a974c907117d413ba8ec2c8493afe65f"
  },
  {
    "key": "d7c1104f-f204-4ca9-99b3-0161751f8ac6",
    "name": "Item 2",
    "ncContentTypeAlias": "products",
    "categoryNumber": "02",
    "categoryHeading1": "Chloride Content ",
    "category": "<p style=\"text-align: right;\">Specifies the determination of the chloride content in aggregates which can have a negative binding effect in some construction applications.</p>",
    "categoryImage": "umb://media/cdef245ec76245ea82bff0cc08492957"
  },
  {
    "key": "83e008ce-a1b8-4923-ae14-583a1bee7f19",
    "name": "Item 3",
    "ncContentTypeAlias": "products",
    "categoryNumber": "03",
    "categoryHeading1": "Water Soluble Salt Content ",
    "category": "<p style=\"text-align: right;\">This standard specifies a method for determining the total water-soluble salt content of fine aggregates and of fines in aggregates for base courses.</p>",
    "categoryImage": "umb://media/89ec34451eaf4c2696aadbceb622ee9a"
  },
  {
    "key": "fe283404-2d83-44c3-b968-eed495dff6d8",
    "name": "Item 4",
    "ncContentTypeAlias": "products",
    "categoryNumber": "04",
    "categoryHeading1": "Deleterious Clay Content ",
    "category": "<p style=\"text-align: right;\">This method determines whether the clay content of the fines of an aggregate contains deleterious swelling or active clay minerals.</p>",
    "categoryImage": "umb://media/5978f1b0fd404c7fb1d91a1972044feb"
  },
  {
    "key": "e5977799-634d-4b06-b88b-f50ed2982005",
    "name": "Item 5",
    "ncContentTypeAlias": "products",
    "categoryNumber": "05",
    "categoryHeading1": "Initial Stabilizer Content ",
    "category": "<p style=\"text-align: right;\">Determines the percentage of stabilizer that will first be absorbed by material to neutralize acidity levels before stabilizing takes effect.</p>",
    "categoryImage": "umb://media/da4f18c308f0442398623dc9093a21fd"
  },
  {
    "key": "3ddfe2c3-baba-4781-ab6d-2c7fe87cf66f",
    "name": "Item 6",
    "ncContentTypeAlias": "products",
    "categoryNumber": "06",
    "categoryHeading1": "Moisture in Asphalt",
    "category": "<p style=\"text-align: right;\">Used to determine the percentage moisture in a freshly mixed hot mix asphalt (HMA) mix.</p>",
    "categoryImage": "umb://media/9ce316b4b462465c9547a7b1c5c3b465"
  },
  {
    "key": "c8844039-ce98-4caf-8d6a-bf746ef33e35",
    "name": "Item 7",
    "ncContentTypeAlias": "products",
    "categoryNumber": "07",
    "categoryHeading1": "Plasticity index Hydrometer test",
    "category": "<p style=\"text-align: right;\">To determine the particle size distribution of materials to detail the silt and clay percentages.</p>",
    "categoryImage": "umb://media/763bef97beb848e5b2b38778689b9eba"
  },
  {
    "key": "26e0a9a9-d53d-449f-bc8e-5b541b4968e3",
    "name": "Item 8",
    "ncContentTypeAlias": "products",
    "categoryNumber": "08",
    "categoryHeading1": "Rock Durability Using 10% FACT ",
    "category": "<p style=\"text-align: right;\">Used to determine the strength of the aggregate sample after it has been exposed to a weathering agent.</p>",
    "categoryImage": "umb://media/06ebb11e730f45d286c6575826b78c2d"
  },
  {
    "key": "8cfa0acc-bf96-4c04-b8a4-b21a0f2565ba",
    "name": "Item 9",
    "ncContentTypeAlias": "products",
    "categoryNumber": "09",
    "categoryHeading1": "Back-titration ",
    "category": "<p style=\"text-align: right;\">To determine the percentage of stabilizer added during the construction phase to assess design and proper mixing.</p>",
    "categoryImage": "umb://media/36e9d37b0d8e4840ae78716bcea0b091"
  },
  {
    "key": "0b668753-7b67-4d16-aa99-fff060334f2a",
    "name": "Item 10",
    "ncContentTypeAlias": "products",
    "categoryNumber": "10",
    "categoryHeading1": "Particle & Relative Density",
    "category": "<p style=\"text-align: right;\">The ratio of mass to the mass of an equal volume of water, which defines the weight or density of a material.</p>",
    "categoryImage": "umb://media/3ea4864781b24dc39edeb9da0b4cb1c4"
  },
  {
    "key": "8d2561fd-c6b9-492e-963e-ea28595379f9",
    "name": "Item 11",
    "ncContentTypeAlias": "products",
    "categoryNumber": "11",
    "categoryHeading1": "Methylene Blue",
    "category": "<p style=\"text-align: right;\">Determines whether the clay content of the fines of an aggregate contains deleterious swelling clay minerals which could adversely affect the quality of the asphalt mix.</p>",
    "categoryImage": "umb://media/132ac59b5bd64386bee17d6f5bb4f183"
  }
]]]></Value>
