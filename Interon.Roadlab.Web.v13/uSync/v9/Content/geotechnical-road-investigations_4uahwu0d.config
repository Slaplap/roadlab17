            "udi": "umb://element/76363c6d127041f0af75a321e18dd9cf",
            "title": "Collapse Potential",
            "description": "",
            "image": [
              {
                "key": "3b5260c8-a646-46e0-a4af-8a32f084a916",
                "mediaKey": "1fce96a8-bda6-4a64-9f80-48df18a3944c"
