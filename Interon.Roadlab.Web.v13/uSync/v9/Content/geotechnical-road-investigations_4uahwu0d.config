          },
          {
            "contentTypeKey": "66725937-203a-4159-a7d9-d57911ea075e",
            "udi": "umb://element/55216cb0277c45e886dd91063735c865",
            "title": "Dynamic Cone Penetrometer (DCP)",
            "description": "",
            "image": [
              {
                "key": "8ebadd62-c5e8-4238-a592-416a0e3f5f0e",
                "mediaKey": "eaced875-afe5-4824-b732-52061595d210"
              }
