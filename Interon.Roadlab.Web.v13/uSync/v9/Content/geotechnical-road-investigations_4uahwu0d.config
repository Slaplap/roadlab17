    {
      "contentTypeKey": "3ef5c851-77d2-46af-9a22-e2bfadd01829",
      "udi": "umb://element/247f2c2ab97642c2851d213f466b7a60",
      "title": "Dolomite Stability Investigations",
      "content": {
        "markup": "<p>In addition to standard onsite investigations and laboratory testing, we offer specialised geotechnical tests tailored to specific ground conditions that may present unique challenges.<br><br>These tests ensure comprehensive risk assessment and mitigation strategies for complex projects.</p>\n<p>Dolomitic Stability Investigations, in areas with dolomitic rock formations, reduce the risk of sinkholes&nbsp;and subsidence which poses a serious threat to infrastructure, allowing for appropriate mitigation<br>measures to protect structures and prevent ground collapse.<br><br>Other testing in this field includes gravity surveys, XRDs and MASWs.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
