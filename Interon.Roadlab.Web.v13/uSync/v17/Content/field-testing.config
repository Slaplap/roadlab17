{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/0cddf5777add4192848c8e76f86b88d4"},{"contentUdi":"umb://element/52cd20c8fdee4fec810b3d50fef47505"},{"contentUdi":"umb://element/930cfd2ebf3947209e80bca9f04ddb23"},{"contentUdi":"umb://element/6a6482418e954d33828e60e5b3736f1d"},{"contentUdi":"umb://element/b02764b8197c4340921b87fec52432b4"},{"contentUdi":"umb://element/da4d6bff14e146a89f089b9e30c95e45"},{"contentUdi":"umb://element/e501bd6ca13a4e429492c57053afb99f"},{"contentUdi":"umb://element/8cc8c781f0e04fe990f338c24c259ecc"},{"contentUdi":"umb://element/98caa91d21474e2abd882ffad1908b84"},{"contentUdi":"umb://element/8ded6a41c31a4ac086a22bea03f7f957"},{"contentUdi":"umb://element/3840d3741aaf445ea4e906940582d909"},{"contentUdi":"umb://element/12eded257ece4b53ae23e859f4e7cc9f"},{"contentUdi":"umb://element/1c367ad45b4c4f6eba0562da35be8e1f"},{"contentUdi":"umb://element/980a60c1cc3b4a9b97dbbd31b57c96b2"},{"contentUdi":"umb://element/7d6e0991c51746378a4e81cae156c297"},{"contentUdi":"umb://element/4aa60779e2284af09b89adcd8dd0ea9c"},{"contentUdi":"umb://element/512e0c24cf4d41549b4b35b612d63862"},{"contentUdi":"umb://element/6943d597e69e4e8db6f30abb39886a69"},{"contentUdi":"umb://element/1c0675f95cf94caeb107fe9248d2302d"},{"contentUdi":"umb://element/dcd81f90dd8b46b9bb701e05a6987f68"},{"contentUdi":"umb://element/5b04b45177a54eb3becf19e75034e7f8"},{"contentUdi":"umb://element/71d62bc2bc7045049bf5024a3d4f5718"},{"contentUdi":"umb://element/62545ae11702440c9fb126704051142e"},{"contentUdi":"umb://element/3c014c76523946cea3b5446133af111c"}]},"contentData":[{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/0cddf5777add4192848c8e76f86b88d4","categoryNumber":"01","categoryHeading1":"Nuclear Density","category":"\u003cp style=\"text-align: right;\"\u003eUsed to determine the in-situ density of soil, gravel and sand material as well as the moisture content of a surface layer.\u003c/p\u003e","categoryImage":"[{\"key\":\"a4f8712c-6cc9-4f7c-a641-6da5d551f464\",\"mediaKey\":\"aae7fa01-0b5e-49bd-af79-000e85b3cbe6\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/52cd20c8fdee4fec810b3d50fef47505","categoryNumber":"02","categoryHeading1":"Cored Specimens ","category":"\u003cp style=\"text-align: right;\"\u003eThis method is used to extract field specimens for use in determining UCS or ITS of stablilised materials.\u003c/p\u003e","categoryImage":"[{\"key\":\"84e056af-c844-4e9b-894b-7499bb185755\",\"mediaKey\":\"3271fb9b-5d59-4743-bf89-1ae4fe00de4e\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/930cfd2ebf3947209e80bca9f04ddb23","categoryNumber":"03","categoryHeading1":"Sand Replacement","category":"\u003cp style=\"text-align: right;\"\u003eDetermines the in-situ density of a layerwhere the nuclear density method is unsuitable.\u003c/p\u003e","categoryImage":"[{\"key\":\"408aac73-52dd-4967-ab91-29f54b14c05b\",\"mediaKey\":\"5541eeab-f70d-4996-bbac-8f1a2bcd90dc\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/6a6482418e954d33828e60e5b3736f1d","categoryNumber":"04","categoryHeading1":" Dynamic Cone Penetrometer (DCP) ","category":"\u003cp style=\"text-align: right;\"\u003eUsed to determine the resistance of the material as well as to interpolate the expected California Bearing Ratio.\u003c/p\u003e","categoryImage":"[{\"key\":\"f5ded42c-02e0-47b9-9a2c-fafde2d6e3b2\",\"mediaKey\":\"ed87753a-f759-40fe-80be-9e97bc55c71e\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/b02764b8197c4340921b87fec52432b4","categoryNumber":"05","categoryHeading1":"Plate Load Test","category":"\u003cp style=\"text-align: right;\"\u003eDetermine the ultimate bearing capacity of soil and the probable settlement under a given load.\u003c/p\u003e","categoryImage":"[{\"key\":\"dd04c61d-0036-4712-bbb0-8d3f1a223afc\",\"mediaKey\":\"2c52f141-77ca-469c-a98f-2ff5099b4b6e\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/da4d6bff14e146a89f089b9e30c95e45","categoryNumber":"06","categoryHeading1":"Asphalt and Concrete Coring","category":"\u003cp style=\"text-align: right;\"\u003eUsed to extract field specimens to determine layer thickness, BRD on asphalt specimens and more.\u003c/p\u003e","categoryImage":"[{\"key\":\"1a4dd76c-b2a5-4f95-a10f-b15d679faaab\",\"mediaKey\":\"b0d3efcb-4214-4642-a9b8-10b29a55112a\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/e501bd6ca13a4e429492c57053afb99f","categoryNumber":"07","categoryHeading1":"Ball Penetration Test","category":"\u003cp style=\"text-align: right;\"\u003eThe ball penetration test is used to simulate the embedment of stone chips that occurs during construction and under traffic loading.\u003c/p\u003e","categoryImage":"[{\"key\":\"f5af7a22-eeb5-4e3f-aa15-c63ce9287c90\",\"mediaKey\":\"ac7aba25-a765-4da7-8dfa-b83c46670760\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/8cc8c781f0e04fe990f338c24c259ecc","categoryNumber":"08","categoryHeading1":"Clegg Impact Hammer Testing","category":"\u003cp style=\"text-align: right;\"\u003eMeasures soil strength and consolidation levels during trench re-instatement and confirm uniform compaction over areas of ground.\u003c/p\u003e","categoryImage":"[{\"key\":\"8f9fcd16-d900-4180-9ae9-d2f128b20b22\",\"mediaKey\":\"25c08ce5-bfcb-4c29-a49a-cebe064668ef\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/98caa91d21474e2abd882ffad1908b84","categoryNumber":"9","categoryHeading1":"Rolling Straight Edge","category":"\u003cp style=\"text-align: right;\"\u003eUsed to determine the rideability of a specific road surface area and measure the transition between where processed sections join.\u003c/p\u003e","categoryImage":"[{\"key\":\"7b902187-c35d-4f7b-946a-48e4e81f206e\",\"mediaKey\":\"e055c431-9abc-4285-bc6c-4bd12d57e81e\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/8ded6a41c31a4ac086a22bea03f7f957","categoryNumber":"10","categoryHeading1":"Sampling of Materials","category":"\u003cp style=\"text-align: right;\"\u003eObtaining of asphalt, soils, gravels, concrete or bitumen samples that are representative of the material used during construction phases\u003c/p\u003e","categoryImage":"[{\"key\":\"997e03f7-7ed2-4b0d-93eb-870923867116\",\"mediaKey\":\"5cdd14bc-5845-4e5c-8912-bf3615854ce0\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/3840d3741aaf445ea4e906940582d909","categoryNumber":"11","categoryHeading1":"Dynamic Probe Super Heavy (DPSH)","category":"\u003cp style=\"text-align: right;\"\u003eUsed in favourable conditions to determine the expected bearing capacity of soils .\u003c/p\u003e","categoryImage":"[{\"key\":\"efa83101-4485-4a94-aae3-b7cd0dc0e1e5\",\"mediaKey\":\"87a04ba9-9993-4633-adbb-8aabc6798ce1\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/12eded257ece4b53ae23e859f4e7cc9f","categoryNumber":"12","categoryHeading1":"Falling Weight Deflectometer (FWD)","category":"\u003cp style=\"text-align: right;\"\u003eThe most practical system to accurately measuring pavement’s deflection response when subject to a dynamic load.\u003c/p\u003e","categoryImage":"[{\"key\":\"ae63fa54-9a31-4af4-a6c9-846195fd3c9f\",\"mediaKey\":\"79ea8ad6-292b-45c8-b751-826e9387034f\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/1c367ad45b4c4f6eba0562da35be8e1f","categoryNumber":"13","categoryHeading1":"International Roughness Index (IRI)","category":"\u003cp style=\"text-align: right;\"\u003eMeasure surface roughness, texture and rutting to calculate ride comfort, surface friction and noise generation.\u003c/p\u003e","categoryImage":"[{\"key\":\"24d72a33-dde7-4421-8047-5964f2755129\",\"mediaKey\":\"01c266ab-e4b5-46e5-87c2-68f649d69b4d\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/980a60c1cc3b4a9b97dbbd31b57c96b2","categoryNumber":"14","categoryHeading1":"Walking profilometer  ","category":"\u003cp style=\"text-align: right;\"\u003eEvaluate the surface condition of pavement. Measures surface roughness, texture and transition irregularities and surface rutting.\u003c/p\u003e","categoryImage":"[{\"key\":\"ba6f210b-e7c9-4d9d-9bf1-c9cb1f38d8db\",\"mediaKey\":\"5dcb987e-1ba5-4a9b-9f39-7c467ae55f9d\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/7d6e0991c51746378a4e81cae156c297","categoryNumber":"15","categoryHeading1":"Model Mobile Load Simulator (MMLS 3)","category":"\u003cp style=\"text-align: right;\"\u003eOne of 13 world wide, this allows us to simulate traffic, moisture and temperature effects on a pavement layer, recreating real-life stresses.\u003c/p\u003e","categoryImage":"[{\"key\":\"ee227bfc-276b-4b3c-9f09-e4f06868f6de\",\"mediaKey\":\"3fe34dad-dbd1-4018-9bd4-ed5814c6480d\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/4aa60779e2284af09b89adcd8dd0ea9c","categoryNumber":"16","categoryHeading1":"Concrete crack width meter/camera","category":"\u003cp style=\"text-align: right;\"\u003eInvestigate cracks width on concrete structures such as walls, tunnels, bridges etc. with photographic recording - accuracy of 0.01mm.\u003c/p\u003e","categoryImage":"[{\"key\":\"f3d1fd1a-94c1-48af-8cf2-b0fb99eaf6a8\",\"mediaKey\":\"d1d308c1-df10-4180-9d05-2cf3f917d0b3\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/512e0c24cf4d41549b4b35b612d63862","categoryNumber":"18","categoryHeading1":"Proceq Concrete scanning","category":"\u003cp style=\"text-align: right;\"\u003eNon-destructive testing of concrete structures using ground penetrating radar to an effective depth exceeding 700mm.\u003c/p\u003e","categoryImage":"[{\"key\":\"801afbad-7f1f-4cfe-b6ff-f304fbf45d01\",\"mediaKey\":\"1d19ea6a-a8c6-4ae6-8b01-095183eaca02\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/6943d597e69e4e8db6f30abb39886a69","categoryNumber":"19","categoryHeading1":"Certification of a binder distributor ","category":"\u003cp style=\"text-align: right;\"\u003eCertification of a binder distributor, validation of binder distributor dipstick, power and speed indicator test, pump system performance, and transverse distribution.\u003c/p\u003e","categoryImage":"[{\"key\":\"0c6c5c48-e905-49ef-a9e1-1089e6960275\",\"mediaKey\":\"f729aeba-0fdd-44f4-b9ca-299ca5552b11\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/1c0675f95cf94caeb107fe9248d2302d","categoryNumber":"20","categoryHeading1":"Marvil test","category":"\u003cp style=\"text-align: right;\"\u003eThe permeability of a bituminous layer indirectly indicates the material’s susceptibility to the ingress of water.\u003c/p\u003e","categoryImage":"[{\"key\":\"e1234cc4-dcf6-4ce3-91cb-590440f8195e\",\"mediaKey\":\"0d99d5c7-def3-405f-92d6-b32658447a56\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/dcd81f90dd8b46b9bb701e05a6987f68","categoryNumber":"21","categoryHeading1":"Texture depth measurement ","category":"\u003cp style=\"text-align: center;\"\u003eThis test is used to determine the texture of a road surface, also known as roughness.\u003c/p\u003e","categoryImage":"[{\"key\":\"42caffd8-322a-4e52-97f7-daf3818c3d5a\",\"mediaKey\":\"a4783849-4948-4bc7-a94b-555c7222ac3d\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/5b04b45177a54eb3becf19e75034e7f8","categoryNumber":"22","categoryHeading1":"Ball penetration ","category":"\u003cp style=\"text-align: right;\"\u003eThe ball penetration test is used to simulate the embedment of stone chips that occurs during construction and under traffic loading.\u003c/p\u003e","categoryImage":"[{\"key\":\"fbe665db-46a4-46d3-9d02-69bf14ec71f2\",\"mediaKey\":\"8376eb06-6e3e-409a-a209-72582c6ec243\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/71d62bc2bc7045049bf5024a3d4f5718","categoryNumber":"23","categoryHeading1":"Cover meter testing ","category":"\u003cp style=\"text-align: right;\"\u003eDetermining the reinforcing depth in an existing concrete structure with the use of a rebar detector.\u003c/p\u003e","categoryImage":"[{\"key\":\"7ce7bde0-8fab-4b02-821c-4d4027465db6\",\"mediaKey\":\"470c61ae-6c55-4ff8-9c4a-e9df1cc96899\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/62545ae11702440c9fb126704051142e","categoryNumber":"24","categoryHeading1":"Rebound hammer ","category":"\u003cp style=\"text-align: right;\"\u003eThis device measures the elastic properties or strength of concrete or rock, mainly surface hardness and penetration resistance.\u003c/p\u003e","categoryImage":"[{\"key\":\"ee7c16f4-ea1c-4899-8316-731eb3b9f8aa\",\"mediaKey\":\"0121d57a-b47b-4f08-8186-178238d08b00\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/3c014c76523946cea3b5446133af111c","categoryNumber":"25","categoryHeading1":"Ultrasonic pulse velocity and echo","category":"\u003cp style=\"text-align: right;\"\u003eScanning of sub-surface targets in concrete to determine strength and quality, evaluating slab thickness and the severity of honey combing.\u003c/p\u003e","categoryImage":"[{\"key\":\"ca95278b-b1ce-466b-b51b-20d91c06071c\",\"mediaKey\":\"bc50ba2d-cda1-4e2f-8fc6-7a3ca6e34ede\"}]"}],"settingsData":[]}
</Value>
