    <blogHeading>
      <Value><![CDATA[LUSIPII: Supporting Sugar Cane Farmers in Rural Eswatini]]></Value>
    </blogHeading>
    <branchSelector>
      <Value><![CDATA[umb://document/890e23e62aff4881963512b8cb5683cf]]></Value>
    </branchSelector>
