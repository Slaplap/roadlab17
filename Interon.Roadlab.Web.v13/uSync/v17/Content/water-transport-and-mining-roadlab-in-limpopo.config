{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/d527747c234e4272bfcd984804e37f62"},{"contentUdi":"umb://element/d5f82aaf69fd480a90e08093cd73b2b3"},{"contentUdi":"umb://element/92516dc2a7814abbbc18284db927bb8e"}]},"contentData":[{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/d527747c234e4272bfcd984804e37f62","stringItemText":"Geotechnical Investigations"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/d5f82aaf69fd480a90e08093cd73b2b3","stringItemText":"Concrete Testing"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/92516dc2a7814abbbc18284db927bb8e","stringItemText":"Soil Testing"}],"settingsData":[]}
