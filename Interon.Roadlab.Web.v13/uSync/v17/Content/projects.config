2022.","projectImage1":"[{\"key\":\"8ee19b0a-c1b7-400d-858f-6d90501ab467\",\"mediaKey\":\"ab8dd376-6b92-4c5d-b7d1-09d737088101\"}]","projectImage2":"[{\"key\":\"5d9f760e-1269-467d-bf13-cdbf53ffa7d2\",\"mediaKey\":\"b6d0a900-b777-420c-966c-c1bc59f54567\"}]","projectImage3":"[{\"key\":\"296d941a-38a5-4693-9443-397bc8aa286c\",\"mediaKey\":\"43647547-bd0b-40b1-906e-16a6c559e59e\"}]"},{"contentTypeKey":"f2bf9cc9-ed35-4e1b-bf63-feaf3102c58b","udi":"umb://element/e4c96a91baa5475691c0b320d46ec4cd","PropType":null,"projectNumber":"03","projectHeadingTop":"Kenhardt","projectHeadingBottom":"Hybrid Energy Project","projectLocation":"Northern Cape","projectHeadingBackgroundImage":"[{\"key\":\"ff9b1e96-8bb2-4bcd-9d65-f99ed1cf2270\",\"mediaKey\":\"cf3afbc8-e134-4c2c-abfb-d05aa8b1d257\"}]","yearOfProject":"2022 - 2023","projectClient":" Scatec","projectBudget":"R13.7 billion","projectServices":"Soil Investigations\nConcrete Quality Assurance","projectLinks":"{\r\n  \"markup\": \"\u003cp\u003e\u003ca href=\\\"/{localLink:umb://document/7da6d223cbfb401bb57285a652c3c1bf}\\\" title=\\\"Kenhardt: SA\u0027s Next Renewable Powerhouse\\\"\u003eRoadlab at Kenhardt\u003c/a\u003e\u003c/p\u003e\",\r\n  \"blocks\": {\r\n    \"contentData\": [],\r\n    \"settingsData\": []\r\n  }\r\n}","projectDescription":"We are performing soil and concrete investigations at Scatec\u0027s Kenhardt project, a 540 MW solar and 225 MW/1,140 MWh battery storage project representing the largest investment in Scatec\u0027s history. ","projectImage1":"[{\"key\":\"5eda09b9-f165-4d8f-913a-b445cf2daa38\",\"mediaKey\":\"b4b0e143-0481-4f48-aefa-950b2d8c4af2\"}]","projectImage2":"[{\"key\":\"b367b010-5217-4c8e-993c-3aa113aec424\",\"mediaKey\":\"ab006e0d-95da-4aa5-a475-996ec4d0f268\"}]","projectImage3":"[{\"key\":\"4fca2a77-8de1-491b-aa22-8657eddf423f\",\"mediaKey\":\"7df602eb-1975-4d84-a3c3-bb6338d055f9\"}]"},{"contentTypeKey":"f2bf9cc9-ed35-4e1b-bf63-feaf3102c58b","udi":"umb://element/3570f375a3304ed0a6cf235b3e5c4388","Pr