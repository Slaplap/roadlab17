      <Value>
{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/4afe84c8a23949e991f43807cd991ba1"},{"contentUdi":"umb://element/39460fef79f34caaafbfa45f03c2b747"},{"contentUdi":"umb://element/602d7a91e1f34deeb841d769a25ca599"},{"contentUdi":"umb://element/96e18fe4a9d54ad1a4fdd1d59a520442"}]},"contentData":[{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/4afe84c8a23949e991f43807cd991ba1","stringItemText":"Concrete Laboratory Testing"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/39460fef79f34caaafbfa45f03c2b747","stringItemText":"Soil Laboratory Testing"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/602d7a91e1f34deeb841d769a25ca599","stringItemText":"Asphalt Laboratory Testing"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/96e18fe4a9d54ad1a4fdd1d59a520442","stringItemText":"Geotechnical Investigations"}],"settingsData":[]}
</Value>
