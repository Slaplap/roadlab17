    <blogHeading>
      <Value><![CDATA[How We're Helping Create Africa's Largest Zinc Producer]]></Value>
    </blogHeading>
    <branchSelector>
      <Value><![CDATA[umb://document/890e23e62aff4881963512b8cb5683cf]]></Value>
    </branchSelector>
