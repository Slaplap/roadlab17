    <grid>
      <Value>
{"layout":{"Umbraco.BlockGrid":[{"contentUdi":"umb://element/42a3f38bee13425094690d6b484598dc","areas":[],"columnSpan":12,"rowSpan":1}]},"contentData":[{"contentTypeKey":"9a4f7c2e-1b3d-4e8a-bf01-7d62a8f5c930","udi":"umb://element/42a3f38bee13425094690d6b484598dc","content":"\u003cp\u003e\u003cem\u003eRoadlab Laboratories scored 108% in its most recent BBBEE assessment.\u003cbr /\u003e\u003c/em\u003e\u003c/p\u003e\r\n\u003cp\u003e\u003cimg src=\"/media/luwbgmif/untitled-4.png\" /\u003e\u003c/p\u003e\r\n\u003cp\u003e \u003c/p\u003e\n\u003cp\u003eThis marks the fourth year that Roadlab has operated as a level 1 BBBEE contributor.\u003c/p\u003e\n\u003cp\u003eRoadlab is assessed using the BBBEE scorecard for construction companies, which sets a higher standard than the generic level 1 assessment.\u003c/p\u003e\n\u003cp\u003eWe look forward to seeing the rest of the industry meet this higher standard for South Africa\u0027s construction sector.\u003c/p\u003e\n\u003cp\u003eGot questions? Leave us an query below.\u003c/p\u003e\r\n"}],"settingsData":[]}
</Value>
