  <Properties>
    <blockContentPicker>
      <Value><![CDATA[umb://document/80448641da9049268fe1fa4d84521dcc,umb://document/938b098137a94802aba87664693173ef,umb://document/102f5a317f0a42c4b6aa161f2452561a]]></Value>
