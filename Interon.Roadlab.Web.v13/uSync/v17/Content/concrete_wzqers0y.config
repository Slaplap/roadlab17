    {
      "contentTypeKey": "3b803f00-a335-4bc4-bb3c-49b71dedbcca",
      "udi": "umb://element/a04cb56454574d2080c63102c552e727",
      "servicesBlockListContent": {
        "layout": {
          "Umbraco.BlockList": [
            {
              "contentUdi": "umb://element/aa5d19e622be4d4eb1c00d08540a842a"
