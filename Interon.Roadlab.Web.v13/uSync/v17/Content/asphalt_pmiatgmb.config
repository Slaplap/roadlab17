          {
            "contentTypeKey": "66725937-203a-4159-a7d9-d57911ea075e",
            "udi": "umb://element/66a9118299fd4ff4b77314747ab0c303",
            "title": "IRI (International Roughness Index)",
            "description": "Rates pavement ride quality and roughness.",
            "image": [
              {
                "key": "3a971ea5-fdac-4ff3-b64d-0d709a2f3cc1",
                "mediaKey": "9b74534f-9993-40a4-bddf-c7f310ca8311"
