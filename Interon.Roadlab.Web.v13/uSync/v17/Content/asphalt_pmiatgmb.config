  "contentData": [
    {
      "contentTypeKey": "3ef5c851-77d2-46af-9a22-e2bfadd01829",
      "udi": "umb://element/30dbc2935a9448c0a2176b336615b611",
      "title": "What is Asphalt Testing?",
      "content": {
        "markup": "<p>Asphalt testing is the process of evaluating asphalt mix designs and pavement layers to ensure that road surfaces perform safely and durably under pressure, temperature, and traffic.</p>\n<p>This testing verifies the structural integrity and performance characteristics of asphalt used in roads, highways, airfields, and parking areas. It helps ensure that pavements resist deformation, cracking, and ageing — and that they meet client and regulatory specifications.</p>\n<p>Roadlab provides accredited asphalt testing services both in our laboratories and on-site, supporting road authorities, contractors, and engineering consultants across Southern Africa.</p>",
        "blocks": {
          "contentData": [],
          "settingsData": []
        }
      },
      "images": [
        {
          "key": "a263f40b-dc1b-4a9e-9675-688081911850",
          "mediaKey": "de37880a-dc09-4e82-8c6e-8ea192cb5863"
        }
      ],
      "anchorID": ""
    },
    {
