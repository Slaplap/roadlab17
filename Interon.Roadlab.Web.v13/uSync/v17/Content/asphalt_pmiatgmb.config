            "description": "Measures surface texture and smoothness.",
            "image": [
              {
                "key": "faa20ea9-355a-43f7-9d2d-c120cbcb59cd",
                "mediaKey": "0577df2d-a7b7-4fa9-99bb-67f867db189b"
