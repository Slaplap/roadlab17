{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/1d8c8207aa1b4ecaa851e5135226d29a"},{"contentUdi":"umb://element/1f5f9405021146ddbd5a939cdcd4a907"},{"contentUdi":"umb://element/8a2b7cdc6ec1402f97e9e9b60ca0978e"}]},"contentData":[{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/1d8c8207aa1b4ecaa851e5135226d29a","stringItemText":"Geotechnical Investigations"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/1f5f9405021146ddbd5a939cdcd4a907","stringItemText":"Concrete Testing"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/8a2b7cdc6ec1402f97e9e9b60ca0978e","stringItemText":"Soil Testing"}],"settingsData":[]}
