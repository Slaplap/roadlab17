{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/5f57fa53f24a4140a6083ca3608d273c"},{"contentUdi":"umb://element/8511c3125461412d9aa55e23513f51f1"},{"contentUdi":"umb://element/75770e98f72c4da38d9487618353eadb"},{"contentUdi":"umb://element/133d9bcbe9674b47b9709ef18833a41d"},{"contentUdi":"umb://element/9fb6ae5401af465498540807bca70dad"},{"contentUdi":"umb://element/ad217926ae1a4614ae59dc8f7a0fc3cd"},{"contentUdi":"umb://element/304da993be9947d299a18739e81aa51c"},{"contentUdi":"umb://element/ee6f49d9727141e7bc9308fc9e7bc50b"}]},"contentData":[{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/5f57fa53f24a4140a6083ca3608d273c","categoryNumber":"01","categoryHeading1":"Particle Size Analysis ","category":"\u003cp style=\"text-align: right;\"\u003eAlso known as sieve analysis, this test is done to determine if the aggregates are fit for purpose.\u003c/p\u003e","categoryImage":"[{\"key\":\"75581920-e5ec-4122-a351-0b14d40a6385\",\"mediaKey\":\"c61e9a33-743b-4dd9-83a2-802781df3a5b\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/8511c3125461412d9aa55e23513f51f1","categoryNumber":"02","categoryHeading1":"Average Least Dimension (ALD) ","category":"\u003cp style=\"text-align: right;\"\u003eThe arithmetic mean of all the measured least dimensions of the aggregate particles measured. \u003c/p\u003e","categoryImage":"[{\"key\":\"8e85dbc3-7db0-40af-bee8-13fc091ec9bd\",\"mediaKey\":\"dbb24de3-e791-4a4e-928b-7bb45fffbca5\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/75770e98f72c4da38d9487618353eadb","categoryNumber":"03","categoryHeading1":"Flakiness Index  ","category":"\u003cp style=\"text-align: right;\"\u003eA measurement of the flatness of an aggregate, affecting the performance of road surfacing aggregates and the workability of concrete.\u003c/p\u003e","categoryImage":"[{\"key\":\"f3146480-726d-4566-9246-4d604eef96a7\",\"mediaKey\":\"680c44a1-8889-49ad-86ba-b15fe4770317\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/133d9bcbe9674b47b9709ef18833a41d","categoryNumber":"04","categoryHeading1":"Sand Equivalent","category":"\u003cp style=\"text-align: right;\"\u003eReveals relative proportions of dust or clay-like materials, used to assess the quality of fine aggregate used in concrete and asphalt.\u003c/p\u003e","categoryImage":"[{\"key\":\"ca58d51d-e7e7-481d-a9e3-fc9f02c84ebd\",\"mediaKey\":\"479fae26-43ad-445c-97b8-1a04de2a1502\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/9fb6ae5401af465498540807bca70dad","categoryNumber":"05","categoryHeading1":"ACV  and 10% FACT","category":"\u003cp style=\"text-align: right;\"\u003eDetermines the particle strength of aggregate for concrete, surfacing (chips) and asphalt, as well as for crushed stone base.\u003c/p\u003e","categoryImage":"[{\"key\":\"be89e1dc-a48d-47f2-b23b-f859ce2faa33\",\"mediaKey\":\"a3a76928-9790-41ce-b346-427763c964f3\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/ad217926ae1a4614ae59dc8f7a0fc3cd","categoryNumber":"06","categoryHeading1":"Polished Stone Value (PSV)","category":"\u003cp style=\"text-align: right;\"\u003eSimulates the resistance of aggregate to the polishing action of vehicle tyres under conditions similar to those occurring on a road surface.\u003c/p\u003e","categoryImage":"[{\"key\":\"8b0c8ffe-0531-453f-b04b-44cc9bd95126\",\"mediaKey\":\"7622f1da-3591-43dc-964b-8b0c378a4554\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/304da993be9947d299a18739e81aa51c","categoryNumber":"07","categoryHeading1":"Bulk Density","category":"\u003cp style=\"text-align: right;\"\u003eDetermine the relative compaction of a crushed stone base and mix design procedures of concrete and asphalt where volumetric and water absorption properties are required.\u003c/p\u003e","categoryImage":"[{\"key\":\"15904ac6-7c10-4b6e-bf1c-960eb89c5e3f\",\"mediaKey\":\"26c573e7-d97e-42c4-b9f2-094c99d5bd1d\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/ee6f49d9727141e7bc9308fc9e7bc50b","categoryNumber":"08","categoryHeading1":"Apparent Density ","category":"\u003cp style=\"text-align: right;\"\u003eThis test is used to determine the apparent density of crushed stone base. The results are used to determine compliance of the density with applicable specifications.\u003c/p\u003e","categoryImage":"[{\"key\":\"df840402-f687-4bd1-93da-1a12de20ff5d\",\"mediaKey\":\"aba72e82-e463-412d-afab-82f51371f7c4\"}]"}],"settingsData":[]}
