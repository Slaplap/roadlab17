{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/f27fa162c2914e3fab344b2523d014da"},{"contentUdi":"umb://element/650535dfe70549ed9980cfc54e505fed"},{"contentUdi":"umb://element/091087326ee54895a8db81d65c4c542a"}]},"contentData":[{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/f27fa162c2914e3fab344b2523d014da","PropType":null,"stringItemText":"Soil Testing"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/650535dfe70549ed9980cfc54e505fed","PropType":null,"stringItemText":"Concrete Strength Testing"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/091087326ee54895a8db81d65c4c542a","PropType":null,"stringItemText":"Asphalt Verification and Testing"}],"settingsData":[]}
