{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/13d4b6f068db4477b22f9d7970e8d5d3"},{"contentUdi":"umb://element/b9b1adc4ce38480f940a6c587b520c73"},{"contentUdi":"umb://element/5250991c8ed34c149d5ca6c19199e2ca"},{"contentUdi":"umb://element/1c3fbde7943b406da24a410bc370febe"},{"contentUdi":"umb://element/a17f38480fe645eb9ddabaac54b2ed92"},{"contentUdi":"umb://element/c59e0f655ca5477fa21860159d37d4ba"},{"contentUdi":"umb://element/790e5029d35e4348a8e73e09ff3ee341"},{"contentUdi":"umb://element/9ca4bad04ed14483962217d83bf4e28d"},{"contentUdi":"umb://element/a25aa5d9fb864436b060d31385793102"},{"contentUdi":"umb://element/28217373931f4dcfa5f825f746be62b9"},{"contentUdi":"umb://element/d5d4a4b7275b44a9863e392a223ce743"},{"contentUdi":"umb://element/642007fa56ac47bab908bca8ef2240cb"},{"contentUdi":"umb://element/bea2ad82a4e24bb5b9e8f80ab040dbed"},{"contentUdi":"umb://element/0a7b24fe0b274ffa8a828c8b51791992"}]},"contentData":[{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/13d4b6f068db4477b22f9d7970e8d5d3","categoryNumber":"01","categoryHeading1":"Ground Penetrating Radar (GPR)","category":"\u003cp style=\"text-align: right;\"\u003eAssess the integrity of your concrete work by locating cracks, voids and other integrity issues without sampling and \u003ca href=\"/{localLink:umb://document/102f5a317f0a42c4b6aa161f2452561a}\" title=\"Our Non-Destructive Investigation Services\"\u003enon-destructively\u003c/a\u003e.\u003c/p\u003e","categoryImage":"[{\"key\":\"654b49fb-409b-46ef-98cb-ca1aa94a280e\",\"mediaKey\":\"4cada891-4c63-4aea-adf5-db05a6c9d8f2\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/b9b1adc4ce38480f940a6c587b520c73","categoryNumber":"02","categoryHeading1":"Ultrasonic Pulse  Velocity and Echo","category":"\u003cp style=\"text-align: right;\"\u003e\u003ca href=\"/{localLink:umb://document/c47fdd44750542c5a111a817d291605c}\" title=\"Non-Destructive Forensic Investigations\"\u003eLocate sub-surface targets\u003c/a\u003e in concrete to assess strength, durability, slab thickness and the severity of honey combing.\u003c/p\u003e","categoryImage":"[{\"key\":\"9237c5cf-8d96-4d26-b4fa-15227e340110\",\"mediaKey\":\"59fb45b4-f05d-4c40-a6d8-1d16f6dc9ce6\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/5250991c8ed34c149d5ca6c19199e2ca","categoryNumber":"03","categoryHeading1":"Making \u0026 Curing of Concrete Test Specimens","category":"\u003cp style=\"text-align: right;\"\u003eSpecimens made using freshly mixed concrete can be used to determine concrete strength.\u003c/p\u003e","categoryImage":"[{\"key\":\"964a346d-f0b3-4aef-a589-ebf790f2eb51\",\"mediaKey\":\"0f261ca7-5361-4aaa-8e85-058fc5f6193b\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/1c3fbde7943b406da24a410bc370febe","categoryNumber":"04","categoryHeading1":"Slump Test","category":"\u003cp style=\"text-align: right;\"\u003eDetermines the uniformity and consistency of freshly mixed concrete to ensure it is fit-for-use.\u003c/p\u003e","categoryImage":"[{\"key\":\"0a887414-af33-4073-b305-7ecd64bd49dd\",\"mediaKey\":\"7f2d167f-d598-4e7a-ab6e-75ff876e584b\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/a17f38480fe645eb9ddabaac54b2ed92","categoryNumber":"06","categoryHeading1":"Compressive Strength of Concrete Cubes","category":"\u003cp style=\"text-align: right;\"\u003eA concrete cube press is utilised to determine the compressive strength of a concrete specimen.\u003c/p\u003e","categoryImage":"[{\"key\":\"e995268f-9303-4fef-b4f6-9ac99afb40f1\",\"mediaKey\":\"ee80b7b8-1818-42f2-ad37-ee95202e3c15\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/c59e0f655ca5477fa21860159d37d4ba","categoryNumber":"06","categoryHeading1":"Compressive Strength  of Concrete Cores ","category":"\u003cp style=\"text-align: right;\"\u003eCores are prepared for testing and used to determine the compressive strength of concrete.\u003c/p\u003e","categoryImage":"[{\"key\":\"89ccd83d-b544-4ce9-8c8a-2c0eda844207\",\"mediaKey\":\"08a10f92-f95b-4151-88a5-398eb5877429\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/790e5029d35e4348a8e73e09ff3ee341","categoryNumber":"07","categoryHeading1":"Flexural Strength of Hardened Concrete ","category":"\u003cp style=\"text-align: right;\"\u003eA concrete beam press is employed to determine the compressive strength of concrete beam.\u003c/p\u003e","categoryImage":"[{\"key\":\"47a2fb58-db8e-48f6-8ef0-531890c3299d\",\"mediaKey\":\"bc2962d2-f321-44ea-abd1-cbc2253dcea8\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/9ca4bad04ed14483962217d83bf4e28d","categoryNumber":"08","categoryHeading1":"Durability Testing","category":"\u003cp style=\"text-align: right;\"\u003eDetermines the oxygen permeability, water absorptivity and chloride conductivity of a concrete specimen.\u003c/p\u003e","categoryImage":"[{\"key\":\"1276f43b-36aa-4824-876e-a2d6581b4eb6\",\"mediaKey\":\"ad23b121-ca84-489d-93ef-8f6c6bd80f98\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/a25aa5d9fb864436b060d31385793102","categoryNumber":"09","categoryHeading1":"Concrete Crack Width Meter","category":"\u003cp style=\"text-align: right;\"\u003eA test to investigate crack width on a variety of concrete structures using photographic recording.\u003c/p\u003e","categoryImage":"[{\"key\":\"2b83c2ba-d2cd-4845-a166-acc02c0326f9\",\"mediaKey\":\"196c28c6-cae9-4e24-aef0-f6f92eaa6379\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/28217373931f4dcfa5f825f746be62b9","categoryNumber":"10","categoryHeading1":"Cover Meter Testing ","category":"\u003cp style=\"text-align: right;\"\u003eDetermining the reinforcing depth in an existing concrete structure with the use of a rebar detector.\u003c/p\u003e","categoryImage":"[{\"key\":\"7ce43ee2-1aed-4f94-aca2-4b2a66e6f05c\",\"mediaKey\":\"d5d68957-2d69-4b9e-b61c-c389e568620b\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/d5d4a4b7275b44a9863e392a223ce743","categoryNumber":"11","categoryHeading1":"Rebound Hammer ","category":"\u003cp style=\"text-align: right;\"\u003eThis device measures the elastic properties or strength of concrete or rock, mainly surface hardness and penetration resistance.\u003c/p\u003e","categoryImage":"[{\"key\":\"da3ee913-2362-4509-bba6-485943011c07\",\"mediaKey\":\"0a4fc097-7695-4b29-8545-28fc4b8770ea\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/642007fa56ac47bab908bca8ef2240cb","categoryNumber":"12","categoryHeading1":"Burnt Clay Masonry Units","category":"\u003cp style=\"text-align: right;\"\u003eA series of tests for product acceptance, including but not limited to dimensions, compressive strength, efflorescence and water absorptions.\u003c/p\u003e","categoryImage":"[{\"key\":\"1782f9d0-8a6b-45f1-8b79-374b2a32deca\",\"mediaKey\":\"adcd4551-6477-46c6-8bd4-fa19131c3dc4\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/bea2ad82a4e24bb5b9e8f80ab040dbed","categoryNumber":"13","categoryHeading1":"Carbonation Testing ","category":"\u003cp style=\"text-align: right;\"\u003eBy extracting a core sample and treating it with a solution we can determine the exact carbonation depth on a structure.\u003c/p\u003e","categoryImage":"[{\"key\":\"e82b76b7-0ff6-4ab3-9e70-9f0057f48faa\",\"mediaKey\":\"6d880fa2-ffe6-450a-90fd-1b0c64a9d228\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/0a7b24fe0b274ffa8a828c8b51791992","categoryNumber":"14","categoryHeading1":"Cement Paving Units","category":"\u003cp style=\"text-align: right;\"\u003eA series of tests for shape, appearance, color, dimensions, tensile splitting, abrasion resistance and water absorption.\u003c/p\u003e","categoryImage":"[{\"key\":\"0d3f9d39-453d-417e-8abb-61623d092d4b\",\"mediaKey\":\"803ad692-64ec-4529-8cc1-44ce300f7321\"}]"}],"settingsData":[]}
