<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="Views\Partials\_RenderCTA.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms" Version="13.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="68.2.0.9" />
    <PackageReference Include="Umbraco.Cms.Core" Version="13.2.2" />
    <PackageReference Include="uSync" Version="13.1.3" />
    <PackageReference Include="uSync.Complete" Version="13.1.3" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="68.2.0.9" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Uploads\" />
    <Folder Include="NewFolder\" />
    <Folder Include="Views\MacroPartials\" />
    <Folder Include="Views\Shared\displaytemplates\" />
    <Folder Include="wwwroot\images\banner\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Views\Partials\grid\editors\base.cshtml" />
    <None Include="Views\Partials\grid\editors\embed.cshtml" />
    <None Include="Views\Partials\grid\editors\macro.cshtml" />
    <None Include="Views\Partials\grid\editors\media.cshtml" />
    <None Include="Views\Partials\grid\editors\rte.cshtml" />
    <None Include="Views\Partials\grid\editors\textstring.cshtml" />
    <None Include="Views\Partials\_RenderCTA.cshtml" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Remove RazorCompileOnBuild and RazorCompileOnPublish when not using ModelsMode InMemoryAuto -->
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <UpToDateCheckInput Remove="Views\Partials\BlockList\Components\DetailsBlock.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="Views\Partials\BlockList\Components\DetailsBlock.cshtml" />
    <_ContentIncludedByDefault Remove="Views\Partials\BlockList\Components\ServiceBlock.cshtml" />
    <_ContentIncludedByDefault Remove="Views\Partials\BlockList\Components\ServicesBlockListBlock.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Remove="Views\Partials\BlockList\Components\ServiceBlock.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Remove="Views\Partials\BlockList\Components\ServicesBlockListBlock.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\Html\.vscode\launch.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interon.Roadlab.Web.Net.Core\Interon.Roadlab.Web.Net.Core.csproj" />
  </ItemGroup>

</Project>
