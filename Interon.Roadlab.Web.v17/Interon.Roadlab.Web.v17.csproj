<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <Content Remove="Views\Partials\_RenderCTA.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic.SDK" Version="5.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="10.0.8" />
    <PackageReference Include="Our.Umbraco.FullTextSearch" Version="17.0.1" />
    <PackageReference Include="Umbraco.Cms" Version="17.4.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Opt-in to app-local ICU to ensure consistent globalization APIs across different platforms -->
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageReference Include="Umbraco.Cms.Core" Version="17.4.1" />
    <PackageReference Include="uSync" Version="17.3.2" />
    <PackageReference Include="uSync.Complete" Version="17.3.6" />
    <RuntimeHostConfigurationOption Include="System.Globalization.AppLocalIcu" Value="72.1.0.3" Condition="$(RuntimeIdentifier.StartsWith('linux')) or $(RuntimeIdentifier.StartsWith('win')) or ('$(RuntimeIdentifier)' == '' and !$([MSBuild]::IsOSPlatform('osx')))" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Uploads\" />
    <Folder Include="NewFolder\" />
    <Folder Include="Views\MacroPartials\" />
    <Folder Include="Views\Shared\displaytemplates\" />
    <Folder Include="wwwroot\images\banner\" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Razor files are needed for the backoffice to work correctly -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <UpToDateCheckInput Remove="Views\Partials\BlockList\Components\DetailsBlock.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="Views\Partials\BlockList\Components\DetailsBlock.cshtml" />
    <_ContentIncludedByDefault Remove="Views\Partials\BlockList\Components\ServiceBlock.cshtml" />
    <_ContentIncludedByDefault Remove="Views\Partials\BlockList\Components\ServicesBlockListBlock.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Remove="Views\Partials\BlockList\Components\ServiceBlock.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Remove="Views\Partials\BlockList\Components\ServicesBlockListBlock.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Interon.Roadlab.Web.Net.Core\Interon.Roadlab.Web.Net.Core.csproj" />
  </ItemGroup>

</Project>
