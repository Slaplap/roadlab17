    <heroContent>
      <Value><![CDATA[<p style="text-align: left;">We are ready to provide you advice or a quote.<strong><br />Send us an enquiry <a href="/head-office/#reachout" title="Head Office" data-anchor="#reachout">here</a><span> or call 066 299 1985.</span><br /></strong></p>
