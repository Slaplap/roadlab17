    <pageTitle>
      <Value><![CDATA[Asphalt & Bitumen Marshall and Bulk Density Flow Tests]]></Value>
    </pageTitle>
    <serviceCategories>
      <Value><![CDATA[[
  {
    "key": "aa0b110a-92d7-479e-8c5c-dc609e572c28",
    "name": "Item 1",
    "ncContentTypeAlias": "products",
    "categoryNumber": "01",
    "categoryHeading1": "Marshall Stability, Flow and Quotient",
    "category": "<p style=\"text-align: right;\">Used to determine the stability and flow of compacted asphalt briquettes with an electronic plotter.</p>",
    "categoryImage": "umb://media/fcb07635b13f4c638367e6c76e0c180a"
  },
  {
    "key": "24914d40-ec78-44f7-88b4-382282f6d1ef",
    "name": "Item 2",
    "ncContentTypeAlias": "products",
    "categoryNumber": "02",
    "categoryHeading1": "Bulk density and void content",
    "category": "<p style=\"text-align: right;\">Known as BRD, this test determines the density of the hot mix asphalt mix after compaction.</p>",
    "categoryImage": "umb://media/c36e12615bba4dd283cad2184c4d0e6b"
  },
  {
    "key": "f4de36e2-42e0-4198-abe8-8f48c455c459",
    "name": "Item 3",
    "ncContentTypeAlias": "products",
    "categoryNumber": "03",
    "categoryHeading1": "Gyratory  Compaction",
    "category": "<p style=\"text-align: right;\">Compaction of asphalt samples to target mixture or void content to determine mixture compatibility and design properties.</p>",
    "categoryImage": "umb://media/53696ec177ed429ca53e718f00a53b9e"
  },
  {
    "key": "5fd76eb0-37e6-4062-b17a-7de4e9460a0f",
    "name": "Item 4",
    "ncContentTypeAlias": "products",
    "categoryNumber": "04",
    "categoryHeading1": "Walking profilometer",
    "category": "<p style=\"text-align: right;\">Evaluate the surface condition of pavement. Measures surface roughness, texture and transition irregularities and surface rutting.</p>",
    "categoryImage": "umb://media/86a93ee1ae944aeb90e7ad8a9eca1856"
  },
  {
    "key": "9baac125-3041-4b0e-bab8-e7c1abc52462",
    "name": "Item 5",
    "ncContentTypeAlias": "products",
    "categoryNumber": "05",
    "categoryHeading1": "Falling Weight Deflectometer (FWD)",
    "category": "<p style=\"text-align: right;\">The most practical system to accurately measuring pavement’s deflection response when subject to a dynamic load.</p>",
    "categoryImage": "umb://media/aa82faa7bef64d5683670110af95461c"
  },
  {
    "key": "bf8438d6-8b49-44ea-bfb7-9d3aa01fb31c",
    "name": "Item 6",
    "ncContentTypeAlias": "products",
    "categoryNumber": "06",
    "categoryHeading1": "International Roughness Index (IRI)",
    "category": "<p style=\"text-align: right;\">Measure surface roughness, texture and rutting to calculate ride comfort, surface friction and noise generation.</p>",
    "categoryImage": "umb://media/e8aa0b2821b2475ba2f2e3da43bda1e5"
  },
  {
    "key": "7c65caba-33bf-4df6-b800-066aac1c304d",
    "name": "Item 7",
    "ncContentTypeAlias": "products",
    "categoryNumber": "07",
    "categoryHeading1": "Model Mobile Load Simulator (MMLS)",
    "category": "<p style=\"text-align: right;\">One of 13 world wide, this allows us to simulate traffic, moisture and temperature effects on a pavement layer, recreating real-life stresses.</p>",
    "categoryImage": "umb://media/2793abdc4ff9493e99f4e172d555567f"
  },
  {
    "key": "9b013406-6346-4e3c-9024-275b46c8a86d",
    "name": "Item 8",
    "ncContentTypeAlias": "products",
    "categoryNumber": "08",
    "categoryHeading1": "Hamburg  Abrasion Testing",
    "category": "<p style=\"text-align: right;\">Samples can be tested to determine their susceptibility to rutting and moisture against different load, temperature and moisture settings.</p>",
    "categoryImage": "umb://media/29dbae5eb11b46d1beabfd1aa979e76d"
  },
  {
    "key": "f9f9b29c-77b6-4581-88a8-e41d95f63427",
    "name": "Item 9",
    "ncContentTypeAlias": "products",
    "categoryNumber": "09",
    "categoryHeading1": "Rolling straight edge",
    "category": "<p style=\"text-align: right;\">Used to determine the rideability of a specific road surface area and measure the transition between where processed sections join.</p>",
    "categoryImage": "umb://media/b882faa0bb2c44dc914bb2b4b9224a71"
  },
  {
    "key": "e9df9bf2-dd4a-48fd-8520-9a02d87da4f0",
    "name": "Item 10",
    "ncContentTypeAlias": "products",
    "categoryNumber": "10",
    "categoryHeading1": "Theoretical Maximum Specific Gravity",
    "category": "<p style=\"text-align: right;\">A hot mix asphalt sample is placed into a pycnometer and a vacuum pump removes all air from the sample to determine the mix density.</p>",
    "categoryImage": "umb://media/8a7321a9886a43e283bebffc2720182b"
  },
  {
    "key": "b51a61dd-52c6-4346-aa2f-8c832e55be0f",
    "name": "Item 11",
    "ncContentTypeAlias": "products",
    "categoryNumber": "11",
    "categoryHeading1": "Soluble binder content and particle size analysis",
    "category": "<p style=\"text-align: right;\">Used to determine the percentage of binder in the hot mix asphalt sample. Sample is washed and processed to ensure no aggregate material is lost.</p>",
    "categoryImage": "umb://media/dc6feae4fb9f429eaddead909f29ff41"
  },
  {
    "key": "282283f6-dc5c-4317-90af-2de16132dad6",
    "name": "Item 12",
    "ncContentTypeAlias": "products",
    "categoryNumber": "12",
    "categoryHeading1": "Bitumen content of asphalt mix",
    "category": "<p style=\"text-align: right;\">Used to determine the percentage of binder in the hot mix asphalt sample. Final weight is compared to the starting weight to determine loss.</p>",
    "categoryImage": "umb://media/0ac43b46396a4cd28c95ec8b897c6bc6"
  },
  {
    "key": "65ac49c7-6d76-43ce-a02f-df6891ebc177",
    "name": "Item 13",
    "ncContentTypeAlias": "products",
    "categoryNumber": "13",
    "categoryHeading1": "Binder content of mixtures",
    "category": "<p style=\"text-align: right;\">Used to accurately determine the net bitumen content of a slurry mixture.</p>",
    "categoryImage": "umb://media/e5dff888245f4dd4a4999f5a07d9c0c6"
  },
  {
    "key": "0e477189-3297-4067-81c4-350fa21b79a1",
    "name": "Item 14",
    "ncContentTypeAlias": "products",
    "categoryNumber": "14",
    "categoryHeading1": "Low- temperature and dynamic viscosity",
    "category": "<p style=\"text-align: right;\">Used to determine the shear-rate and apparent viscosity of bitumen.</p>",
    "categoryImage": "umb://media/60eb71b13ee14305972ea50b525093d4"
  },
  {
    "key": "ddcd8dcb-1e31-451f-a2ab-8a3bf9e90268",
    "name": "Item 15",
    "ncContentTypeAlias": "products",
    "categoryNumber": "15",
    "categoryHeading1": "Rolling thin film oven",
    "category": "<p style=\"text-align: right;\">Simulating the hardening properties of bituminous binders during mixing, transportation and compaction.</p>",
    "categoryImage": "umb://media/9e158bec22a14e82a373ae6624c6feea"
  },
  {
    "key": "a6036bdb-36f5-42ab-9e3d-368fe2f379ce",
    "name": "Item 16",
    "ncContentTypeAlias": "products",
    "categoryNumber": "16",
    "categoryHeading1": "Elastic recovery",
    "category": "<p style=\"text-align: right;\">This test method is used to determine the elastic properties of a polymer modified bituminous binder.</p>",
    "categoryImage": "umb://media/fddee27a996c43c2a48688c83631ae23"
  },
  {
    "key": "f08a9226-8845-416e-9d0c-0339f719b2f7",
    "name": "Item 17",
    "ncContentTypeAlias": "products",
    "categoryNumber": "17",
    "categoryHeading1": "Ball penetration and resilience",
    "category": "<p style=\"text-align: right;\">The penetration of a standard ball into bitumen-rubber measures the relative hardness or consistency of bitumen rubber blends.</p>",
    "categoryImage": "umb://media/815bd70ee0ff46c1b2d47b2d55560e80"
  },
  {
    "key": "bab9aef8-fe9a-41b0-aaa4-33f4c52b067e",
    "name": "Item 18",
    "ncContentTypeAlias": "products",
    "categoryNumber": "18",
    "categoryHeading1": "Compression recovery",
    "category": "<p style=\"text-align: right;\">Measures the rubber crumbs' contribution to a bitumen rubber blend’s ability to return to its original shape after compression.</p>",
    "categoryImage": "umb://media/0ac43b46396a4cd28c95ec8b897c6bc6"
  },
  {
    "key": "fbd73fdc-b338-4e59-b5d7-5a2a8c4d5d23",
    "name": "Item 19",
    "ncContentTypeAlias": "products",
    "categoryNumber": "19",
    "categoryHeading1": "Flow test",
    "category": "<p style=\"text-align: right;\">This test is used to measure the flow properties of bitumen at high temperatures.</p>",
    "categoryImage": "umb://media/97ba3183db2a4aad9436eedf67667930"
  },
  {
    "key": "c9b3571e-2b1f-414c-9f1f-bbd85d1e8319",
    "name": "Item 20",
    "ncContentTypeAlias": "products",
    "categoryNumber": "20",
    "categoryHeading1": "Ball penetration test",
    "category": "<p style=\"text-align: right;\">Used to simulate the embedment of stone chips that occurs during construction and under traffic loading.</p>",
    "categoryImage": "umb://media/23c6843c6ef14d14aab43be4a4819dc3"
  },
  {
    "key": "04dbefa0-506e-4662-8975-3caff612e92f",
    "name": "Item 21",
    "ncContentTypeAlias": "products",
    "categoryNumber": "21",
    "categoryHeading1": "Texture depth measurement",
    "category": "<p style=\"text-align: right;\">This test is used to determine the texture of a road surface, also known as the roughness.</p>",
    "categoryImage": "umb://media/fa6f73aad6d34a5a8b27d34328457126"
  },
  {
    "key": "7e816d51-b342-43eb-8bed-38c048ff6925",
    "name": "Item 22",
    "ncContentTypeAlias": "products",
    "categoryNumber": "22",
    "categoryHeading1": "Marvil test",
    "category": "<p style=\"text-align: right;\">The permeability of a bituminous layer indirectly indicates the material’s susceptibility to the ingress of water.</p>",
    "categoryImage": "umb://media/bebb943d84f0446ba435d18c9f096301"
  },
  {
    "key": "e2601709-4379-4d78-9da8-dbe4b41539ab",
    "name": "Item 23",
    "ncContentTypeAlias": "products",
    "categoryNumber": "23",
    "categoryHeading1": "Certification of a binder distributor",
    "category": "<p style=\"text-align: right;\">Certification of a binder distributor, validation of binder distributor dipstick, power and speed indicator test, pump system performance, and transverse distribution.</p>",
    "categoryImage": "umb://media/4c8ce10fb2b7409f9e3fca563faf4312"
  },
  {
    "key": "a7278d88-75e0-4836-af17-2e642ac6ee68",
    "name": "Item 24",
    "ncContentTypeAlias": "products",
    "categoryNumber": "24",
    "categoryHeading1": "Penetration of bituminous materials",
    "category": "<p style=\"text-align: right;\">Used as a measure of the consistency of bituminous materials. Higher values of penetration indicate softer consistency.</p>",
    "categoryImage": "umb://media/2ed3ef72a9e64304a4a04682f5ecee5e"
  },
  {
    "key": "de10d82d-d67b-4190-b051-4747452cd461",
    "name": "Item 25",
    "ncContentTypeAlias": "products",
    "categoryNumber": "25",
    "categoryHeading1": "Softening point of bitumen",
    "category": "<p style=\"text-align: right;\">Useful in the classification of bitumen as one element in establishing the uniformity of receiving shipments of binder.</p>",
    "categoryImage": "umb://media/5e81ed95fb70424594f70876bd35a0c2"
  },
  {
    "key": "90fd03aa-604f-4107-b818-6b6b9db52af3",
    "name": "Item 26",
    "ncContentTypeAlias": "products",
    "categoryNumber": "26",
    "categoryHeading1": "Water content",
    "category": "<p style=\"text-align: right;\">Measures the water present in the emulsified asphalt as distinguished from either bitumen or petroleum solvent.</p>",
    "categoryImage": "umb://media/88501e4fb491442aab67c3359a0c4835"
  }
]]]></Value>
    </serviceCategories>
