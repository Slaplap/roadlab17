                }
              ],
              "styles": null,
              "config": null
            },
            {
              "grid": "6",
              "controls": [
                {
                  "value": "<p> </p>\n<p><strong>DRONE SURVEYS<br /></strong><em>See more than ever before.</em></p>\n<p>Get accurate topographical maps and 3D models of areas and structures using LIDAR technology. </p>\n<p><em>LiDAR Surveys, Thermal Industrial Inspections, Topographic Surveys, Stockpile Surveys.</em></p>",
                  "editor": {
                    "alias": "rte",
                    "view": "rte"
                  },
                  "styles": null,
                  "config": null
                },
                {
                  "value": "<hr />\n<p> </p>\n<p> </p>",
                  "editor": {
                    "alias": "rte",
                    "view": "rte"
                  },
                  "styles": null,
                  "config": null
                }
              ],
              "styles": null,
