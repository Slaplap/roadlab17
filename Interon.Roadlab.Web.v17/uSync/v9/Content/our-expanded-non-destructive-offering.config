                }
              ],
              "styles": null,
              "config": null
            },
            {
              "grid": "6",
              "controls": [
                {
                  "value": "<p> </p>\n<p><strong>SUB-SURFACE SCANNING<br /></strong><em>Get a detailed look into built structures.</em></p>\n<p>We can reveal reinforcing, pre and post-tension cables and other subsurface elements in concrete.</p>\n<p><em>Ultrasonic Pulse Echo, Ultrasonic Pulse Velocity.</em></p>",
                  "editor": {
                    "alias": "rte",
                    "view": "rte"
                  },
                  "styles": null,
