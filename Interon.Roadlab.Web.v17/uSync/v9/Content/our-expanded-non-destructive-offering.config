          "styles": null,
          "config": null
        },
        {
          "name": "Article Split",
          "id": "24bafe75-dd64-4e93-93c6-21aa83e14585",
          "areas": [
            {
              "grid": "6",
              "controls": [
                {
                  "value": {
                    "focalPoint": {
                      "left": 0.5,
                      "top": 0.5
                    },
                    "id": 2450,
                    "udi": "umb://media/0baa204d358d49f990b485b5508f9e38",
                    "image": "/media/jmqkuc2n/drone-surveys.jpg"
                  },
                  "editor": {
                    "alias": "media",
                    "view": "media"
                  },
                  "styles": null,
