                  },
                  "styles": null,
                  "config": null
                }
              ],
              "styles": null,
              "config": null
            },
            {
              "grid": "6",
              "controls": [
                {
                  "value": "<p> </p>\n<p><strong>PULL OFF AND PULL OUT TESTING<br /></strong><em>Affordable, convenient and definitive.</em></p>\n<p>We offer these two critical tests for assessing the quality of installation at affordable rates across SA.</p>\n<p><em>Pull off testing of screed, epoxy and coatings,<br />Pull out testing of chemical anchors and fixings.</em></p>",
                  "editor": {
                    "alias": "rte",
                    "view": "rte"
                  },
                  "styles": null,
                  "config": null
                },
                {
                  "value": "<hr />\n<p> </p>\n<p> </p>",
                  "editor": {
                    "alias": "rte",
                    "view": "rte"
                  },
                  "styles": null,
                  "config": null
                }
              ],
              "styles": null,
              "config": null
            }
          ],
          "styles": null,
          "config": null
        },
        {
          "name": "Article Split",
          "id": "c72d99d7-6baf-4785-9d96-36ace0f784b9",
          "areas": [
            {
              "grid": "6",
              "controls": [
                {
                  "value": {
                    "focalPoint": {
                      "left": 0.5,
                      "top": 0.5
                    },
                    "id": 1874,
                    "udi": "umb://media/938e9a63393a40bb97b263bf23a30a32",
                    "image": "/media/mwni3ez0/gif-5.gif"
                  },
                  "editor": {
                    "alias": "media",
                    "view": "media"
                  },
                  "styles": null,
                  "config": null
                }
              ],
              "styles": null,
              "config": null
            },
            {
              "grid": "6",
              "controls": [
                {
                  "value": "<p> </p>\n<p><strong>REBAR MAPPING <br /></strong><em>Work with confidence.</em></p>\n<p>Using augmented reality we can reveal rebar and other subsurface elements in concrete floors, walls and more.</p>\n<p><em>Ultrasonic Pulse Echo, Ultrasonic Pulse Velocity.</em></p>",
                  "editor": {
                    "alias": "rte",
                    "view": "rte"
                  },
                  "styles": null,
                  "config": null
                },
                {
                  "value": "<hr />\n<p> </p>\n<p> </p>",
                  "editor": {
                    "alias": "rte",
                    "view": "rte"
                  },
                  "styles": null,
                  "config": null
                }
              ],
              "styles": null,
              "config": null
            }
