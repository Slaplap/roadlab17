        },
        {
          "name": "Article Split",
          "id": "0b865414-d752-4bae-ac99-4e0c454254d0",
          "areas": [
            {
              "grid": "6",
              "controls": [
                {
                  "value": {
                    "focalPoint": {
                      "left": 0.5,
                      "top": 0.5
                    },
                    "id": 2457,
                    "udi": "umb://media/a8a164839eee4266a470ab9f178d6d24",
                    "image": "/media/qvskdkho/upe.png"
                  },
                  "editor": {
