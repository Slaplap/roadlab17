              ],
              "styles": null,
              "config": null
            },
            {
              "grid": "6",
              "controls": [
                {
                  "value": "<p> </p>\n<p><strong>ASSESSMENTS OF STRUCTURES<br /></strong><em>Get deep insight into your structures.</em></p>\n<p>We can reveal and assess cracks, voids and other integrity issues in large structures comprising a range of materials.<br /><br /><em>GS8000, GP8000 Ground Penetrating Radar.</em></p>",
                  "editor": {
                    "alias": "rte",
                    "view": "rte"
                  },
                  "styles": null,
                  "config": null
                },
                {
                  "value": "<hr />\n<p> </p>\n<p> </p>",
                  "editor": {
                    "alias": "rte",
                    "view": "rte"
                  },
                  "styles": null,
                  "config": null
                }
              ],
              "styles": null,
              "config": null
            }
          ],
          "styles": null,
          "config": null
        },
        {
          "name": "Article Split",
          "id": "ae0722d0-6237-43a7-9851-7d517695511d",
          "areas": [
            {
              "grid": "6",
              "controls": [
                {
                  "value": {
                    "focalPoint": {
                      "left": 0.5,
                      "top": 0.5
                    },
                    "id": 2455,
                    "udi": "umb://media/c18884caaa6042d1924323c0cfa5dc0c",
                    "image": "/media/zscirqla/img-95c296bf.jpg"
                  },
                  "editor": {
