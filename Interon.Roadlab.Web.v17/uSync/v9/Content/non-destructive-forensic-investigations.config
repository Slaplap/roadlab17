    "ncContentTypeAlias": "products",
    "categoryNumber": "02",
    "categoryHeading1": "Ground Penetrating Radar (GPR)",
    "category": "<p style=\"text-align: right;\">A non-destructive surface penetrating system that measures slab thickness and maps reinforcement, post and pre-tension cables, live wires, service lines, pipes and drains.</p>",
