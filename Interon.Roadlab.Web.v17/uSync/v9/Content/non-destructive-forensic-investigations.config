    "categoryHeading1": "Ultrasonic Pulse Velocity and Echo ",
    "category": "<p style=\"text-align: right;\"><span>Locate sub-surface targets in concrete to assess strength, durability, slab thickness and the severity of honey combing and delaminations.</span></p>",
    "categoryImage": "umb://media/4e3365a700bf41268ca909b7d93e20a9"
  },
