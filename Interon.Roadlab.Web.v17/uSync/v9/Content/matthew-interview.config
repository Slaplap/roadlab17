        {
          "name": "Article Full",
          "id": "5437bd66-e645-4f1e-891a-0c95dfa2a2de",
          "areas": [
            {
              "grid": "12",
              "controls": [
                {
                  "value": "<p>On 11 May 2022 our N2 Nqadu site laboratory received its ISO/IEC 17025 accreditation.</p>\n<p>We spoke to Senior Site Laboratory Manager Mr. Lethabo P Chuene about this fantastic achievement.<br /><br /></p>",
                  "editor": {
                    "alias": "rte",
                    "view": null
                  },
                  "styles": null,
                  "config": null
                }
              ],
              "styles": null,
              "config": null
            }
          ],
          "styles": null,
          "config": null
        },
        {
          "name": "Article Split",
          "id": "1edefde1-a6bc-4b12-8550-1e4d731535f8",
          "areas": [
            {
              "grid": "6",
              "controls": [
                {
                  "value": {
                    "focalPoint": {
                      "left": 0.5,
                      "top": 0.5
                    },
                    "id": 2210,
                    "udi": "umb://media/c044acc4895344e493bb2b39e6458f50",
                    "image": "/media/ykwejqct/matthew-edited-min.png"
                  },
                  "editor": {
                    "alias": "media",
                    "view": null
                  },
                  "styles": null,
                  "config": null
                },
                {
                  "value": {
                    "focalPoint": {
                      "left": 0.5,
                      "top": 0.5
                    },
                    "id": 2201,
                    "udi": "umb://media/f277dee0d09a4dba880a75515306dc59",
                    "image": "/media/21php2u0/otms-13.jpg"
                  },
                  "editor": {
                    "alias": "media",
