      <Value>
{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/ad4f33ab6e754468a49d3d3671754f28"},{"contentUdi":"umb://element/93f7c7dc539c4c6f9c8d65b227e056c4"}]},"contentData":[{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/ad4f33ab6e754468a49d3d3671754f28","stringItemText":"Concrete Testing and Investigations"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/93f7c7dc539c4c6f9c8d65b227e056c4","stringItemText":"Soil Testing and Investigations"}],"settingsData":[]}
