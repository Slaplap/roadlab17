    {
      "contentTypeKey": "3ef5c851-77d2-46af-9a22-e2bfadd01829",
      "key": "247f2c2a-b976-42c2-851d-213f466b7a60",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Dolomite Stability Investigations"
        },
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EIn addition to standard onsite investigations and laboratory testing, we offer specialised geotechnical tests tailored to specific ground conditions that may present unique challenges.\u003Cbr\u003E\u003Cbr\u003EThese tests ensure comprehensive risk assessment and mitigation strategies for complex projects.\u003C/p\u003E\n\u003Cp\u003EDolomitic Stability Investigations, in areas with dolomitic rock formations, reduce the risk of sinkholes\u0026nbsp;and subsidence which poses a serious threat to infrastructure, allowing for appropriate mitigation\u003Cbr\u003Emeasures to protect structures and prevent ground collapse.\u003Cbr\u003E\u003Cbr\u003EOther testing in this field includes gravity surveys, XRDs and MASWs.\u003C/p\u003E"
          }
        },
        {
          "alias": "images",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
