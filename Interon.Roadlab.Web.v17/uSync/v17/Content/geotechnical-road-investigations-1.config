    {
      "contentTypeKey": "3ef5c851-77d2-46af-9a22-e2bfadd01829",
      "key": "ec5316de-3a4c-4394-ab2c-beb8b8c55c18",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Borrowpit Investigations"
        },
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EBorrowpit investigations are crucial for identifying and evaluating soil resources that can be used in construction.\u0026nbsp;\u003C/p\u003E\n\u003Cp\u003ETLB/Excavator Test Pits are dug to expose soil layers for direct sampling and examination.\u0026nbsp;\u003C/p\u003E\n\u003Cp\u003ETo accurately determine the suitability of borrowpit material for construction, proper representative sampling is essential. Samples are then sent to the laboratory for assessment.\u0026nbsp;\u003C/p\u003E\n\u003Cp\u003EMDD (Maximum Dry Density, known as a MOD) testing establishes the maximum unit weight a soil sample can achieve at its optimum moisture content.\u003C/p\u003E\n\u003Cp\u003EThe Road Indicator test evaluates the soil\u2019s performance as a road material, including its susceptibility to shrinkage and swelling as well as providing a grading envelope for the material/\u003Cbr\u003E\u003Cbr\u003ECBR (California Bearing Ratio) are common tests used to evaluate subgrade strength, primarily of roads, pavements and foundations.\u003C/p\u003E\n\u003Cp\u003EUCS (Unconfined Compressive Strength) testing on stabilised materials determines the maximum compressive stress that soil can bear while Indirect Tensile Strength (ITS) determines soil\u2019s strength and adherence against fatigue, temperature cracking and rutting.\u003C/p\u003E\n\u003Cp\u003EA Borrowpit Utilisation Plan outlines how the resources from the borrowpit will be extracted and used efficiently while minimizing environmental impact.\u003C/p\u003E"
          }
        },
        {
          "alias": "images",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        },
        {
          "alias": "anchorID",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "02"
        }
      ]
    },
