    <blogHeading>
      <Value><![CDATA[Leading Quality Assurance in the Eastern Cape]]></Value>
    </blogHeading>
    <branchSelector>
      <Value><![CDATA[umb://document/890e23e62aff4881963512b8cb5683cf]]></Value>
    </branchSelector>
