    <heroContent>
      <Value><![CDATA[{
  "markup": "<div class=\"hero__container--content\">\n<p style=\"text-align: left;\"><strong>Leading material investigations for over 50 years.</strong></p>\n<p style=\"text-align: left;\">Roadlab evaluates construction material through on-site and laboratory testing, ensuring the success of incredible facilities and awe-inspiring projects.</p>\n<p style=\"text-align: left;\">We provide excellent service at the cutting-edge of civil engineering, focusing on all practical aspects of earthworks, soils, aggregates, concrete, asphalt and roadworks.</p>\n</div>",
  "blocks": {
    "contentData": [],
    "settingsData": []
  }
}]]></Value>
