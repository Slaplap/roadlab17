{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/f3e2e96ea02549679632f5c84236f077"},{"contentUdi":"umb://element/9ed6fa6af3074a04ae58ce1efe6e8284"},{"contentUdi":"umb://element/829b9069c4ad44b2a5246ee9d558f9a3"}]},"contentData":[{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/f3e2e96ea02549679632f5c84236f077","stringItemText":"Geotechnical Investigations"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/9ed6fa6af3074a04ae58ce1efe6e8284","stringItemText":"Concrete Testing"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/829b9069c4ad44b2a5246ee9d558f9a3","stringItemText":"Soil Testing"}],"settingsData":[]}
