{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/d4cf7b07615d4be5afa0a1376da680fc"},{"contentUdi":"umb://element/0ec93fdb7a1742fc8131c29295af593e"},{"contentUdi":"umb://element/6c0755090e7c45ea8fcdee098961a547"}]},"contentData":[{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/d4cf7b07615d4be5afa0a1376da680fc","PropType":null,"stringItemText":"Geotechnical Investigations"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/0ec93fdb7a1742fc8131c29295af593e","PropType":null,"stringItemText":"Concrete Testing and Investigations"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/6c0755090e7c45ea8fcdee098961a547","PropType":null,"stringItemText":"Soil Testing and Investigations"}],"settingsData":[]}
