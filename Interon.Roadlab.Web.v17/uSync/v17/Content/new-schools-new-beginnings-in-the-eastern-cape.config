{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/c88a1c00af804e81b530ca6d9e0b9a05"},{"contentUdi":"umb://element/cc92184fb9d8476f994bdb79d0a6405c"},{"contentUdi":"umb://element/48f6191c6f0043f5aadde76cbc403beb"}]},"contentData":[{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/c88a1c00af804e81b530ca6d9e0b9a05","stringItemText":"Geotechnical Investigations"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/cc92184fb9d8476f994bdb79d0a6405c","stringItemText":"Concrete Testing"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/48f6191c6f0043f5aadde76cbc403beb","stringItemText":"Soil Testing"}],"settingsData":[]}
