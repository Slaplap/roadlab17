    {
      "contentTypeKey": "3ef5c851-77d2-46af-9a22-e2bfadd01829",
      "key": "223b485c-8e06-44e1-bf16-54f063237f49",
      "values": [
        {
          "alias": "title",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "On-Site Investigations"
        },
        {
          "alias": "content",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp\u003EOn-site asphalt testing provides immediate feedback on material quality and construction processes during roadworks.\u003C/p\u003E\n\u003Cp\u003ETests such as extracting and testing core samples from compacted asphalt layers allow engineers to assess whether asphalt mixtures are compacted correctly and meet layer thickness requirements.\u003C/p\u003E\n\u003Cp\u003EAdditional tests like, Marvill permeability, IRI, MMLS \u0026amp; Rolling straight edge help confirm that the asphalt conforms to design and construction specifications, ensuring early detection of potential issues like under-\u003Cbr\u003Ecompaction, incorrect binder content, rutting \u0026amp; rideability.\u003C/p\u003E\n\u003Cp\u003EBy conducting these tests on-site, project\u0026nbsp;teams can make timely adjustments and prevent costly failures or rework.\u0026nbsp;\u003C/p\u003E\n\u003Cp\u003EOn-site testing is essential for maintaining control over quality during all phases of construction.\u003C/p\u003E"
          }
        },
        {
          "alias": "images",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "key": "ad30a7b6-0d5e-414c-80c5-7a8b452937f2",
              "mediaKey": "08c1492b-6183-4146-af7a-5153a18f57a1",
              "mediaTypeAlias": "Image",
              "crops": [],
              "focalPoint": null
            }
          ]
        },
        {
          "alias": "anchorID",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": ""
        }
      ]
    },
