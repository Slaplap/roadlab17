{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/d6f12008ec6a4879a6bdc00ae6d0e278"},{"contentUdi":"umb://element/0ca142ac061843cc8304113325afdb04"},{"contentUdi":"umb://element/e17fc09b662b458b914b292a1bfe0ee9"}]},"contentData":[{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/d6f12008ec6a4879a6bdc00ae6d0e278","stringItemText":"Geotechnical Investigations"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/0ca142ac061843cc8304113325afdb04","stringItemText":"Concrete Testing"},{"contentTypeKey":"338ac17e-85de-40c4-8028-34adf753b3c6","udi":"umb://element/e17fc09b662b458b914b292a1bfe0ee9","stringItemText":"Soil Testing"}],"settingsData":[]}
