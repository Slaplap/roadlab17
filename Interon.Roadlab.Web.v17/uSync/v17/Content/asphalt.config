      <Value>
{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/aa0b110a92d7479e8c5cdc609e572c28"},{"contentUdi":"umb://element/24914d40ec7844f788b4382282f6d1ef"},{"contentUdi":"umb://element/f4de36e242e04198abe88f48c455c459"},{"contentUdi":"umb://element/5fd76eb037e64062b17a7de4e9460a0f"},{"contentUdi":"umb://element/9baac12530414b0ebab8e7c1abc52462"},{"contentUdi":"umb://element/bf8438d68b4944eabfb79d3aa01fb31c"},{"contentUdi":"umb://element/7c65caba33bf4df6b800066aac1c304d"},{"contentUdi":"umb://element/9b01340663464e3c9024275b46c8a86d"},{"contentUdi":"umb://element/f9f9b29c77b6458188a8e41d95f63427"},{"contentUdi":"umb://element/e9df9bf2dd4a48fd85209a02d87da4f0"},{"contentUdi":"umb://element/b51a61dd52c64346aa2f8c832e55be0f"},{"contentUdi":"umb://element/282283f6dc5c431790af2de16132dad6"},{"contentUdi":"umb://element/65ac49c76d7643cea02fdf6891ebc177"},{"contentUdi":"umb://element/0e4771893297406781c4350fa21b79a1"},{"contentUdi":"umb://element/ddcd8dcb1e31451fa2ab8a3bf9e90268"},{"contentUdi":"umb://element/a6036bdb36f542ab9e3d368fe2f379ce"},{"contentUdi":"umb://element/f08a92268845416e9d0c0339f719b2f7"},{"contentUdi":"umb://element/bab9aef8fe9a41b0aaa433f4c52b067e"},{"contentUdi":"umb://element/fbd73fdcb3384e59b5d75a2a8c4d5d23"},{"contentUdi":"umb://element/c9b3571e2b1f414c9f1fbbd85d1e8319"},{"contentUdi":"umb://element/04dbefa0506e466289753caff612e92f"},{"contentUdi":"umb://element/7e816d51b34243eb8bed38c048ff6925"},{"contentUdi":"umb://element/e260170943794d789da8dbe4b41539ab"},{"contentUdi":"umb://element/a7278d8875e04836af172e642ac6ee68"},{"contentUdi":"umb://element/de10d82dd67b4190b0514747452cd461"},{"contentUdi":"umb://element/90fd03aa604f4107b8186b6b9db52af3"}]},"contentData":[{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/aa0b110a92d7479e8c5cdc609e572c28","categoryNumber":"01","categoryHeading1":"Marshall Stability, Flow and Quotient","category":"\u003cp style=\"text-align: right;\"\u003eUsed to determine the stability and flow of compacted asphalt briquettes with an electronic plotter.\u003c/p\u003e","categoryImage":"[{\"key\":\"943ae0c4-27de-42d2-8650-b5d983944aad\",\"mediaKey\":\"fcb07635-b13f-4c63-8367-e6c76e0c180a\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/24914d40ec7844f788b4382282f6d1ef","categoryNumber":"02","categoryHeading1":"Bulk density and void content","category":"\u003cp style=\"text-align: right;\"\u003eKnown as BRD, this test determines the density of the hot mix asphalt mix after compaction.\u003c/p\u003e","categoryImage":"[{\"key\":\"9347af2f-0e48-4bd9-8397-75624344b739\",\"mediaKey\":\"c36e1261-5bba-4dd2-83ca-d2184c4d0e6b\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/f4de36e242e04198abe88f48c455c459","categoryNumber":"03","categoryHeading1":"Gyratory  Compaction","category":"\u003cp style=\"text-align: right;\"\u003eCompaction of asphalt samples to target mixture or void content to determine mixture compatibility and design properties.\u003c/p\u003e","categoryImage":"[{\"key\":\"d40d5c02-47d5-4556-a5c5-ed118512e945\",\"mediaKey\":\"53696ec1-77ed-429c-a53e-718f00a53b9e\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/5fd76eb037e64062b17a7de4e9460a0f","categoryNumber":"04","categoryHeading1":"Walking profilometer","category":"\u003cp style=\"text-align: right;\"\u003eEvaluate the surface condition of pavement. Measures surface roughness, texture and transition irregularities and surface rutting.\u003c/p\u003e","categoryImage":"[{\"key\":\"858db135-071e-4b09-b6b5-c51ec6da59e3\",\"mediaKey\":\"86a93ee1-ae94-4aeb-90e7-ad8a9eca1856\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/9baac12530414b0ebab8e7c1abc52462","categoryNumber":"05","categoryHeading1":"Falling Weight Deflectometer (FWD)","category":"\u003cp style=\"text-align: right;\"\u003eThe most practical system to accurately measuring pavement’s deflection response when subject to a dynamic load.\u003c/p\u003e","categoryImage":"[{\"key\":\"5960026b-8d95-4850-9846-02033c7b2867\",\"mediaKey\":\"aa82faa7-bef6-4d56-8367-0110af95461c\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/bf8438d68b4944eabfb79d3aa01fb31c","categoryNumber":"06","categoryHeading1":"International Roughness Index (IRI)","category":"\u003cp style=\"text-align: right;\"\u003eMeasure surface roughness, texture and rutting to calculate ride comfort, surface friction and noise generation.\u003c/p\u003e","categoryImage":"[{\"key\":\"8e5aa652-f3c7-4925-9e40-d6c324e4987d\",\"mediaKey\":\"e8aa0b28-21b2-475b-a2f2-e3da43bda1e5\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/7c65caba33bf4df6b800066aac1c304d","categoryNumber":"07","categoryHeading1":"Model Mobile Load Simulator (MMLS)","category":"\u003cp style=\"text-align: right;\"\u003eOne of 13 world wide, this allows us to simulate traffic, moisture and temperature effects on a pavement layer, recreating real-life stresses.\u003c/p\u003e","categoryImage":"[{\"key\":\"caea5ca8-9826-4084-a9ba-3b9f4bc256c7\",\"mediaKey\":\"2793abdc-4ff9-493e-99f4-e172d555567f\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/9b01340663464e3c9024275b46c8a86d","categoryNumber":"08","categoryHeading1":"Hamburg  Abrasion Testing","category":"\u003cp style=\"text-align: right;\"\u003eSamples can be tested to determine their susceptibility to rutting and moisture against different load, temperature and moisture settings.\u003c/p\u003e","categoryImage":"[{\"key\":\"fdee222b-e35a-4101-a36a-fe7fe1b08600\",\"mediaKey\":\"29dbae5e-b11b-46d1-beab-fd1aa979e76d\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/f9f9b29c77b6458188a8e41d95f63427","categoryNumber":"09","categoryHeading1":"Rolling straight edge","category":"\u003cp style=\"text-align: right;\"\u003eUsed to determine the rideability of a specific road surface area and measure the transition between where processed sections join.\u003c/p\u003e","categoryImage":"[{\"key\":\"77b38ea0-0f31-473e-8165-a97c805b94e7\",\"mediaKey\":\"b882faa0-bb2c-44dc-914b-b2b4b9224a71\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/e9df9bf2dd4a48fd85209a02d87da4f0","categoryNumber":"10","categoryHeading1":"Theoretical Maximum Specific Gravity","category":"\u003cp style=\"text-align: right;\"\u003eA hot mix asphalt sample is placed into a pycnometer and a vacuum pump removes all air from the sample to determine the mix density.\u003c/p\u003e","categoryImage":"[{\"key\":\"5cce9715-1636-4c77-8901-2dc1811a7e5f\",\"mediaKey\":\"8a7321a9-886a-43e2-83be-bffc2720182b\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/b51a61dd52c64346aa2f8c832e55be0f","categoryNumber":"11","categoryHeading1":"Soluble binder content and particle size analysis","category":"\u003cp style=\"text-align: right;\"\u003eUsed to determine the percentage of binder in the hot mix asphalt sample. Sample is washed and processed to ensure no aggregate material is lost.\u003c/p\u003e","categoryImage":"[{\"key\":\"eee94017-1ddd-461b-b9dd-3f7f3de8e289\",\"mediaKey\":\"dc6feae4-fb9f-429e-adde-ad909f29ff41\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/282283f6dc5c431790af2de16132dad6","categoryNumber":"12","categoryHeading1":"Bitumen content of asphalt mix","category":"\u003cp style=\"text-align: right;\"\u003eUsed to determine the percentage of binder in the hot mix asphalt sample. Final weight is compared to the starting weight to determine loss.\u003c/p\u003e","categoryImage":"[{\"key\":\"4d7def85-d2b6-433b-8cf4-bf4afa7004ef\",\"mediaKey\":\"0ac43b46-396a-4cd2-8c95-ec8b897c6bc6\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/65ac49c76d7643cea02fdf6891ebc177","categoryNumber":"13","categoryHeading1":"Binder content of mixtures","category":"\u003cp style=\"text-align: right;\"\u003eUsed to accurately determine the net bitumen content of a slurry mixture.\u003c/p\u003e","categoryImage":"[{\"key\":\"678a46c4-3ec2-4cbc-af3a-8ec080d24899\",\"mediaKey\":\"e5dff888-245f-4dd4-a499-9f5a07d9c0c6\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/0e4771893297406781c4350fa21b79a1","categoryNumber":"14","categoryHeading1":"Low- temperature and dynamic viscosity","category":"\u003cp style=\"text-align: right;\"\u003eUsed to determine the shear-rate and apparent viscosity of bitumen.\u003c/p\u003e","categoryImage":"[{\"key\":\"61b3195e-e48c-44bc-aa15-905141823da5\",\"mediaKey\":\"60eb71b1-3ee1-4305-972e-a50b525093d4\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/ddcd8dcb1e31451fa2ab8a3bf9e90268","categoryNumber":"15","categoryHeading1":"Rolling thin film oven","category":"\u003cp style=\"text-align: right;\"\u003eSimulating the hardening properties of bituminous binders during mixing, transportation and compaction.\u003c/p\u003e","categoryImage":"[{\"key\":\"d4d81436-e18e-4a03-9084-e9e85b4d8f7e\",\"mediaKey\":\"9e158bec-22a1-4e82-a373-ae6624c6feea\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/a6036bdb36f542ab9e3d368fe2f379ce","categoryNumber":"16","categoryHeading1":"Elastic recovery","category":"\u003cp style=\"text-align: right;\"\u003eThis test method is used to determine the elastic properties of a polymer modified bituminous binder.\u003c/p\u003e","categoryImage":"[{\"key\":\"2727d788-e48e-4199-af77-50fa1d63704c\",\"mediaKey\":\"fddee27a-996c-43c2-a486-88c83631ae23\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/f08a92268845416e9d0c0339f719b2f7","categoryNumber":"17","categoryHeading1":"Ball penetration and resilience","category":"\u003cp style=\"text-align: right;\"\u003eThe penetration of a standard ball into bitumen-rubber measures the relative hardness or consistency of bitumen rubber blends.\u003c/p\u003e","categoryImage":"[{\"key\":\"1593e3e3-f45d-462f-ba36-842a9f1027fa\",\"mediaKey\":\"815bd70e-e0ff-46c1-b2d4-7b2d55560e80\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/bab9aef8fe9a41b0aaa433f4c52b067e","categoryNumber":"18","categoryHeading1":"Compression recovery","category":"\u003cp style=\"text-align: right;\"\u003eMeasures the rubber crumbs\u0027 contribution to a bitumen rubber blend’s ability to return to its original shape after compression.\u003c/p\u003e","categoryImage":"[{\"key\":\"824b63d8-49a5-4b0a-ab7d-9263bdb25970\",\"mediaKey\":\"0ac43b46-396a-4cd2-8c95-ec8b897c6bc6\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/fbd73fdcb3384e59b5d75a2a8c4d5d23","categoryNumber":"19","categoryHeading1":"Flow test","category":"\u003cp style=\"text-align: right;\"\u003eThis test is used to measure the flow properties of bitumen at high temperatures.\u003c/p\u003e","categoryImage":"[{\"key\":\"b89b60db-60e1-4787-8d38-8876d1920ef0\",\"mediaKey\":\"97ba3183-db2a-4aad-9436-eedf67667930\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/c9b3571e2b1f414c9f1fbbd85d1e8319","categoryNumber":"20","categoryHeading1":"Ball penetration test","category":"\u003cp style=\"text-align: right;\"\u003eUsed to simulate the embedment of stone chips that occurs during construction and under traffic loading.\u003c/p\u003e","categoryImage":"[{\"key\":\"d85a168f-d42a-4ec3-97d6-cd1fdd83dd31\",\"mediaKey\":\"23c6843c-6ef1-4d14-aab4-3be4a4819dc3\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/04dbefa0506e466289753caff612e92f","categoryNumber":"21","categoryHeading1":"Texture depth measurement","category":"\u003cp style=\"text-align: right;\"\u003eThis test is used to determine the texture of a road surface, also known as the roughness.\u003c/p\u003e","categoryImage":"[{\"key\":\"068016e5-3471-4e86-8f24-46277029246b\",\"mediaKey\":\"fa6f73aa-d6d3-4a5a-8b27-d34328457126\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/7e816d51b34243eb8bed38c048ff6925","categoryNumber":"22","categoryHeading1":"Marvil test","category":"\u003cp style=\"text-align: right;\"\u003eThe permeability of a bituminous layer indirectly indicates the material’s susceptibility to the ingress of water.\u003c/p\u003e","categoryImage":"[{\"key\":\"e6385c2b-a0ee-4ea7-b5b0-e14f5f394283\",\"mediaKey\":\"bebb943d-84f0-446b-a435-d18c9f096301\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/e260170943794d789da8dbe4b41539ab","categoryNumber":"23","categoryHeading1":"Certification of a binder distributor","category":"\u003cp style=\"text-align: right;\"\u003eCertification of a binder distributor, validation of binder distributor dipstick, power and speed indicator test, pump system performance, and transverse distribution.\u003c/p\u003e","categoryImage":"[{\"key\":\"ffe52054-bbe2-4d97-8144-99bbefe7eb09\",\"mediaKey\":\"4c8ce10f-b2b7-409f-9e3f-ca563faf4312\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/a7278d8875e04836af172e642ac6ee68","categoryNumber":"24","categoryHeading1":"Penetration of bituminous materials","category":"\u003cp style=\"text-align: right;\"\u003eUsed as a measure of the consistency of bituminous materials. Higher values of penetration indicate softer consistency.\u003c/p\u003e","categoryImage":"[{\"key\":\"b7929aab-b22a-41e9-bdde-541b83c352a5\",\"mediaKey\":\"2ed3ef72-a9e6-4304-a4a0-4682f5ecee5e\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/de10d82dd67b4190b0514747452cd461","categoryNumber":"25","categoryHeading1":"Softening point of bitumen","category":"\u003cp style=\"text-align: right;\"\u003eUseful in the classification of bitumen as one element in establishing the uniformity of receiving shipments of binder.\u003c/p\u003e","categoryImage":"[{\"key\":\"dffd7336-3c22-4e1e-9cc0-12e6ded9ad0f\",\"mediaKey\":\"5e81ed95-fb70-4245-94f7-0876bd35a0c2\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/90fd03aa604f4107b8186b6b9db52af3","categoryNumber":"26","categoryHeading1":"Water content","category":"\u003cp style=\"text-align: right;\"\u003eMeasures the water present in the emulsified asphalt as distinguished from either bitumen or petroleum solvent.\u003c/p\u003e","categoryImage":"[{\"key\":\"967cc96f-753a-48c3-9f86-38d0dd37bc99\",\"mediaKey\":\"88501e4f-b491-442a-ab67-c3359a0c4835\"}]"}],"settingsData":[]}
</Value>
