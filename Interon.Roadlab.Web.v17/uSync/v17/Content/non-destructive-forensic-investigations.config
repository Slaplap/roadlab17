    <heroContent>
      <Value><![CDATA[{
  "markup": "<p style=\"text-align: left;\">We are ready to provide you with advice or a quote.<br><strong>Send us an enquiry&nbsp;<a href=\"/head-office/#reachout\" title=\"Head Office\" data-anchor=\"#reachout\">here</a></strong><span>&nbsp;or call&nbsp;</span><strong>066 299 1985.</strong></p>\n<p style=\"text-align: left;\">These technologies allow us to conduct integrity and durability testing and produce detailed 3D interpretations of concrete structures without sampling or destruction.&nbsp;</p>",
