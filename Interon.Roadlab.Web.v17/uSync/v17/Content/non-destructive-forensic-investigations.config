{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/1fb31052637c4fbeb14d67cb41edbd3f"},{"contentUdi":"umb://element/43311b888c8048088368f3e842a8f6fe"},{"contentUdi":"umb://element/38863bc3cbf14f40bfad5e181a66707c"},{"contentUdi":"umb://element/68a1d5fc80054353a04edc724b7ffc3e"},{"contentUdi":"umb://element/a46fdd5a219c41d581de23a628ad0fe9"},{"contentUdi":"umb://element/8926295856e54c33b5ef797b9c85d5f1"},{"contentUdi":"umb://element/ded5dbf20300452788d5b4f42189f6ed"},{"contentUdi":"umb://element/33a655842ad846329ace2089d65d9e69"},{"contentUdi":"umb://element/4016078d773f4398a2b0d1484945f201"},{"contentUdi":"umb://element/ffb0e64843e54135b689be57bcf4fbe8"},{"contentUdi":"umb://element/44c11a34c30d4542b226552f048167ac"},{"contentUdi":"umb://element/5a69dde1d4134612be6a502da70d99c6"}]},"contentData":[{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/1fb31052637c4fbeb14d67cb41edbd3f","PropType":null,"categoryNumber":"01","categoryHeading1":"Subsurface Utility Scanning","category":"{\"markup\":\"\u003cp style=\\\"text-align: right;\\\"\u003eDetailed outdoor mapping of earthworks, sites, parks and public areas up to 10m, showing drain pipes, electrical lines, fibre lines and more.\u003c/p\u003e\",\"blocks\":{\"contentData\":[],\"settingsData\":[]}}","categoryImage":"[{\"key\":\"9ebb9ea6-e403-4bcd-b211-9bafde9eec79\",\"mediaKey\":\"518cb6e3-31df-4e87-8719-25a1dde811b8\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/43311b888c8048088368f3e842a8f6fe","PropType":null,"categoryNumber":"02","categoryHeading1":"Ground Penetrating Radar (GPR)","category":"{\"markup\":\"\u003cp style=\\\"text-align: right;\\\"\u003eA non-destructive surface penetrating system that measures slab thickness and maps reinforcement, post and pre-tension cables, live wires, service lines, pipes and drains.\u003c/p\u003e\",\"blocks\":{\"contentData\":[],\"settingsData\":[]}}","categoryImage":"[{\"key\":\"748956a9-1b6e-45d3-b078-187cc2227fae\",\"mediaKey\":\"e029e565-bf83-474b-a34e-72496124dfff\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/38863bc3cbf14f40bfad5e181a66707c","PropType":null,"categoryNumber":"03","categoryHeading1":"Ultrasonic Pulse Velocity and Echo ","category":"{\"markup\":\"\u003cp style=\\\"text-align: right;\\\"\u003e\u003cspan\u003eLocate sub-surface targets in concrete to assess strength, durability, slab thickness and the severity of honey combing and delaminations.\u003c/span\u003e\u003c/p\u003e\",\"blocks\":{\"contentData\":[],\"settingsData\":[]}}","categoryImage":"[{\"key\":\"0da81b81-3118-40f1-bd5d-a76c2db6a319\",\"mediaKey\":\"4e3365a7-00bf-4126-8ca9-09b7d93e20a9\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/68a1d5fc80054353a04edc724b7ffc3e","PropType":null,"categoryNumber":"04","categoryHeading1":"Half Cell Potential (Reinforcement Corrosion)","category":"{\"markup\":\"\u003cp style=\\\"text-align: right;\\\"\u003eThis determines the extent of the corrosion of reinforcement within a concrete structure.\u003c/p\u003e\",\"blocks\":{\"contentData\":[],\"settingsData\":[]}}","categoryImage":"[{\"key\":\"fbfbda44-849f-42a8-87ed-f75c81b1ea1c\",\"mediaKey\":\"0d21c2fd-2a24-4aa2-82c8-dfc1ff54f63a\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/a46fdd5a219c41d581de23a628ad0fe9","PropType":null,"categoryNumber":"05","categoryHeading1":"Pull-off Testing Screed, Epoxy and Coatings","category":"{\"markup\":\"\u003cp style=\\\"text-align: right;\\\"\u003e\u003cspan\u003eEvaluate the pull-off\u003c/span\u003e\u003cspan\u003e strength (adhesion) of a \u003c/span\u003ecoating \u003cspan\u003efrom a rigid substrate such as a concrete or metal floor.\u003c/span\u003e\u003c/p\u003e\",\"blocks\":{\"contentData\":[],\"settingsData\":[]}}","categoryImage":"[{\"key\":\"afa8d226-d9b4-49e3-aba3-7d3f5b9729f3\",\"mediaKey\":\"ebf31ad4-88f5-4e1f-99dd-488207ed205f\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/8926295856e54c33b5ef797b9c85d5f1","PropType":null,"categoryNumber":"06","categoryHeading1":"Pull-out Testing Chemical Anchors, Fixings","category":"{\"markup\":\"\u003cp style=\\\"text-align: right;\\\"\u003eA test rig is attached to a bolt, screw, anchor or fixing and put under tension to the designed stress load level to determine how strong and secure the fixing is.\u003c/p\u003e\",\"blocks\":{\"contentData\":[],\"settingsData\":[]}}","categoryImage":"[{\"key\":\"42f5196e-8aeb-4478-b4cb-07d830afa87d\",\"mediaKey\":\"ebf31ad4-88f5-4e1f-99dd-488207ed205f\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/ded5dbf20300452788d5b4f42189f6ed","PropType":null,"categoryNumber":"07","categoryHeading1":"Cover Surveys","category":"{\"markup\":\"\u003cp style=\\\"text-align: right;\\\"\u003eDetermining the reinforcing depth in an existing concrete structure with the use of an ferromagnetic meter.\u003c/p\u003e\",\"blocks\":{\"contentData\":[],\"settingsData\":[]}}","categoryImage":"[{\"key\":\"12ffe457-0a54-48ea-81c2-85b13ad4527a\",\"mediaKey\":\"7e183e74-d84a-4c16-81fb-83db4ce29cc2\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/33a655842ad846329ace2089d65d9e69","PropType":null,"categoryNumber":"08","categoryHeading1":"Reinforcement Diameter","category":"{\"markup\":\"\u003cp style=\\\"text-align: right;\\\"\u003eUsed to determine the exact diameter of\u003cspan\u003e \u003c/span\u003ereinforcement\u003cspan\u003e bars in concrete through the use of an elcometer.\u003c/span\u003e\u003c/p\u003e\",\"blocks\":{\"contentData\":[],\"settingsData\":[]}}","categoryImage":"[{\"key\":\"ba566df1-5f6a-4edc-bea1-a4042036de30\",\"mediaKey\":\"f8e341df-0ca0-4092-8892-bc5bab21d955\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/4016078d773f4398a2b0d1484945f201","PropType":null,"categoryNumber":"09","categoryHeading1":"Crack Width Measurement","category":"{\"markup\":\"\u003cp style=\\\"text-align: right;\\\"\u003eA test to investigate crack width on a variety of concrete structures using photographic recording with a micron.\u003c/p\u003e\",\"blocks\":{\"contentData\":[],\"settingsData\":[]}}","categoryImage":"[{\"key\":\"c4892a12-6ca8-4de5-99cb-2f147495fc4f\",\"mediaKey\":\"e20fd794-38e1-4bde-bda3-ad27032cb970\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/ffb0e64843e54135b689be57bcf4fbe8","PropType":null,"categoryNumber":"10","categoryHeading1":"Rebound (Schmidt) Hammer","category":"{\"markup\":\"\u003cp style=\\\"text-align: right;\\\"\u003eThis device measures the elastic properties or strength of concrete or rock, mainly surface hardness and penetration resistance.\u003c/p\u003e\",\"blocks\":{\"contentData\":[],\"settingsData\":[]}}","categoryImage":"[{\"key\":\"27ea8d37-2b08-4cdb-8206-2ef13f265e47\",\"mediaKey\":\"0a4fc097-7695-4b29-8545-28fc4b8770ea\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/44c11a34c30d4542b226552f048167ac","PropType":null,"categoryNumber":"11","categoryHeading1":"Heat of Hydration Monitoring","category":"{\"markup\":\"\u003cp style=\\\"text-align: right;\\\"\u003eMonitors the heat flow from concrete while the specimen is under an insulated condition and has no or very little heat loss.\u003c/p\u003e\",\"blocks\":{\"contentData\":[],\"settingsData\":[]}}","categoryImage":"[{\"key\":\"5e91ed0f-c3ba-45f7-a934-81e68f2cd897\",\"mediaKey\":\"8f1bcd5d-84d9-4262-a623-b38ed558939d\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/5a69dde1d4134612be6a502da70d99c6","PropType":null,"categoryNumber":"12","categoryHeading1":"Drone Surveys","category":"{\"markup\":\"\u003cp style=\\\"text-align: right;\\\"\u003eGenerate accurate topographical maps or 3D models of larger / hard to access areas using LIDAR technology.\u003c/p\u003e\",\"blocks\":{\"contentData\":[],\"settingsData\":[]}}","categoryImage":"[{\"key\":\"9abda3c4-da5c-4e7d-a771-e47059470b7e\",\"mediaKey\":\"c2e22e69-05e6-4406-afa5-709eeca42c88\"}]"}],"settingsData":[]}
