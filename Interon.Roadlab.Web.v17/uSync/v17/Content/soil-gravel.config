            ]
          },
          {
            "contentTypeKey": "66725937-203a-4159-a7d9-d57911ea075e",
            "udi": "umb://element/f5b48323e2af4aabaef8458a52d739fc",
            "title": "Soil Assessment",
            "description": "Determining sample characteristics.",
            "image": [
              {
                "key": "36699916-7ea2-495a-b6ef-c5464d299668",
                "mediaKey": "f496b466-821a-418e-bd3d-46c8f1c025c1"
