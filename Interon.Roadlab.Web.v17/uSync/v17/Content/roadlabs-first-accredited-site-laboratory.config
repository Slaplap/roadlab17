    <articleIntersectDescription>
      <Value><![CDATA[For the second time, a site laboratory has been accredited in South Africa. Here's how the N2 Nqadu team made it happen.]]></Value>
    </articleIntersectDescription>
    <articleIntersectImage>
      <Value>[{"key":"8f990e28-bf7a-44a1-9270-f8a57d67a77a","mediaKey":"8f288b1d-3dd5-425c-a671-764e2a160eb8"}]</Value>
    </articleIntersectImage>
    <backImage>
      <Value>[{"key":"746aed6b-f492-4e1f-91d1-13a1ad5267f2","mediaKey":"8f288b1d-3dd5-425c-a671-764e2a160eb8"}]</Value>
    </backImage>
    <blogHeading>
      <Value><![CDATA[Roadlab's First Accredited Site Laboratory]]></Value>
    </blogHeading>
    <branchSelector>
      <Value><![CDATA[umb://document/890e23e62aff4881963512b8cb5683cf]]></Value>
    </branchSelector>
    <categoryPageToggle>
