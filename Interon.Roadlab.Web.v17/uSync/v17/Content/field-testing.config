              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp style=\u0022text-align: right;\u0022\u003EEvaluate the surface condition of pavement. Measures surface roughness, texture and transition irregularities and surface rutting.\u003C/p\u003E"
          }
        },
        {
          "alias": "categoryImage",
          "culture": null,
          "editorAlias": null,
