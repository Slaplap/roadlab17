              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp style=\u0022text-align: right;\u0022\u003EThe permeability of a bituminous layer indirectly indicates the material\u2019s susceptibility to the ingress of water.\u003C/p\u003E"
