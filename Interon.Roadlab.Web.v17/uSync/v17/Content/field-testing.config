      "values": [
        {
          "alias": "categoryNumber",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "16"
        },
        {
          "alias": "categoryHeading1",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Concrete crack width meter/camera"
        },
        {
          "alias": "category",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp style=\u0022text-align: right;\u0022\u003EInvestigate cracks width on concrete structures such as walls, tunnels, bridges etc. with photographic recording - accuracy of 0.01mm.\u003C/p\u003E"
          }
        },
        {
          "alias": "categoryImage",
          "culture": null,
