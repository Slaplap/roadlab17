          "alias": "category",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp style=\u0022text-align: right;\u0022\u003ENon-destructive testing of concrete structures using ground penetrating radar to an effective depth exceeding 700mm.\u003C/p\u003E"
