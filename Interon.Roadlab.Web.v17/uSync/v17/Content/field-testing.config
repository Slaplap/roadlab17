              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp style=\u0022text-align: right;\u0022\u003ECertification of a binder distributor, validation of binder distributor dipstick, power and speed indicator test, pump system performance, and transverse distribution.\u003C/p\u003E"
