{"layout":{"Umbraco.BlockList":[{"contentUdi":"umb://element/a19e9ff6726a4beaafae710098adf739"},{"contentUdi":"umb://element/d7c1104ff2044ca999b30161751f8ac6"},{"contentUdi":"umb://element/83e008cea1b84923ae14583a1bee7f19"},{"contentUdi":"umb://element/fe2834042d8344c3b968eed495dff6d8"},{"contentUdi":"umb://element/e5977799634d4b06b88bf50ed2982005"},{"contentUdi":"umb://element/3ddfe2c3baba4781ab6d2c7fe87cf66f"},{"contentUdi":"umb://element/c8844039ce984caf8d6abf746ef33e35"},{"contentUdi":"umb://element/26e0a9a9d53d449fbc8e5b541b4968e3"},{"contentUdi":"umb://element/8cfa0accbf964c04b8a4b21a0f2565ba"},{"contentUdi":"umb://element/0b6687537b674d16aa99fff060334f2a"},{"contentUdi":"umb://element/8d2561fdc6b9492e963eea28595379f9"}]},"contentData":[{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/a19e9ff6726a4beaafae710098adf739","categoryNumber":"01","categoryHeading1":"Organic Impurities ","category":"\u003cp style=\"text-align: right;\"\u003eThis test is done to determine the short-term retardation and long-term deleterious effects of organic impurities.\u003c/p\u003e","categoryImage":"[{\"key\":\"378f9706-d1d1-4b6b-b2b6-a1372b597810\",\"mediaKey\":\"a974c907-117d-413b-a8ec-2c8493afe65f\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/d7c1104ff2044ca999b30161751f8ac6","categoryNumber":"02","categoryHeading1":"Chloride Content ","category":"\u003cp style=\"text-align: right;\"\u003eSpecifies the determination of the chloride content in aggregates which can have a negative binding effect in some construction applications.\u003c/p\u003e","categoryImage":"[{\"key\":\"963a5e94-d5b7-4f17-a1be-59986cd85d1b\",\"mediaKey\":\"cdef245e-c762-45ea-82bf-f0cc08492957\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/83e008cea1b84923ae14583a1bee7f19","categoryNumber":"03","categoryHeading1":"Water Soluble Salt Content ","category":"\u003cp style=\"text-align: right;\"\u003eThis standard specifies a method for determining the total water-soluble salt content of fine aggregates and of fines in aggregates for base courses.\u003c/p\u003e","categoryImage":"[{\"key\":\"5c4b0768-aad6-412b-adc7-9890e1fa4671\",\"mediaKey\":\"89ec3445-1eaf-4c26-96aa-dbceb622ee9a\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/fe2834042d8344c3b968eed495dff6d8","categoryNumber":"04","categoryHeading1":"Deleterious Clay Content ","category":"\u003cp style=\"text-align: right;\"\u003eThis method determines whether the clay content of the fines of an aggregate contains deleterious swelling or active clay minerals.\u003c/p\u003e","categoryImage":"[{\"key\":\"2004607b-ab2a-4f19-805f-7a5c6747c318\",\"mediaKey\":\"5978f1b0-fd40-4c7f-b1d9-1a1972044feb\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/e5977799634d4b06b88bf50ed2982005","categoryNumber":"05","categoryHeading1":"Initial Stabilizer Content ","category":"\u003cp style=\"text-align: right;\"\u003eDetermines the percentage of stabilizer that will first be absorbed by material to neutralize acidity levels before stabilizing takes effect.\u003c/p\u003e","categoryImage":"[{\"key\":\"f4efa92b-433f-4d92-8968-542ebf965d7f\",\"mediaKey\":\"da4f18c3-08f0-4423-9862-3dc9093a21fd\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/3ddfe2c3baba4781ab6d2c7fe87cf66f","categoryNumber":"06","categoryHeading1":"Moisture in Asphalt","category":"\u003cp style=\"text-align: right;\"\u003eUsed to determine the percentage moisture in a freshly mixed hot mix asphalt (HMA) mix.\u003c/p\u003e","categoryImage":"[{\"key\":\"a97c65bf-3d97-429b-ad4b-42145b47010c\",\"mediaKey\":\"9ce316b4-b462-465c-9547-a7b1c5c3b465\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/c8844039ce984caf8d6abf746ef33e35","categoryNumber":"07","categoryHeading1":"Plasticity index Hydrometer test","category":"\u003cp style=\"text-align: right;\"\u003eTo determine the particle size distribution of materials to detail the silt and clay percentages.\u003c/p\u003e","categoryImage":"[{\"key\":\"c97d4acd-89df-4f1e-8cf6-7d1c889a0836\",\"mediaKey\":\"763bef97-beb8-48e5-b2b3-8778689b9eba\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/26e0a9a9d53d449fbc8e5b541b4968e3","categoryNumber":"08","categoryHeading1":"Rock Durability Using 10% FACT ","category":"\u003cp style=\"text-align: right;\"\u003eUsed to determine the strength of the aggregate sample after it has been exposed to a weathering agent.\u003c/p\u003e","categoryImage":"[{\"key\":\"c46386e3-65f9-49e1-a97c-ff47eb1deca8\",\"mediaKey\":\"06ebb11e-730f-45d2-86c6-575826b78c2d\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/8cfa0accbf964c04b8a4b21a0f2565ba","categoryNumber":"09","categoryHeading1":"Back-titration ","category":"\u003cp style=\"text-align: right;\"\u003eTo determine the percentage of stabilizer added during the construction phase to assess design and proper mixing.\u003c/p\u003e","categoryImage":"[{\"key\":\"551a0b41-3c4d-4fc8-807f-9773f3ede872\",\"mediaKey\":\"36e9d37b-0d8e-4840-ae78-716bcea0b091\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/0b6687537b674d16aa99fff060334f2a","categoryNumber":"10","categoryHeading1":"Particle \u0026 Relative Density","category":"\u003cp style=\"text-align: right;\"\u003eThe ratio of mass to the mass of an equal volume of water, which defines the weight or density of a material.\u003c/p\u003e","categoryImage":"[{\"key\":\"aa2d2cd2-df1e-4d4c-9743-ee44e54eada7\",\"mediaKey\":\"3ea48647-81b2-4dc3-9ede-b9da0b4cb1c4\"}]"},{"contentTypeKey":"a9d646e2-c7a1-43a6-8c80-11197184ab9e","udi":"umb://element/8d2561fdc6b9492e963eea28595379f9","categoryNumber":"11","categoryHeading1":"Methylene Blue","category":"\u003cp style=\"text-align: right;\"\u003eDetermines whether the clay content of the fines of an aggregate contains deleterious swelling clay minerals which could adversely affect the quality of the asphalt mix.\u003c/p\u003e","categoryImage":"[{\"key\":\"f0f6c231-616f-46de-9b8f-1a255999e391\",\"mediaKey\":\"132ac59b-5bd6-4386-bee1-7d6f5bb4f183\"}]"}],"settingsData":[]}
</Value>
