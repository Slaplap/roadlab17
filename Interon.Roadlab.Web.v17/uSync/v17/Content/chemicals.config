    },
    {
      "contentTypeKey": "a9d646e2-c7a1-43a6-8c80-11197184ab9e",
      "key": "83e008ce-a1b8-4923-ae14-583a1bee7f19",
      "values": [
        {
          "alias": "categoryNumber",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "03"
        },
        {
          "alias": "categoryHeading1",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Water Soluble Salt Content "
        },
        {
          "alias": "category",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp style=\u0022text-align: right;\u0022\u003EThis standard specifies a method for determining the total water-soluble salt content of fine aggregates and of fines in aggregates for base courses.\u003C/p\u003E"
          }
        },
        {
          "alias": "categoryImage",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "key": "5c4b0768-aad6-412b-adc7-9890e1fa4671",
