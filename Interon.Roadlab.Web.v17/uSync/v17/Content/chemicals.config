      "values": [
        {
          "alias": "categoryNumber",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "01"
        },
        {
          "alias": "categoryHeading1",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Organic Impurities "
        },
        {
          "alias": "category",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp style=\u0022text-align: right;\u0022\u003EThis test is done to determine the short-term retardation and long-term deleterious effects of organic impurities.\u003C/p\u003E"
          }
        },
        {
          "alias": "categoryImage",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
            {
              "key": "378f9706-d1d1-4b6b-b2b6-a1372b597810",
