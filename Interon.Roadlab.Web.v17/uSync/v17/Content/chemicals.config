              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp style=\u0022text-align: right;\u0022\u003EDetermines the percentage of stabilizer that will first be absorbed by material to neutralize acidity levels before stabilizing takes effect.\u003C/p\u003E"
