      "key": "d7c1104f-f204-4ca9-99b3-0161751f8ac6",
      "values": [
        {
          "alias": "categoryNumber",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "02"
        },
        {
          "alias": "categoryHeading1",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Chloride Content "
        },
        {
          "alias": "category",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp style=\u0022text-align: right;\u0022\u003ESpecifies the determination of the chloride content in aggregates which can have a negative binding effect in some construction applications.\u003C/p\u003E"
          }
        },
        {
          "alias": "categoryImage",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": [
