    },
    {
      "contentTypeKey": "a9d646e2-c7a1-43a6-8c80-11197184ab9e",
      "key": "fe283404-2d83-44c3-b968-eed495dff6d8",
      "values": [
        {
          "alias": "categoryNumber",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "04"
        },
        {
          "alias": "categoryHeading1",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": "Deleterious Clay Content "
        },
        {
          "alias": "category",
          "culture": null,
          "editorAlias": null,
          "segment": null,
          "value": {
            "blocks": {
              "contentData": [],
              "settingsData": [],
              "expose": [],
              "layout": {}
            },
            "markup": "\u003Cp style=\u0022text-align: right;\u0022\u003EThis method determines whether the clay content of the fines of an aggregate contains deleterious swelling or active clay minerals.\u003C/p\u003E"
          }
        },
        {
          "alias": "categoryImage",
          "culture": null,
