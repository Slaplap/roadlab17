@using Interon.Roadlab.Web.Net.Core.Models.ViewModels
@using Umbraco.Cms.Core.Models.Blocks
@inherits UmbracoViewPage
@{
    Layout = "MasterPage.cshtml";
    
    // Access Block List data
    var provincesBlockList = Model.Value<BlockListModel>("provinces");
    var provinces = provincesBlockList?.Select(x => x.Content);
}

@if (provinces != null && provinces.Any())
{
    <h1 class="sr-only">@(string.IsNullOrEmpty(Model.Name) ? "Branches" : Model.Name)</h1>
    foreach (var province in provinces)
    {
        <section class="branch-head__img" style="background-image: url('@(Umbraco.Media(province.Value<IPublishedContent>("provinceBackgroundImage")?.Id)?.Url()??"")')"> 
            <div class="container branch-headings">
                <h2>@province.Value("provinceName")</h2>
            </div>
        </section>

        var branchesBlockList = province.Value<BlockListModel>("branch");
        var branches = branchesBlockList?.Select(x => x.Content);

        if (branches != null && branches.Any())
        {
            foreach (var branch in branches)
            {
                <section class="branch">
                    <div class="container">
                        <div class="row all-branch__space">
                            <div class="col-lg-6 col-md-6 col-sm-12 branch__box">
                                <h4 class="branch__heading">Branch</h4>
                                <h2 class="branch__name">@branch.Value("branchName")</h2>
                                <ul class="fa-ul">
                                    <li><span class="fa-li"><i class="fas fa-user"></i></span> @branch.Value("branchManager")</li>
                                    <li>
                                        <span class="fa-li"><i class="fas fa-map-marker-alt"></i></span> @branch.Value("branchAddress1")<br>
                                        @branch.Value("branchAddress2")<br>
                                        @if (branch.Value("branchAddress3") != null && branch.Value("branchAddress3").ToString().Length > 2)
                                        {
                                            @branch.Value("branchAddress3") <br>
                                        }
                                        @if (branch.Value("branchProvince") != null && branch.Value("branchProvince").ToString().ToLower().Contains("outside"))
                                        {
                                            @branch.Value("branchCountry")<br>
                                        }
                                        else
                                        {
                                            @branch.Value("branchProvince")<br>
                                        }
                                        @if (branch.Value("branchPostalCode") == null || branch.Value("branchPostalCode").ToString().Length < 2)
                                        {
                                            <br />
                                        }
                                        else
                                        {
                                            @branch.Value("branchPostalCode")
                                        }
                                    </li>
                                    <li><span class="fa-li"><i class="fas fa-phone-alt"></i></span>Tel: @branch.Value("branchTelephoneNumber")</li>
                                    <li><span class="fa-li"><i class="fas fa-mobile-alt"></i></span>Cell: @branch.Value("branchCellNumber")</li>
                                    <li><span class="fa-li"><i class="fas fa-envelope"></i></span>E-Mail: @branch.Value("branchEmail")</li>
                                </ul>
                                <div class="row hero__link-space">
                                    <div class="col-md-6 col-12 hero__btn-align mb-2">
                                        @{
                                            var cleanTelNumber = branch.Value("branchTelephoneNumber")?.ToString()
                                                ?.Replace(" ", "")
                                                ?.Replace("(0)", "")
                                                ?.Replace("(", "")
                                                ?.Replace(")", "")
                                                ?.Replace("-", "");
                                        }
                                        <a class="btn btn-blue mobile-full-btn" href="tel:@cleanTelNumber" role="button">CALL</a>
                                    </div>
                                    <div class="col-md-6 col-12 hero__link-space--small mb-2">
                                        @{
                                            var cleanCellNumber = branch.Value("branchCellNumber")?.ToString()
                                                ?.Replace(" ", "")
                                                ?.Replace("(0)", "")
                                                ?.Replace("(", "")
                                                ?.Replace(")", "")
                                                ?.Replace("-", "");
                                        }
                                        <a class="btn btn-blue mobile-full-btn" href="#" onclick="addToPhone('@cleanCellNumber', '@branch.Value("branchName")', '@branch.Value("branchTelephoneNumber")', '@branch.Value("branchEmail")', '@branch.Value("branchAddress1")', '@branch.Value("branchAddress2")')" role="button">ADD TO PHONE</a>
                                    </div>
                                    <!-- Map button for mobile only -->
                                    <div class="col-12 d-block d-md-none mb-2 mt-4">
                                        <a class="btn btn-blue mobile-full-btn" 
                                           href="#" 
                                           onclick="openMapWithCoords('@branch.Value("mapCoordinates")', '@branch.Value("branchName")', '@branch.Value("branchAddress1")', '@branch.Value("branchAddress2")')" 
                                           role="button">
                                            <i class="fas fa-map-marker-alt"></i> VIEW MAP
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="col-lg-6 col-md-12 col-sm-12">
                                <!-- Enhanced map - Hidden on mobile, shown on desktop -->
                                <div class="d-none d-md-block desktop-map-container">
                                    @{
                                        var originalMap = branch.Value("branchMap")?.ToString() ?? "";
                                        var coordinates = branch.Value("mapCoordinates")?.ToString();
                                        
                                        // Try to extract place ID from original embed for business info
                                        var placeId = "";
                                        if (originalMap.Contains("!1s") && originalMap.Contains("google.com/maps"))
                                        {
                                            var placeMatch = System.Text.RegularExpressions.Regex.Match(originalMap, @"!1s([^!]+)");
                                            if (placeMatch.Success)
                                            {
                                                placeId = placeMatch.Groups[1].Value;
                                            }
                                        }
                                        
                                        // Try to extract pb parameter for business data
                                        var pbMatch = System.Text.RegularExpressions.Regex.Match(originalMap, @"pb=([^""&]+)");
                                        var pbParam = pbMatch.Success ? pbMatch.Groups[1].Value : "";
                                        
                                        if (!string.IsNullOrEmpty(pbParam))
                                        {
                                            // Use original embed but make it responsive
                                            var responsiveEmbed = originalMap
                                                .Replace("width=\"100%\"", "width=\"100%\"")
                                                .Replace("height=\"350px\"", "height=\"360px\"")
                                                .Replace("height=\"350\"", "height=\"360\"")
                                                .Replace("style=\"border: 0;\"", "style=\"border: 0; width: 100%; height: 360px;\"");
                                            
                                            @Html.Raw(responsiveEmbed)
                                        }
                                        else if (!string.IsNullOrEmpty(coordinates) && coordinates.Contains(","))
                                        {
                                            // Fallback to coordinates if can't extract business info
                                            var coords = coordinates.Split(',');
                                            if (coords.Length == 2)
                                            {
                                                var lat = coords[0].Trim();
                                                var lng = coords[1].Trim();
                                                var mapSrc = $"https://maps.google.com/maps?q={lat},{lng}&hl=en&z=15&output=embed";
                                                
                                                <iframe src="@mapSrc"
                                                        title="Map of @branch.Value("branchName")"
                                                        class="desktop-map-iframe"
                                                        allowfullscreen=""
                                                        loading="lazy"
                                                        referrerpolicy="no-referrer-when-downgrade">
                                                </iframe>
                                            }
                                        }
                                        else
                                        {
                                            // Final fallback to original map
                                            @Html.Raw(originalMap)
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                        
                        @* Add HR after each branch except the last one *@
                        @if (branch != branches.Last())
                        {
                            <hr class="hr__line">
                        }
                    </div>
                </section>
            }
        }
    }
}
else
{
    <div style="text-align: center; padding: 50px;">
        <h2>No Provinces Available</h2>
        <p>Please add provinces and branches in the Umbraco admin.</p>
    </div>
}

<script>
function addToPhone(cellNumber, branchName, telNumber, email, address1, address2) {
    var cleanCell = cellNumber || '';
    var cleanTel = telNumber ? telNumber.replace(/\s/g, '').replace(/\(0\)/g, '').replace(/[\(\)\-]/g, '') : '';
    
    var vCardData = [
        'BEGIN:VCARD',
        'VERSION:3.0',
        'FN:' + branchName + ' - Roadlab',
        'ORG:Roadlab',
        'TITLE:Branch Office'
    ];
    
    if (cleanCell) {
        vCardData.push('TEL;TYPE=CELL:' + cleanCell);
    }
    if (cleanTel) {
        vCardData.push('TEL;TYPE=WORK:' + cleanTel);
    }
    if (email) {
        vCardData.push('EMAIL:' + email);
    }
    if (address1 || address2) {
        var fullAddress = (address1 || '') + (address2 ? ', ' + address2 : '');
        vCardData.push('ADR;TYPE=WORK:;;' + fullAddress + ';;;');
    }
    
    vCardData.push('URL:https://roadlab.co.za');
    vCardData.push('END:VCARD');
    
    var blob = new Blob([vCardData.join('\n')], { type: 'text/vcard;charset=utf-8' });
    var url = URL.createObjectURL(blob);
    
    var link = document.createElement('a');
    link.href = url;
    link.download = branchName.replace(/\s+/g, '_') + '_Roadlab.vcf';
    
    if (navigator.userAgent.match(/Android|iPhone|iPad|iPod/i)) {
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    } else {
        window.open(url, '_blank');
    }
    
    setTimeout(function() {
        URL.revokeObjectURL(url);
    }, 1000);
}

function openMapWithCoords(coordinates, branchName, address1, address2) {
    var mapsUrl = '';
    
    console.log('Coordinates:', coordinates);
    console.log('Branch name:', branchName);
    
    try {
        if (coordinates && coordinates.includes(',')) {
            // Use exact coordinates
            var coords = coordinates.trim();
            mapsUrl = 'https://www.google.com/maps?q=' + encodeURIComponent(coords);
            console.log('Using coordinates - Maps URL:', mapsUrl);
        } else {
            // Fallback to address search
            var fullAddress = branchName + ', ' + (address1 || '') + (address2 ? ', ' + address2 : '') + ', South Africa';
            mapsUrl = 'https://www.google.com/maps/search/' + encodeURIComponent(fullAddress);
            console.log('Using address fallback - Maps URL:', mapsUrl);
        }
        
    } catch (e) {
        console.error('Error processing coordinates:', e);
        var fullAddress = branchName + ', ' + (address1 || '') + (address2 ? ', ' + address2 : '') + ', South Africa';
        mapsUrl = 'https://www.google.com/maps/search/' + encodeURIComponent(fullAddress);
    }
    
    console.log('Final maps URL:', mapsUrl);
    
    // Try different methods to open map
    try {
        // Method 1: Try window.open
        var newWindow = window.open(mapsUrl, '_blank');
        
        // Method 2: If blocked, try direct navigation
        if (!newWindow || newWindow.closed || typeof newWindow.closed == 'undefined') {
            console.warn('Popup blocked, using direct navigation');
            window.location.href = mapsUrl;
        }
    } catch (e) {
        console.error('Error opening map:', e);
        // Method 3: Fallback direct navigation
        window.location.href = mapsUrl;
    }
}
</script>