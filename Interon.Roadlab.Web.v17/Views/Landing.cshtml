@inherits UmbracoViewPage
@using Interon.Roadlab.Web.Net.Core.Models.ViewModels
@{
	Layout = "MasterPage.cshtml";
}
<section class="hero">
	<div class="hero__shadow hero__pad-2">
		<div class="products__heading">
			<div class="container">
				<div class="row products__heading-container-2">
					<div class="col-md-6 col-sm-12">
                        @Html.Partial("~/views/partials/_RenderContactForm.cshtml", new ContactModel() { BranchName = $"{Model.Name} -  Landing" })
					</div>
					<div class="col-md-6 col-sm-12">
						<div class="col-md-6 col-sm-12"><img class="hero__image" src="@(Model.Value<IPublishedContent>("landingImage") is IPublishedContent lImg ? Umbraco.Media(lImg.Id).Url() : "")" alt="Hero Image" /></div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
<section>
	<div class="row" style="background-image:url(/images/rockface3.jpg);">
		<div class="container">
			<div class="login__head">
				<div class="branch__head--line">
					<h1 class="landing__main-heading">We're ready to advise or quote you today.</h1>
				</div>
			</div>
		</div>
	</div>
</section>
@Html.GetFirstBlockList(Model);
<section>
	<div class="brag paral paralsec">
		<div class="brag__container">
			<img loading="lazy" src="/images/logo2.png" alt="Logo">
			<h3 class="brag__heading">BACKED BY THE ROADLAB GUARANTEE:</h3>
			<h4 class="brag__sub-heading">Fast, Accurate, Reliable.</h4>

		</div>
	</div>
</section>
<!-- Call to action -->
<section class="cta">
	<div class="cta__background cta__container">
		<div class="container">
			<div class="row d-flex justify-content-center">
				<h4 class="cta__text"><span class="u-bold">TEAM UP WITH THE FRIENDLY EXPERTS. </span>REACH OUT TO US TODAY.</h4><a class="btn btn-white-l" href="/head-office/" role="button"><i class="fas fa-angle-right u-btn-fa"></i>GO</a>
			</div>
		</div>
	</div>
</section>