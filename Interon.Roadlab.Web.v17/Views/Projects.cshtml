@inherits UmbracoViewPage<Interon.Roadlab.Web.Net.Core.Models.ContentModels.Projects>
 
@{
    Layout = "MasterPage.cshtml";
}

<section class="hero">
    <div class="hero__shadow hero__pad">
        <div class="container">
            <div class="row">
                <div class="col-md-6 col-sm-12 hero__space">
                    <div class="hero__container">
                        <h4 class="hero__container--sub-heading">@Model.Value("heroSmallHeading")</h4>
                        <h1 class="hero__container--main-heading-2 hero__hr">@Model.Value("heroLargeHeading")</h1>
                        <p>@Model.Value("heroShortDescription")</p>
                        <div class="hero__container--content">
                            <p>@Model.Value("heroContent")</p>
                        </div>

                    </div>
                </div>

                <div class="col-md-6 col-sm-12"><img loading="lazy" class="project__hero-img" src="/images/africaprojects.jpg" alt="Roadlab Projects"></div>
            </div>
        </div>
    </div>
</section>
<!-- Do repeat from here-->
@foreach (var block in Model.ProjectList)
{
    var project = (Project)block.Content;
    <section class="projects">
        <div class="projects__heading paral" style="background-image: url(@project.ProjectHeadingBackgroundImage.Url());">
            <div class="projects__container">
                <div class="row projects__heading--container">
                    <div class="col-lg-1 col-md-2 col-sm-12">
                        <h3 class="projects__item">@project.ProjectNumber</h3>
                    </div>
                    <div class="col-md-11 col-sm-12  projects__heading--space">
                        <h2 class="projects__heading--heading">@project.ProjectHeadingTop <br>@project.ProjectHeadingBottom</h2>
                        <hr class="projects__hr">
                        <h4 class="projects--sub-heading">@project.ProjectLocation </h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="container">
            <div class="row projects__heading--container">
                <div class="col-md-6 col-sm-12">
                    <h4 class="projects--sub-heading-2">KEY INFO:</h4>
                    <hr>
                    <table class="projects__table">
                        <tbody>
                            <tr>
                                <td>YEAR:</td>
                                <td class="u-bold">@project.YearOfProject </td>
                            </tr>
                            <tr>
                                <td>CLIENT:</td>
                                <td class="u-bold">@project.ProjectClient </td>
                            </tr>
                            <tr>
                                <td>BUDGET:</td>
                                <td class="u-bold">@project.ProjectBudget</td>
                            </tr>
                            <tr>
                                <td>SERVICE:</td>
                                <td class="u-bold">@project.ProjectServices</td>
                            </tr>
                            <tr>
                                <td>LINKS:</td>
                                <td class="u-bold">@project.ProjectLinks </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <div class="col-md-6 col-sm-12">
                    <h4 class="projects--sub-heading-2" style="color: white">.&#x20;</h4>
                    <hr>
                    <p>@project.ProjectDescription </p>
                </div>
            </div><hr>
            <div class="row projects__images">
                <div class="col-4">
                    <img loading="lazy" src=@(project.ProjectImage1?.Url() ?? "") alt="@project.ProjectHeadingTop">
                </div>
                <div class="col-4">
                    <img loading="lazy" src=@(project.ProjectImage2?.Url() ?? "") alt="@project.ProjectHeadingTop">
                </div>
                <div class="col-4">
                    <img loading="lazy" src=@(project.ProjectImage3?.Url() ?? "") alt="@project.ProjectHeadingTop">
                </div>
            </div>
        </div>



    </section>
}
<!-- Call to action -->
<section class="cta">
    <div class="cta__background cta__container">
        <div class="container">
            <div class="row d-flex justify-content-center">
                <h4 class="cta__text"><span class="u-bold">TEAM UP WITH THE FRIENDLY EXPERTS. </span>REACH OUT TO US TODAY.</h4><a class="btn btn-white-l" href="/head-office/" role="button"><i class="fas fa-angle-right u-btn-fa"></i>GO</a>
            </div>
        </div>
    </div>
</section>