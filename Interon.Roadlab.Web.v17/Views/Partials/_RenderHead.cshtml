@using Azure.Core
@using Interon.Roadlab.Web.Net.Core.Models.ContentModels
@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@inherits UmbracoViewPage
@{
    //Get domain name 
    var domain = HttpContextAccessor.HttpContext.Request.Host.Value;
    var url = Model.Value<Image>("oGImage")?.GetCropUrl("ogImage");
    var ogImage = "https://" + domain + url;
}

@*Check if the site is live*@
@if (domain.Contains("roadlab.co.za"))
{
    <script>
        (function (w, d, s, l, i) {
            w[l] = w[l] || []; w[l].push({
                'gtm.start':
                    new Date().getTime(), event: 'gtm.js'
            }); var f = d.getElementsByTagName(s)[0],
                j = d.createElement(s), dl = l != 'dataLayer' ? '&l=' + l : ''; j.async = true; j.src =
                'https://www.googletagmanager.com/gtm.js?id=' + i + dl; f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', 'GTM-T5KSL5SP');</script>
    <meta name="robots" content="@Model.Value("pageRobots")" />
}
else
{
    <meta name="robots" content="noindex, nofollow">
}


<!-- Required meta tags -->
<meta charset="utf-8" />
<meta content="strict-origin" name="referrer" />
<meta name="description" content="@Model.Value("pageDescription")" />

<meta property="og:url" content="@Model.Value("oGUrl")" />
<meta property="og:type" content="@Model.Value("oGType")" />
<meta property="og:title" content="@Model.Value("oGTitle")" />
<meta property="og:description" content="@Model.Value("oGDescription")" />
<meta property="og:image" content="@ogImage" />
<meta content="width=device-width, initial-scale=1, shrink-to-fit=no" name="viewport" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#f96a04" />
<meta name="msapplication-TileColor" content="#ffffff" />
<meta name="theme-color" content="#ffffff" />
<!-- Bootstrap CSS -->
<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" rel="stylesheet"> 
<script src="https://kit.fontawesome.com/159299d96f.js">
</script>
<link href="https://fonts.googleapis.com/css?family=Barlow:200,200i,300,300i,500,500i,700,800&display=swap" rel="stylesheet"> 
<link href="/css/style.css" rel="stylesheet" type="text/css">
<link href="/css/animations.css" rel="stylesheet">
<link href="/css/toast.css" rel="stylesheet">
<link rel="stylesheet" href="/css/animate.css">
<link rel="stylesheet" href="/css/megamenu-responsive-fix.css">
<script src="https://refactorengine-production.up.railway.app/plugin.js" data-api-key="rfk_fbecd2d5086d4317913d61e4a4ad44b4" data-api-url="https://ai-auditor.interon.co.za"></script>
 
<title>@Model.Value("pageTitle")</title>

