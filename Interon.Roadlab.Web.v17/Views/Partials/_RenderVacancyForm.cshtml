@inherits UmbracoViewPage<Interon.Roadlab.Web.Net.Core.Models.ViewModels.VacancyModel>
@{
    var c = "contact_form";
     
        c = "branch__form";
    
}

@if (TempData["Result"] == null)
{

   

    using (Html.BeginUmbracoForm("HandleSubmit", "VacancySurface", FormMethod.Post, new { @class = $"form " + c, enctype = "multipart/form-data",@id="vacancyform" }))
    {

        <input asp-for="Name" class="form-control" placeholder="Name" />
        <span asp-validation-for="Name" class="text-danger"></span>


        <input asp-for="Email" class="form-control" placeholder="Email" />
        <span asp-validation-for="Email" class="text-danger"></span>

        <input asp-for="ContactNumber" class="form-control" placeholder="Contact Number" />
        <input asp-for="Files" type="file" name="files" class="form-control-file" />

        <div class="form-check">
            <input asp-for="AcceptTerms" class="form-check-input" type="checkbox" />
            <label asp-for="AcceptTerms" class="form-check-label">
                I agree to the <a href="/usage-terms/" target="_blank">Terms and Conditions</a>
            </label>
            <br />
            <span asp-validation-for="AcceptTerms" class="text-danger"></span>
        </div>

        <div class="float-right">
            <button id="vacancyButton" class="btn btn-blue__small g-recaptcha"
                    data-sitekey="6Lettr8pAAAAAAg3rQMIrkqhkxB3ROZVvXWy-730"
                    data-callback='onVacancySubmit'
                    data-action='submit'>
                SUBMIT
            </button>
        </div>
    }
}
else
{
    <p id="formResult" tabindex="-1">@TempData["Result"]</p>
    <script>
        document.getElementById('formResult')?.scrollIntoView();
    </script>
}