@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<Umbraco.Cms.Core.Models.Blocks.BlockListModel>
@inject Microsoft.AspNetCore.Mvc.ViewEngines.ICompositeViewEngine ViewEngine
@{
    if (!Model.Any()) { return; }
}
@foreach (var block in Model)
{
    if (block?.ContentUdi == null) { continue; }
    var data = block.Content;
    var partialName = "BlockList/Components/" + data.ContentType.Alias;
    var result = ViewEngine.FindView(ViewContext, partialName, isMainPage: false);
    if (result.Success)
    {
        @Html.Partial(partialName, block)
    }
}
