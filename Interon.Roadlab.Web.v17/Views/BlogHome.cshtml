@using Interon.Roadlab.Web.Net.Core.Models.ContentModels
@inherits UmbracoViewPage<Interon.Roadlab.Web.Net.Core.Models.ContentModels.BlogHome>
 
@{
	Layout = "MasterPage.cshtml";
}
<section class="hero">
	<div class=" hero__shadow hero__pad">
		<div class="container">
			<div class="row">
				<div class="col-md-6 col-sm-12 hero__space">
					<div class="hero__container">
						<h4 class="hero__container--sub-heading">@Model.Value("heroSmallHeading")</h4>
						<h1 class="hero__container--main-heading ">@Model.Value("heroLargeHeading")</h1>
						<hr class="hero__hr2">
						<p class="hero__container--content-sub">@Model.Value("heroShortDescription")</p>
						<div class="hero__container--content">
							<p>@Model.Value("heroContent")</p>
						</div>

					</div>

				</div><div class="col-md-5 col-sm-12"><img loading="lazy" class="about-team__img" src="/media/zmffny3g/manb.png" alt="team"></div>
			</div>
		</div>
	</div>
</section>
<section class="about-team">
	<div class="about-team__background">
		<div class="products__heading paral" style="@(Model.Value<IPublishedContent>("backImage") is IPublishedContent bg ? $"background-image:url({Umbraco.Media(bg.Id).Url()});" : "")">
			<div class="blog-head__back blog-head__overlay">

			</div>
			</div>
			<div class="container ">
				<div class="row"></div>
				<div class="row blog-container">
					<div class="col-lg-8 col-md-6 col-sm-12">
						<h5 class="blog__sub-container--name"></h5>
                        <div class="row">
							@Html.Partial("~/Views/Partials/_RenderArticleGrid.cshtml", Model.Descendants().OfType<BlogArticle>().Where(x => x.HomePageToggle == true).ToList())
                           


                        </div>
					</div>
					<!-- Side Bar Right-->
					<div class="col blog-sidebar">
					@Html.Partial("~/Views/Partials/_RenderSearch.cshtml")
						<div>

						@Html.Partial("~/Views/Partials/_RenderCategoryList.cshtml")

						<!-- @Html.Partial("~/Views/Partials/_RenderRecentArticleList.cshtml") -->
							</div>
						</div>
					</div>
				</div>
			</div>
	</section>
