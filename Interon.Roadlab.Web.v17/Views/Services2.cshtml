@inherits UmbracoViewPage
@using Interon.Roadlab.Web.Net.Core.Models.ViewModels
@using Interon.Roadlab.Web.v17.Extensions
@{
	Layout = "MasterPage.cshtml";
}


	<section class="hero">
		<div class="hero__shadow hero__pad-2">
			<div class="container">
				<div class="row">
					<div class="col-md-6 col-sm-12 hero__space">
                        <div class="hero__container">
                            <h4 class="hero__container--sub-heading">@Model.Value("heroSmallHeading")</h4>
                            <h1 class="hero__container--main-heading ">@Model.Value("heroLargeHeading")</h1>
                            <hr class="hero__hr2">
                            <p class="hero__container--content-sub">@Model.Value("heroShortDescription")</p>
                            <div class="hero__container--content">
                                <p>@Model.Value("heroContent")</p>
                            </div>

                        </div>
					</div>
					<div class="col-md-6 col-sm-12">
                        @if (Model.Value<IPublishedContent>("heroRightImage") is IPublishedContent hImg)
                        {
                            <img class="hero__image" src="@Umbraco.Media(hImg.Id).Url()" alt="Header Image" />
                        }
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="products">
		<div class="products__heading paral paralsec-aggregate"> 
			<div class="container">
				<div class="row products__heading-container">
					<div class="col-md-6 col-sm-12">
						<h4 class="reach__heading">REACH OUT</h4>
                        @Html.Partial("~/views/partials/_RenderContactForm.cshtml", new ContactModel() { BranchName = $"{Model.Name} - Service" })
					</div>
				</div>
			</div>
		</div>
		</section>
		@Html.GetFirstBlockList(Model)
	
		<section>
			<div class="brag paral paralsec">
				<div class="brag__container">
					<img loading="lazy" src="/images/logo2.png" alt="logo">
					<h3 class="brag__heading">BACKED BY THE ROADLAB GUARANTEE:</h3>
					<h4 class="brag__sub-heading">Fast, Accurate, Reliable.</h4>

				</div>
			</div>
		</section>
		<!-- Call to action -->
		<section class="cta">
			<div class="cta__background cta__container">
				<div class="container">
					<div class="row d-flex justify-content-center">
						<h4 class="cta__text"><span class="u-bold">TEAM UP WITH THE FRIENDLY EXPERTS. </span>REACH OUT TO US TODAY.</h4><a class="btn btn-white-l" href="/head-office/" role="button"><i class="fas fa-angle-right u-btn-fa"></i>GO</a>
					</div>
				</div>
			</div>
		</section>
