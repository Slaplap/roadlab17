@inherits UmbracoViewPage<Interon.Roadlab.Web.Net.Core.Models.ViewModels.ContactModalModel>
@{
    var c = "contact_form";
    if (!string.IsNullOrEmpty(Model.BranchEmail))
    {
        c = "branch__form";
    }
}

@if (TempData["Result"] == null)
{

    //using (Ajax.BeginForm("HandleSubmit", "ContactSurface", null, new AjaxOptions
    //{
    //    HttpMethod = "POST",
    //    InsertionMode = InsertionMode.Replace,
    //    UpdateTargetId = "ContactFormPlaceHolder",form branch__form

    //}, new {@class = "form contact_form"}
    //    ))
    <style>
        .field-validation-error {
            color: white !important;
        }
    </style>
    using (Html.BeginUmbracoForm("HandleSubmit", "ModalContactSurface", FormMethod.Post, new { @class = $"form " + c, @id = "contactform" }))
    {
        @Html.HiddenFor(x => x.BranchName)
        @Html.HiddenFor(x => x.BranchNumber)
        @Html.HiddenFor(x => x.BranchEmail)
        @Html.TextBoxFor(x => x.Name, new { @placeholder = "Name" })
        @Html.ValidationMessageFor(x => x.Name)
        <div class="h-p">

            @Html.TextBoxFor(x => x.Surname, new { @placeholder = "Surname" })
            @Html.ValidationMessageFor(x => x.Surname)
        </div>
        @Html.TextBoxFor(x => x.Email, new { @placeholder = "Email" })
        @Html.ValidationMessageFor(x => x.Email)
        @Html.TextBoxFor(x => x.ConactNumber, new { @placeholder = "Contact Number" })
        @Html.ValidationMessageFor(x => x.ConactNumber)
        @Html.TextBoxFor(x => x.Subject, new { @placeholder = "Subject" })
        @Html.ValidationMessageFor(x => x.Subject)
        @Html.TextAreaFor(x => x.Query, new { @placeholder = "Query", @style = "color:grey" })
        @Html.ValidationMessageFor(x => x.Query)
        <div class="float-right">
            <input id="contactButton" class="btn btn-blue__small" type="submit" value="SUBMIT">
        </div>
        <script>



        </script>
    }
}
else
{
    <p>@TempData["Result"]</p>
    <script>
        setTimeout(function() {
            $(document).ready(function() {
                @Html.Raw(TempData["script"])
            });
        }, 500);


    </script>
}