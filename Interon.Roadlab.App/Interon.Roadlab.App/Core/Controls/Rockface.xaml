<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="Interon.Roadlab.App.Controls.Rockface"
    xmlns="http://xamarin.com/schemas/2014/forms"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:Flex.Controls;assembly=Flex"
    xmlns:core="clr-namespace:Interon.Roadlab.App.Core;assembly=Interon.Roadlab.App"
    xmlns:d="http://xamarin.com/schemas/2014/forms/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="RockfaceController"
    mc:Ignorable="d">
    <ContentView.Content>
        <AbsoluteLayout
            BindingContext="{x:Reference Name=RockfaceController}"
            HeightRequest="200"
            IsVisible="{Binding Show}"
            WidthRequest="160">
            <Image Rotation="180" Source="rockface.png" />
            <controls:FlexButton
                x:Name="MenuButton"
                AbsoluteLayout.LayoutBounds=".75,.25"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Clicked="OpenFlyout"
                CornerRadius="38"
                FontFamily="{StaticResource MaterialFontFamily}"
                FontSize="Large"
                ForegroundColor="white"
                HighlightBackgroundColor="#074F71"
                HighlightForegroundColor="#FFC107"
                HorizontalOptions="Center"
                IsEnabled="True"
                Text="{Binding Source={x:Static core:IconFont.Menu}}" />
            <controls:FlexButton
                x:Name="BackButton"
                AbsoluteLayout.LayoutBounds=".75,.25"
                AbsoluteLayout.LayoutFlags="PositionProportional"
                Clicked="OpenFlyout"
                CornerRadius="38"
                FontFamily="{StaticResource MaterialFontFamily}"
                FontSize="50"
                ForegroundColor="white"
                HighlightBackgroundColor="#074F71"
                HighlightForegroundColor="#FFC107"
                HorizontalOptions="Center"
                IsEnabled="True"
                IsVisible="{Binding Path=ShowIcon}"
                Text="{Binding Source={x:Static core:IconFont.ArrowBack}}" />
        </AbsoluteLayout>
    </ContentView.Content>
</ContentView>