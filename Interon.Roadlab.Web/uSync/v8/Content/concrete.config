    <serviceCategories>
      <Value><![CDATA[[
  {
    "key": "1c3fbde7-943b-406d-a24a-410bc370febe",
    "name": "Item 1",
    "ncContentTypeAlias": "products",
    "categoryNumber": "01",
    "categoryHeading1": "Laboratory Mixing of Concrete ",
    "category": "<p>Design, batch and prepare freshly mixed concrete in the laboratory where accurate control of the materials and test conditions is possible.</p>",
    "categoryImage": "umb://media/3758f1f0813a4f30836cbcc872474781"
  },
  {
    "key": "5250991c-8ed3-4c14-9d5c-a6c19199e2ca",
    "name": "Item 2",
    "ncContentTypeAlias": "products",
    "categoryNumber": "02",
    "categoryHeading1": "Making & Curing of Test Specimens",
    "category": "<p>Preparing concrete specimens from freshly mixed concrete for future testing to determine compressive strength.</p>",
    "categoryImage": "umb://media/0f261ca753614aaa8e85058fc5f6193b"
  },
  {
    "key": "a17f3848-0fe6-45eb-9dda-baac54b2ed92",
    "name": "Item 3",
    "ncContentTypeAlias": "products",
    "categoryNumber": "03",
    "categoryHeading1": "Slump Test",
    "category": "<p>A method for determining the uniformity and consistency of freshly mixed concrete from a supplier.</p>",
    "categoryImage": "umb://media/7f2d167fd5984e7aab6e75ff876e584b"
  },
  {
    "key": "c59e0f65-5ca5-477f-a218-60159d37d4ba",
    "name": "Item 4",
    "ncContentTypeAlias": "products",
    "categoryNumber": "04",
    "categoryHeading1": "Compressive Strength of  Hardened Concrete",
    "category": "<p>The use of a concrete cube press is to determine compressive strength of a sample taken from the freshly mixed concrete used in a structure.</p>",
    "categoryImage": "umb://media/9c267a3b474b45b7ba3e715045699870"
  },
  {
    "key": "790e5029-d35e-4348-a8e7-3e09ff3ee341",
    "name": "Item 5",
    "ncContentTypeAlias": "products",
    "categoryNumber": "05",
    "categoryHeading1": "Flexural Strength of Hardened Concrete ",
    "category": "<p>The use of a concrete beam press to determine the flexural strength of concrete.</p>",
    "categoryImage": "umb://media/a57fc40ab0c9496c93d11d861d95eb7e"
  },
  {
    "key": "9ca4bad0-4ed1-4483-9622-17d83bf4e28d",
    "name": "Item 6",
    "ncContentTypeAlias": "products",
    "categoryNumber": "06",
    "categoryHeading1": "Compressive Strength of Cores ",
    "category": "<p>A method of drilling cores from hardened concrete and preparing them for testing to determine their compressive strengths.</p>",
    "categoryImage": "umb://media/61910a8bcf2d48349e314e86684cbedc"
  },
  {
    "key": "13d4b6f0-68db-4477-b22f-9d7970e8d5d3",
    "name": "Item 7",
    "ncContentTypeAlias": "products",
    "categoryNumber": "07",
    "categoryHeading1": "Tensile Splitting of Paving Units ",
    "category": "<p>A series of tests for product acceptance: shape, appearance, texture and color, dimensions, tensile splitting, abrasion resistance and water absorption.</p>",
    "categoryImage": "umb://media/c1cbc13135ee4dd1b0aeb3027eaad869"
  },
  {
    "key": "b9b1adc4-ce38-480f-940a-6c587b520c73",
    "name": "Item 8",
    "ncContentTypeAlias": "products",
    "categoryNumber": "08",
    "categoryHeading1": "Burt Clay Masonry Units ",
    "category": "<p>A series of tests for product acceptance: shape, appearance, texture and color, dimensions, warpage, compressive strength, efflorescence, soundness, water absorptions, water soluble salts and moisture expansion.</p>",
    "categoryImage": "umb://media/adcd4551647746c68bd4fa19131c3dc4"
  },
  {
    "key": "a25aa5d9-fb86-4436-b060-d31385793102",
    "name": "Item 9",
    "ncContentTypeAlias": "products",
    "categoryNumber": "09",
    "categoryHeading1": "Durability Testing ",
    "category": "<p>A test to determine oxygen permeability, water absorptivity and chloride conductivity.</p>",
    "categoryImage": "umb://media/dda0e9986fde4ef19cbdb965a3299628"
  },
  {
    "key": "28217373-931f-4dcf-a5f8-25f746be62b9",
    "name": "Item 10",
    "ncContentTypeAlias": "products",
    "categoryNumber": "10",
    "categoryHeading1": "Cover Meter Testing ",
    "category": "<p>Determining the reinforcing depth in an existing concrete structure with the use of a rebar detector.</p>",
    "categoryImage": "umb://media/913049325f9c4b1488a8e5e91467769e"
  },
  {
    "key": "d5d4a4b7-275b-44a9-863e-392a223ce743",
    "name": "Item 11",
    "ncContentTypeAlias": "products",
    "categoryNumber": "11",
    "categoryHeading1": "Rebound Hammer ",
    "category": "<p>A Schmidt hammer, also known as a Swiss hammer or a Rebound hammer or Concrete hammer test, is a device to measure the elastic properties or strength of concrete or rock, mainly surface hardness and penetration resistance.</p>",
    "categoryImage": "umb://media/0a4fc09776954b29854528fc4b8770ea"
  },
  {
    "key": "642007fa-56ac-47ba-b908-bca8ef2240cb",
    "name": "Item 12",
    "ncContentTypeAlias": "products",
    "categoryNumber": "12",
    "categoryHeading1": "Carbonation Testing ",
    "category": "<p>By extracting a core sample and treating it with a phenolphthalein solution we can determine the actual carbonation depth on a structure.</p>",
    "categoryImage": "umb://media/b840661373904ec490e36a1d2fab5517"
  },
  {
    "key": "bea2ad82-a4e2-4bb5-b9e8-f80ab040dbed",
    "name": "Item 13",
    "ncContentTypeAlias": "products",
    "categoryNumber": "13",
    "categoryHeading1": "Proceq Concrete scanning",
    "category": "<p>Non-destructive testing of concrete structures using stepped frequency continuous-wave ground penetrating radar to an effective depth exceeding 700mm.</p>",
    "categoryImage": "umb://media/00c29912e41244e897dabe9d91c0aceb"
  },
  {
    "key": "0a7b24fe-0b27-4ffa-8a82-8c8b51791992",
    "name": "Item 14",
    "ncContentTypeAlias": "products",
    "categoryNumber": "14",
    "categoryHeading1": "Concrete crack width meter/camera",
    "category": "<p>A test to investigate crack width on concrete structures such as walls, tunnels and bridges with photographic recording.</p>",
    "categoryImage": "umb://media/196c28c6cae94e24aef0f6f92eaa6379"
  },
  {
    "key": "8ae1bcd0-7ccd-4abd-adde-a1730afedaba",
    "name": "Item 15",
    "ncContentTypeAlias": "products",
    "categoryNumber": "15",
    "categoryHeading1": "Ultrasonic pulse velocity meter (UPV)",
    "category": "<p>Pulses of ultrasonic waves are transmitted into concrete structures to determine the uniformity of concrete, estimate the depth of surface voids and check on the effectiveness of crack repairs, the severity of damage and deterioration of concrete.</p>",
    "categoryImage": "umb://media/59fb45b4f05d4c40a6d81d16f6dc9ce6"
  }
]]]></Value>
