<?xml version="1.0" encoding="utf-8"?>
<DataType Key="ef452c83-6e66-401f-b076-86a812eaa422" Alias="Project-Rich Text Editor" Level="1">
  <Info>
    <Name>Project-Rich Text Editor</Name>
    <EditorAlias>Umbraco.TinyMCE</EditorAlias>
    <DatabaseType>Ntext</DatabaseType>
  </Info>
  <Config><![CDATA[{
  "Editor": {
    "toolbar": [
      "ace",
      "undo",
      "redo",
      "paste",
      "bold",
      "italic",
      "alignleft",
      "bullist",
      "link",
      "unlink"
    ],
    "stylesheets": [
      "/css/style.css"
    ],
    "maxImageSize": 500,
    "mode": "classic"
  },
  "OverlaySize": null,
  "HideLabel": false,
  "IgnoreUserStartNodes": false,
  "MediaParentId": null
}]]></Config>
</DataType>