	<hr />
	<!-- BENEFITS BLOCKS -->
	<section class="benefits-blocks container">

		<!-- Start Feature 1 -->
		<div class="container">
			<div class="row benefits-blocks__container">
				<div class="col-md-6 col-sm-12 benefits-blocks__divider"><img class="benefits-blocks__img" src="./images/soil-1.jpg" alt="At your Site"></div>
