@using Interon.Roadlab.Web.Core.ViewModels
@inherits Umbraco.Web.Mvc.UmbracoViewPage<Interon.Roadlab.Web.Core.ContentModels.AccountPasswordChange>

@{
    Layout = "MasterPage.cshtml";
}
<section>
    <div class="row" style="background-image:url(/images/rockface3.jpg);margin-top:3rem;">
        <div class="container">
            <div class="login__head">
                <div class="branch__head--line">

                    <h4 class="branch__sub-heading">Change</h4>
                    <h2 class="branch__main-heading">password</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="container branch__container login__container ">
        <div class="row">
            <div class="col">
                    @Html.Partial("_RenderPasswordChangeForm", new PasswordChangeViewModel())
            </div>

        </div>
    </div>
    @Html.Partial("_RenderBrag")
</section>
@Html.Partial("_RenderCTA")