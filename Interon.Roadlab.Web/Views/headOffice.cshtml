					</ul>
				</div>
				<div class="col-md-8 col-sm-12 headoffice__img">	
					<img class="branch__map" src="/images/sa.jpg" alt="map South Africa">
				</div>
			</div>
			<div class="row">
				<div class="col-md-4 col-sm-12">
					<h5 class="branch__headoffice-text-title">Africa Offices</h5>
					<hr class="branch__hr">
				</div>
			</div>
			<div class="row headoffice__space">
				<div class="col-md-4 col-sm-12">
					<ul class=" headoffice__list headoffice__link headoffice__li-icon headoffice__text">
						<!--<li><a href="Botswana"><i class="fas fa-angle-right"></i>Botswana</a></li>-->
