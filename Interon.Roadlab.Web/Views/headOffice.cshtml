@using Interon.Roadlab.Web.Core.ViewModels
@inherits Umbraco.Web.Mvc.UmbracoViewPage<Interon.Roadlab.Web.Core.ContentModels.Branch>

@{
	Layout = "MasterPage.cshtml";
}


<section class="branch">
		<div class="container">
			<div class="row branch__space">
				<div class="col-lg-4 col-md-6 col-sm-12"><img class="branch__img" src="@Umbraco.Media(Model.Value<IPublishedContent>("branchImage").Id).Url"></div>
				<div class="col-lg-4 col-md-6 col-sm-12 branch__box">
					<h4 class="branch__heading" >contact</h4>
					<h2 class="branch__name">@Model.Value("branchName")</h2>
					<ul class="fa-ul">
						
						<li><span class="fa-li"><i class="fas fa-map-marker-alt"></i></span> @Model.Value("branchAddress1")<br>
						@Model.Value("branchAddress2")<br>
						@Model.Value("branchAddress3")<br>
						@Model.Value("branchProvince")<br>
						@Model.Value("branchPostalCode")
						</li>
						<li><span class="fa-li"><i class="fas fa-phone-alt"></i></span>Tel: @Model.Value("branchTelephoneNumber")</li>
						<li><span class="fa-li"><i class="fas fa-mobile-alt"></i></span>Cell: @Model.Value("branchCellNumber")</li>
						<li><span class="fa-li"><i class="fas fa-print"></i></span>Fax: +27 (0)11 828 0273</li>
						<li><span class="fa-li"><i class="fas fa-envelope"></i></span>E-Mail: @Model.Value("branchEmail")</li>
					</ul>
				</div>
				<div class="col-lg-4 col-md-12 col-sm-12 branch__map-margin">
					<div>@Model.Value("branchMap")</div>
				</div>
			</div>
		</div>
	</section>
	<section>
			<div class="row branch__back-image" style="background-image:url(@Umbraco.Media(Model.Value<IPublishedContent>("branchBackgroundImage").Id).Url);">
				<div class="container">
					<div class="branch__head">
						<div class="branch__head--line">
							<h4 class="branch__sub-heading">@Model.Value("pageHeadingTop")</h4>
							<h2 class="branch__main-heading">enquiries</h2>
						</div>
					</div>
				</div>
			</div>

			<div class="container branch__container">
				<div class="row">
					<div class="col-md-8 col-sm-12">
                        <div id="ContactFormPlaceHolder">
                            @Html.Partial("_RenderContactForm",new ContactModel(){BranchEmail = Model.BranchEmail,BranchName = "Head Office"})
                        </div>
					</div>
						<div class="col-md-4 col-sm-12">
						<h5 class="branch__text-title">Accreditation<br>
						Info</h5>
						<hr class="branch__hr">
						<div class="branch__small-container">
							<p>Please refer to our downloadable documents for further information.</p><a class="u-pdf-link" href="/media/xxknxdsm/accreditation.pdf"><i class="fas fa-external-link-alt btn-fa fa-link-space"></i>Download @Model.Value("branchName") Accreditation Pdf</a>
						</div>
					</div>
				</div>
				</div>
				</section>
				
