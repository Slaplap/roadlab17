					</ul>
				</div>
				<div class="col-md-8 col-sm-12 headoffice__img">	
					<img class="branch__map" src="/images/africa.jpg" alt="map South Africa">
				</div>
			</div>

	</section>
	<section>
	    <div class="brag paral paralsec">
			<div class="container about-brag__container">
				<div class="row">
						<div class="col-md-2 col-sm-12">
						<img src="/images/logo2.png" alt="">
						</div>
						<div class="col">
						<h3 class="about-brag__heading">WANT TO HEAR MORE?</h3>
