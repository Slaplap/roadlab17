@inherits Umbraco.Web.Mvc.UmbracoViewPage<Umbraco.Core.Models.Blocks.BlockListItem>


<div class="col-md-4 sub-products__row">
    <div class="col-md-6 sub-products__pad">
      
        <div class="col">
            <h5 class="sub-products__test-title">@Model.Content.Value("title")</h5>
            <hr class="services_hr">
            @Model.Content.Value("description")
        </div>

    </div>
    <div class="col-md-6 sub-products__pad"><img alt="@(Model.Content.Value<IPublishedContent>("image").Name)" class="w-100" src="@(Model.Content.Value<IPublishedContent>("image")?.Url()??"")"></div>
</div>
