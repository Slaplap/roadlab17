@using Interon.Roadlab.Web.Core.ContentModels
@inherits UmbracoViewPage
@{
    BlogSelector blogSelector = new BlogSelector(Model);
    var homepage = Model.Root<HomePage>();
    
}
@if (blogSelector.BlockContentPicker != null)
{
    if (blogSelector.BlockContentPicker.Any())
    {


        <section>
            <div class="container footer-blog">
                <div class="row blog-container">
                    @foreach (var item in blogSelector.BlockContentPicker.OfType<BlogArticle>())
                    {
                        <div class="col-md-4 col-sm-12">
                            <img class="about-team__sub-container--img mb-3" src="@item.ArticleIntersectImage.Url()" alt="">
                            <h6 class="about-team__sub-container--title">@item.Parent.Name</h6>
                            <h5 class="blog__sub-container--name">@item.BlogHeading</h5>
                            <div class="blog__sub-container--content ft-cont">
                                <p>
                                    @item.ArticleIntersectDescription
                                    <a href="@item.Url()"> Read more</a>
                                </p>
                            </div>

                        </div>
                    }


                </div>
            </div>
        </section>
    }
}
