@inherits UmbracoViewPage<Interon.Roadlab.Web.Core.ViewModels.VacancyModel>
@{
    var c = "contact_form";
     
        c = "branch__form";
    
}

@if (TempData["Result"] == null)
{

    //using (Ajax.BeginForm("HandleSubmit", "ContactSurface", null, new AjaxOptions
    //{
    //    HttpMethod = "POST",
    //    InsertionMode = InsertionMode.Replace,
    //    UpdateTargetId = "ContactFormPlaceHolder",form branch__form

    //}, new {@class = "form contact_form"}
    //    ))

    using (Html.BeginUmbracoForm("HandleSubmit", "VacancySurface", FormMethod.Post, new { @class = $"form " + c, enctype = "multipart/form-data",@id="vacancyform" }))
    {


        @Html.TextBoxFor(x => x.Name, new { @placeholder = "Name" })
        @Html.ValidationMessageFor(x => x.Name)
        <div class="h-p">
        @Html.TextBoxFor(x => x.Surname, new { @placeholder = "Surname" })
        @Html.ValidationMessageFor(x => x.Surname)
        </div>
        @Html.TextBoxFor(x => x.Email, new { @placeholder = "Email" })
        @Html.ValidationMessageFor(x => x.Email)
        @Html.TextBoxFor(x => x.ContactNumber, new { @placeholder = "Contact Number" })
        @Html.TextBoxFor(x=>x.Files,new{type="file",@name ="files"})
        <div class="float-right">
            <input class="btn btn-blue__small" type="submit" value="SUBMIT">
        </div>
    }
}
else
{
    <p>@TempData["Result"]</p>
    <script>

        $(document).ready(function() {
            @Html.Raw(TempData["script"])
        });
  
    </script>
}