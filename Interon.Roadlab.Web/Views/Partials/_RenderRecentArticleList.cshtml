@using Interon.Roadlab.Web.Core.ContentModels
@inherits UmbracoViewPage
@{
    var home = Model.AncestorsOrSelf().OfType<BlogHome>().FirstOrDefault();
}


<div class="footer__list-box">

    <h5 class="blog__sub-container--name my-3 mt-3">RECENT</h5>
    <hr>
    @foreach (var article in home.Descendants<BlogArticle>().OfType<BlogArticle>().OrderByDescending(x => x.ArticleDate).Take(4))
    {
        <a href="@article.Url()">
            <img class="about-team__sub-container--img mt-3" src="@article.ArticleIntersectImage.Url()" alt="">
            <p class="blog-caption">@article.BlogHeading</p>
        </a>
    }


</div>