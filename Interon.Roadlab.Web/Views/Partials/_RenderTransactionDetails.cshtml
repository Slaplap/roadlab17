@using Interon.Roadlab.Web.App.ViewModels
@inherits UmbracoViewPage<Interon.Roadlab.Web.App.ViewModels.TransactionContentModel>
@{
    Layout = null;
}
<h1>@Model.Transaction.Project</h1>
<p>Company : @Model.Transaction.BranchName</p>
<p>Contact Person : @Model.Transaction.ContactPerson</p>
<p>Contact Person Details : @Model.Transaction.ContactPersonEmail</p>
<p>Contact Person Number : @Model.Transaction.ContactPersonNumber</p>
<p>Requested By : @Model.Transaction.RequestedByName</p>
<p>Address : @Model.Transaction.SiteLocationAddress</p>
<p>Status : @Model.Transaction.Status</p>
<p>Special Instructions : @Model.Transaction.SpecialInstructions</p>
<div>
	<p> Comments :</p>
    <ul>
        @foreach (var item in Model.Comments)
        {
            <li>@item.Name - @item.Message - @item.DateTime </li>
        }
    </ul>
</div>

<h4>Line</h4>
<ul>
    @foreach (var item in Model.Transaction.TransactionLine)
    {
        <li>@item.Category @item.Value X @item.Qty</li>

    }
</ul>
<h4>Files</h4>
<ul>
    @foreach (var item in Model.Transaction.TransactionFile)
    {
        <li>@item.Name @item.Path @item.Url</li>

    }
</ul>
@if (Model.Transaction.Status.Contains("Ready"))
{


    <div>
        @Html.Partial("_RenderConfirmationForm",new ConfirmationViewModel())
       

    </div>
}