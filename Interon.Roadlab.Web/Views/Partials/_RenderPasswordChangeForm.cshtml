@inherits UmbracoViewPage<Interon.Roadlab.Web.Core.ViewModels.PasswordChangeViewModel>
    

<div class="container branch__container login__container">
    <div class="row">
        <div class="col">
            
                @using (Html.BeginUmbracoForm("ChangePassword", "Membership", FormMethod.Post, new {@class = "form branch__form" }))
                {
                    @Html.AntiForgeryToken()
                   
                    @Html.TextBoxFor(x=>x.Password,new{@class="",placeholder="Enter New Password",type="password"})
                   
                    <div class="float-right">
                        <span><i class="fas fa-angle-right btn-fa branch__glyph"></i></span> <input class="input btn btn-blue" type="submit" value="SUBMIT">
                    </div>
                }

               
            
        </div>

    </div>
</div>