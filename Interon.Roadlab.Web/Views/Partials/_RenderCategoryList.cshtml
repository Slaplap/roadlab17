@using Interon.Roadlab.Web.Core.ContentModels
@inherits UmbracoViewPage
@{
    var home = Model.AncestorsOrSelf().OfType<BlogHome>().FirstOrDefault();
}
<div class="footer__list-box">

	<h5 class="blog__sub-container--name my-3 mt-3">CHOOSE YOUR INDUSTRY</h5>
    <hr>
    <ul class="fa-ul blog__links">
        @foreach (var item in home.Descendants<BlogCategories>())
        {
            <li>
                <a href="@item.Url()" ><span class="fa-li ft-icon"><i class="fas fa-angle-right"></i></span>@item.Name</a>
            </li>
        }
       

    </ul>
</div>