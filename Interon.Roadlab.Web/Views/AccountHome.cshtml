@inherits Umbraco.Web.Mvc.UmbracoViewPage<Interon.Roadlab.Web.Core.ContentModels.AccountHomeContentModel>
@using Syncfusion.EJ2
@using Syncfusion.EJ2.Grids
 
@{
    Layout = "MasterPage.cshtml";
}
<section>
    <div class="row" style="background-image:url(/images/rockface3.jpg);margin-top:3rem;">
        <div class="container">
            <div class="login__head">
                <div class="branch__head--line">

                    <h4 class="branch__sub-heading">Accounts</h4>
                    <h2 class="branch__main-heading">Home</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="container branch__container">
        <div class="row">
            <div class="col-md-12 col-sm-12">
                @Html.Partial("_RenderAdminMenu", "#home")

            </div>
            <div class="col-md-12 col-sm-12">

                <h4>Notifications</h4>
                @Html.EJS().Grid("LocalData").DataSource(Model.Notifications).AllowTextWrap().AllowFiltering(true).AllowSorting(true).EditSettings(edit => { edit.AllowDeleting(true); }).AllowSelection(true).Columns(col =>
                {

                col.Field("Title").HeaderText("Title").Width("70").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Add();
                col.Field("Message").HeaderText("Message").Width("175").Add();
                col.Template("<button onclick='onNotificationsViewClick(this)' class='e-control e-btn e-lib openDetails' id='${Key}' data-foreignkey='${ForeignKey}' type='button'>View</button>").AllowEditing(false).Width(70).Add();
                col.Field("CreateDate").HeaderText("Create Date").Width("65").Format("yMd").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Add();
                col.Field("ReadDate").HeaderText("Read Date").Width("65").Format("yMd").TextAlign(Syncfusion.EJ2.Grids.TextAlign.Right).Add();
                col.Template("<button onclick='onReadClick(this)' class='e-control e-btn e-lib' data-key='${Key}' type='button'>Mark As Read</button>").AllowEditing(false).Width(70).Add();


                }).AllowPaging().PageSettings(page => page.PageCount(5)).Render()
            </div>


        </div>
    </div>

    @Html.Partial("_RenderBrag")
</section>
<div class="modal fade" id="detailsModal" role="dialog">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Transaction Information</h4>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-orange" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_RenderCTA")

<style>
    .e-rowcell {
        font-size: 9px !important;
    }

    th {
        background-color: #FF8116
    }

    .e-grid .e-headercell,
    .e-grid .e-detailheadercell {
        background-color: #FF8116;
        border-color: #e0e0e0;
    }

    e-headertext {
        font-size: 9px !important;
    }

    .e-grid .e-headercelldiv {
        font-size: 9px !important;
    }
</style>
