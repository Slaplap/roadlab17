@inherits Umbraco.Web.Mvc.UmbracoViewPage<Interon.Roadlab.Web.Core.ContentModels.AccountPasswordRequest>
 
@{
    Layout = "MasterPage.cshtml";
}
<section>
    <div class="row" style="background-image:url(/images/rockface3.jpg);margin-top:3rem;">
        <div class="container">
            <div class="login__head">
                <div class="branch__head--line">

                    <h4 class="branch__sub-heading">forgot</h4>
                    <h2 class="branch__main-heading">password</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="container branch__container login__container ">
        <div class="row">
            <div class="col">
                <form class="form branch__form ">

                    <input name="Email" placeholder="Email" type="text">

                    <div class="float-right">
                        <span><i class="fas fa-angle-right btn-fa branch__glyph"></i></span> <input class="input btn btn-blue" type="submit" value="SUBMIT">
                    </div>
                </form>
            </div>

        </div>
    </div>
    @Html.Partial("_RenderBrag")
</section>
@Html.Partial("_RenderCTA")